index 0000000..c1a8feb
--- /dev/null
+++ b/tests/test_discovery_quality.py
@@ -0,0 +1,218 @@
+"""Discovery and page-structure quality fixtures (PCH-150 queue items 5–8).
+
+Markup checks only — not a keyboard/browser usability pass. Broken local
+references are delegated to scripts/check_local_links.py (PCH-147).
+"""
+
+from __future__ import annotations
+
+import importlib.util
+import shutil
+import subprocess
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+
+
+ROOT = Path(__file__).resolve().parents[1]
+SPEC = importlib.util.spec_from_file_location("check_site", ROOT / "scripts" / "check_site.py")
+assert SPEC and SPEC.loader
+CHECK = importlib.util.module_from_spec(SPEC)
+SPEC.loader.exec_module(CHECK)
+
+
+MINIMAL_HEAD = """<!DOCTYPE html>
+<html lang="en"><head><meta charset="utf-8">
+<meta name="viewport" content="width=device-width,initial-scale=1">
+<meta name="description" content="Fixture page">
+<meta name="robots" content="index,follow">
+<meta name="twitter:card" content="summary">
+<meta name="twitter:image" content="https://priyanshchordia.com/og.png">
+<meta name="twitter:image:alt" content="alt">
+<meta property="og:type" content="website">
+<meta property="og:title" content="Fixture">
+<meta property="og:description" content="Fixture page">
+<meta property="og:url" content="CANONICAL">
+<meta property="og:image" content="https://priyanshchordia.com/og.png">
+<meta property="og:image:width" content="1200">
+<meta property="og:image:height" content="630">
+<meta property="og:image:alt" content="alt">
+<link rel="canonical" href="CANONICAL">
+<title>TITLE</title></head>"""
+
+
+def _page(canonical: str, title: str, body: str, *, lang: str = "en",
+          description: str = "Fixture page", nav_label: str = "Primary",
+          extra_ids: str = "") -> str:
+    head = (
+        MINIMAL_HEAD
+        .replace("CANONICAL", canonical)
+        .replace("TITLE", title)
+        .replace('lang="en"', f'lang="{lang}"')
+        .replace('content="Fixture page"', f'content="{description}"', 1)
+    )
+    return (
+        f"{head}<body>"
+        f'<header><nav aria-label="{nav_label}"><a href="/index.html">Home</a></nav></header>'
+        f'<main id="main"><h1>{title}</h1>{body}{extra_ids}</main>'
+        f"<footer><span>foot</span></footer></body></html>"
+    )
+
+
+class DiscoveryQualityFixtureTests(unittest.TestCase):
+    def setUp(self) -> None:
+        self.tmp = Path(tempfile.mkdtemp(prefix="pch150-site-"))
+        self.site = self.tmp / "site"
+        self.site.mkdir()
+        (self.site / "index.html").write_text(
+            _page(
+                "https://priyanshchordia.com/",
+                "Home",
+                "<p>hi</p><p>"
+                + "".join(
+                    f'<a href="/apps/{slug}/{kind}/">{slug} {kind}</a> '
+                    for slug in ("mala", "anjali", "svara", "roam")
+                    for kind in ("privacy", "support")
+                )
+                + "</p>",
+            ),
+            encoding="utf-8",
+        )
+        (self.site / "404.html").write_text(
+            _page(
+                "https://priyanshchordia.com/404.html",
+                "Missing",
+                "<p>lost</p>",
+            ).replace('content="index,follow"', 'content="noindex,follow"'),
+            encoding="utf-8",
+        )
+        for slug in ("mala", "anjali", "svara", "roam"):
+            for kind in ("privacy", "support"):
+                path = self.site / "apps" / slug / kind / "index.html"
+                path.parent.mkdir(parents=True, exist_ok=True)
+                path.write_text(
+                    _page(
+                        f"https://priyanshchordia.com/apps/{slug}/{kind}/",
+                        f"{slug} {kind}",
+                        "<p>legal</p>",
+                    ),
+                    encoding="utf-8",
+                )
+        (self.site / "robots.txt").write_text(
+            "User-agent: *\nAllow: /\nSitemap: https://priyanshchordia.com/sitemap.xml\n",
+            encoding="utf-8",
+        )
+        self._write_sitemap(
+            [
+                "https://priyanshchordia.com/",
+                *[
+                    f"https://priyanshchordia.com/apps/{slug}/{kind}/"
+                    for slug in ("mala", "anjali", "svara", "roam")
+                    for kind in ("privacy", "support")
+                ],
+            ]
+        )
+
+    def tearDown(self) -> None:
+        shutil.rmtree(self.tmp, ignore_errors=True)
+
+    def _write_sitemap(self, locs: list[str]) -> None:
+        urls = "".join(f"<url><loc>{loc}</loc></url>" for loc in locs)
+        (self.site / "sitemap.xml").write_text(
+            '<?xml version="1.0" encoding="UTF-8"?>'
+            f'<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">{urls}</urlset>',
+            encoding="utf-8",
+        )
+
+    def test_clean_fixture_passes(self) -> None:
+        self.assertEqual(CHECK.main(self.site), 0)
+
+    def test_duplicate_sitemap_loc_fails(self) -> None:
+        self._write_sitemap(
+            [
+                "https://priyanshchordia.com/",
+                "https://priyanshchordia.com/",
+                *[
+                    f"https://priyanshchordia.com/apps/{slug}/{kind}/"
+                    for slug in ("mala", "anjali", "svara", "roam")
+                    for kind in ("privacy", "support")
+                ],
+            ]
+        )
+        self.assertEqual(CHECK.main(self.site), 1)
+
+    def test_invalid_sitemap_loc_fails(self) -> None:
+        self._write_sitemap(
+            [
+                "https://priyanshchordia.com/",
+                "https://evil.example/not-ours",
+                *[
+                    f"https://priyanshchordia.com/apps/{slug}/{kind}/"
+                    for slug in ("mala", "anjali", "svara", "roam")
+                    for kind in ("privacy", "support")
+                ],
+            ]
+        )
+        self.assertEqual(CHECK.main(self.site), 1)
+
+    def test_missing_html_lang_fails(self) -> None:
+        bad = _page("https://priyanshchordia.com/", "Home", "<p>hi</p>", lang="")
+        bad = bad.replace('lang=""', "", 1)
+        (self.site / "index.html").write_text(bad, encoding="utf-8")
+        self.assertEqual(CHECK.main(self.site), 1)
+
+    def test_empty_title_and_description_fail(self) -> None:
+        (self.site / "index.html").write_text(
+            _page("https://priyanshchordia.com/", " ", "<p>hi</p>", description="   "),
+            encoding="utf-8",
+        )
+        self.assertEqual(CHECK.main(self.site), 1)
+
+    def test_duplicate_ids_fail(self) -> None:
+        (self.site / "index.html").write_text(
+            _page(
+                "https://priyanshchordia.com/",
+                "Home",
+                "<p>hi</p>",
+                extra_ids='<span id="dup"></span><span id="dup"></span>',
+            ),
+            encoding="utf-8",
+        )
+        self.assertEqual(CHECK.main(self.site), 1)
+
+    def test_nav_without_accessible_name_fails(self) -> None:
+        (self.site / "index.html").write_text(
+            _page("https://priyanshchordia.com/", "Home", "<p>hi</p>", nav_label=""),
+            encoding="utf-8",
+        )
+        self.assertEqual(CHECK.main(self.site), 1)
+
+    def test_not_found_must_be_noindex(self) -> None:
+        (self.site / "404.html").write_text(
+            _page("https://priyanshchordia.com/404.html", "Missing", "<p>lost</p>"),
+            encoding="utf-8",
+        )
+        self.assertEqual(CHECK.main(self.site), 1)
+
+    def test_broken_local_reference_uses_existing_link_checker(self) -> None:
+        (self.site / "index.html").write_text(
+            _page(
+                "https://priyanshchordia.com/",
+                "Home",
+                '<p><a href="/missing-page/">gone</a></p>',
+            ),
+            encoding="utf-8",
+        )
+        result = subprocess.run(
+            [sys.executable, str(ROOT / "scripts" / "check_local_links.py"), str(self.site)],
+            capture_output=True,
+            text=True,
+            check=False,
+        )
+        self.assertNotEqual(result.returncode, 0)
+        self.assertIn("missing-page", result.stdout + result.stderr)
+
+
+if __name__ == "__main__":
+    unittest.main()
