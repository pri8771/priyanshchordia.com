+"""Focused generator/data contract tests (PCH-148 queue items 1–4).
+
+Documents current load_posts / product-app-landing behavior without inventing
+new content policy. Generator fixes, if any, belong in a lead-owned patch.
+"""
+
+from __future__ import annotations
+
+import importlib.util
+import json
+import shutil
+import tempfile
+import unittest
+from pathlib import Path
+
+
+ROOT = Path(__file__).resolve().parents[1]
+SPEC = importlib.util.spec_from_file_location("generate_site", ROOT / "scripts" / "generate_site.py")
+assert SPEC and SPEC.loader
+GEN = importlib.util.module_from_spec(SPEC)
+SPEC.loader.exec_module(GEN)
