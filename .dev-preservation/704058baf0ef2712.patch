diff --git a/tests/test_client_assets.py b/tests/test_client_assets.py
new file mode 100644
index 0000000..becd3b3
--- /dev/null
+++ b/tests/test_client_assets.py
@@ -0,0 +1,132 @@
+"""Client asset inventory and lifecycle contract tests (PCH-149 queue items 9–12).
+
+Static/source checks only unless a loopback browser is explicitly available.
+Does not claim a full UX or assistive-technology pass.
+"""
+
+from __future__ import annotations
+
+import importlib.util
+import re
+import subprocess
+import tempfile
+import unittest
+from pathlib import Path
+
+
+ROOT = Path(__file__).resolve().parents[1]
+SCRIPTS = ROOT / "scripts"
+EXPERIENCES = SCRIPTS / "experiences"
+THEMES = SCRIPTS / "themes"
+
+SPEC = importlib.util.spec_from_file_location("generate_site", SCRIPTS / "generate_site.py")
+assert SPEC and SPEC.loader
+GEN = importlib.util.module_from_spec(SPEC)
+SPEC.loader.exec_module(GEN)
+
+
+# common.js + experience modules + dispatch.js form one IIFE; halves are not
+# independently parseable. Standalone scripts and the assembled bundle are.
+STANDALONE_JS = [
+    SCRIPTS / "app-themes.js",
+    SCRIPTS / "waitlist.js",
+    *[EXPERIENCES / f"{name}.js" for name in GEN.EXPERIENCE_FILES],
+]
+
+
+class ClientAssetInventoryTests(unittest.TestCase):
+    def test_source_js_modules_syntax_check(self) -> None:
+        for path in STANDALONE_JS:
+            with self.subTest(path=path.name):
+                result = subprocess.run(
+                    ["node", "--check", str(path)],
+                    capture_output=True,
+                    text=True,
+                    check=False,
+                )
+                self.assertEqual(result.returncode, 0, result.stderr)
+        assembled = GEN._load_js()
+        with tempfile.NamedTemporaryFile("w", suffix=".js", delete=False, encoding="utf-8") as handle:
+            handle.write(assembled)
+            assembled_path = Path(handle.name)
+        try:
+            result = subprocess.run(
+                ["node", "--check", str(assembled_path)],
+                capture_output=True,
+                text=True,
+                check=False,
+            )
+            self.assertEqual(result.returncode, 0, result.stderr)
+        finally:
+            assembled_path.unlink(missing_ok=True)
+
+    def test_generator_experience_inventory_matches_source_modules(self) -> None:
+        on_disk = {path.stem for path in EXPERIENCES.glob("*.js")}
+        expected = {"common", "dispatch", *GEN.EXPERIENCE_FILES}
+        self.assertEqual(on_disk, expected)
+        assembled = GEN._load_js()
+        for name in ["common", *GEN.EXPERIENCE_FILES, "dispatch"]:
+            snippet = (EXPERIENCES / f"{name}.js").read_text(encoding="utf-8")
+            self.assertIn(snippet, assembled)
+
+    def test_theme_css_inventory_covers_declared_themes_plus_shared(self) -> None:
+        theme_files = {path.name for path in THEMES.glob("*.css")}
+        for slug, _name in GEN.THEMES:
+            self.assertIn(f"{slug}.css", theme_files)
+        self.assertIn("base.css", theme_files)
+        self.assertIn("app-landings.css", theme_files)
+        self.assertIn("landing-system.css", theme_files)
+
+
+class LifecycleContractTests(unittest.TestCase):
+    def test_common_defines_reduced_motion_flag(self) -> None:
+        common = (EXPERIENCES / "common.js").read_text(encoding="utf-8")
+        self.assertIn('matchMedia("(prefers-reduced-motion: reduce)")', common)
+        self.assertIn("var reduce =", common)
+
+    def test_dispatch_tears_down_previous_experience_before_switch(self) -> None:
+        dispatch = (EXPERIENCES / "dispatch.js").read_text(encoding="utf-8")
+        self.assertIn("previous.destroy()", dispatch)
+        self.assertIn("host.innerHTML = \"\"", dispatch)
+        self.assertIn("restorePageSkip()", dispatch)
+        self.assertIn("MutationObserver(sync)", dispatch)
+
+    def test_each_experience_exports_destroy_and_removes_window_listeners(self) -> None:
+        for name in GEN.EXPERIENCE_FILES:
+            source = (EXPERIENCES / f"{name}.js").read_text(encoding="utf-8")
+            with self.subTest(experience=name):
+                self.assertIn("destroy:", source)
+                self.assertIn("reduce", source)
+                adds = re.findall(r"window\.addEventListener\(\s*[\"'](\w+)[\"']", source)
+                for event in adds:
+                    self.assertIn(
+                        f'window.removeEventListener("{event}"',
+                        source.replace("'", '"'),
+                        f"{name} adds window {event} without remove in destroy path",
+                    )
+
+    def test_app_themes_exits_safely_when_required_elements_missing(self) -> None:
+        source = (SCRIPTS / "app-themes.js").read_text(encoding="utf-8")
+        self.assertIn("if (!root || !picker || !description) return;", source)
+        self.assertIn("isAllowed", source)
+
+    def test_dispatch_failure_path_clears_host_for_repeated_init(self) -> None:
+        dispatch = (EXPERIENCES / "dispatch.js").read_text(encoding="utf-8")
+        self.assertIn("Experience unavailable; showing the accessible catalogue.", dispatch)
+        # Failure path nulls active and clears host so sync can run again.
+        self.assertRegex(dispatch, r"active = null;\s*host\.innerHTML = \"\"")
+
+
+class BrowserEvidenceNoteTests(unittest.TestCase):
+    def test_browser_ux_not_claimed_by_static_suite(self) -> None:
+        """Queue item 12: static tests are not a keyboard/browser UX pass.
+
+        Targeted loopback browser evidence is recorded by the session lead in
+        SESSION_3_RETURN.md when a preview server is available; absence of that
+        evidence must not be treated as a green UX audit.
+        """
+        self.assertTrue(True)
+
+
+if __name__ == "__main__":
+    unittest.main()
