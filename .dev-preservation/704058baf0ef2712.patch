+class DeterministicGenerationTests(unittest.TestCase):
+    def test_identical_inputs_produce_stable_outputs_twice(self) -> None:
+        """Two generates into temp OUT dirs from the same source should match.
+
+        Asset query hashes are content-derived; this does not require build
+        metadata to disappear — only that repeated runs with identical inputs
+        yield byte-identical trees for comparable files.
+        """
+        with tempfile.TemporaryDirectory(prefix="pch148-out-a-") as a_dir, tempfile.TemporaryDirectory(
+            prefix="pch148-out-b-"
+        ) as b_dir:
+            out_a = Path(a_dir) / "site"
+            out_b = Path(b_dir) / "site"
+            original_out = GEN.OUT
+            try:
+                GEN.OUT = out_a
+                self.assertEqual(GEN.main(), 0)
+                GEN.OUT = out_b
+                self.assertEqual(GEN.main(), 0)
+            finally:
+                GEN.OUT = original_out
+
+            files_a = {p.relative_to(out_a): p.read_bytes() for p in out_a.rglob("*") if p.is_file()}
+            files_b = {p.relative_to(out_b): p.read_bytes() for p in out_b.rglob("*") if p.is_file()}
+            self.assertEqual(set(files_a), set(files_b))
+            mismatches = [rel for rel, data in files_a.items() if files_b[rel] != data]
+            self.assertEqual(mismatches, [], f"nondeterministic outputs: {mismatches}")
