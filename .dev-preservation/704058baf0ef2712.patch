+from __future__ import annotations
+
+import importlib.util
+import re
+import unittest
+from pathlib import Path
+
+
+ROOT = Path(__file__).resolve().parents[1]
+SPEC = importlib.util.spec_from_file_location("generate_site", ROOT / "scripts" / "generate_site.py")
+assert SPEC and SPEC.loader
+GEN = importlib.util.module_from_spec(SPEC)
+SPEC.loader.exec_module(GEN)
+
+
+class WaitlistMarkupTests(unittest.TestCase):
+    def test_product_waitlist_markup_has_accessibility_hooks(self) -> None:
+        products = GEN.load_products()
+        product = products[0]
+        landing = GEN.load_landing_pages(products)[str(product["slug"])]
+        rendered = GEN.product_page(product, landing, None)
+        slug = str(product["slug"])
+        email_id = f"waitlist-email-{slug}"
+        consent_id = f"waitlist-consent-{slug}"
+        status_id = f"waitlist-status-{slug}"
+
+        self.assertIn('form data-waitlist data-app-name="', rendered)
+        self.assertRegex(
+            rendered,
+            rf'<input id="{re.escape(email_id)}" type="email" name="email" '
+            rf'[^>]*aria-describedby="{re.escape(status_id)}"[^>]*required>',
+        )
+        self.assertRegex(
+            rendered,
+            rf'<input id="{re.escape(consent_id)}" type="checkbox" name="consent" '
+            rf'aria-describedby="{re.escape(status_id)}" required>',
+        )
+        self.assertIn(
+            f'<p id="{status_id}" class="waitlist-status" role="status" '
+            'aria-live="polite" tabindex="-1"></p>',
+            rendered,
+        )
+
+    def test_waitlist_markup_preserves_honest_fallback_boundary(self) -> None:
+        products = GEN.load_products()
+        product = products[0]
+        landing = GEN.load_landing_pages(products)[str(product["slug"])]
+        rendered = GEN.product_page(product, landing, None)
+
+        self.assertIn("The signup service is not connected yet.", rendered)
+        self.assertIn("you will be added by hand", rendered)
+        self.assertNotIn("You are subscribed", rendered)
+        self.assertNotIn("Signup complete", rendered)
+
+
+if __name__ == "__main__":
+    unittest.main()
