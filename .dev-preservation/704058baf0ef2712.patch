@@ -0,0 +1,198 @@
+const assert = require("node:assert/strict");
+const path = require("node:path");
+const test = require("node:test");
+
+const WAITLIST = path.resolve(__dirname, "../scripts/waitlist.js");
+
+class MockElement {
+  constructor() {
+    this.attributes = new Map();
+    this.listeners = new Map();
+    this.textContent = "";
+    this.focusCount = 0;
+  }
+
+  addEventListener(type, handler) {
+    const handlers = this.listeners.get(type) || [];
+    handlers.push(handler);
+    this.listeners.set(type, handlers);
+  }
+
+  dispatchEvent(type, event = {}) {
+    for (const handler of this.listeners.get(type) || []) {
+      handler(event);
+    }
+  }
+
+  focus() {
+    this.focusCount += 1;
+  }
+
+  getAttribute(name) {
+    return this.attributes.has(name) ? this.attributes.get(name) : null;
+  }
+
+  removeAttribute(name) {
+    this.attributes.delete(name);
+  }
+
+  setAttribute(name, value) {
+    this.attributes.set(name, String(value));
+  }
+}
+
+class MockEmail extends MockElement {
+  constructor() {
+    super();
+    this.value = "";
+  }
+
+  get validity() {
+    return {
+      valid: /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(this.value),
+    };
+  }
+}
+
+class MockCheckbox extends MockElement {
+  constructor() {
+    super();
+    this.checked = false;
+  }
+}
+
+class MockForm extends MockElement {
+  constructor() {
+    super();
+    this.dataset = { appName: "Mala" };
+    this.elements = {
+      email: new MockEmail(),
+      consent: new MockCheckbox(),
+    };
+    this.status = new MockElement();
+    this.status.id = "waitlist-status-mala";
+  }
+
+  querySelector(selector) {
+    assert.equal(selector, ".waitlist-status");
+    return this.status;
+  }
+
+  submit() {
+    let defaultPrevented = false;
+    this.dispatchEvent("submit", {
+      preventDefault() {
+        defaultPrevented = true;
+      },
+    });
+    return defaultPrevented;
+  }
+}
+
+function loadWaitlist(form) {
+  delete require.cache[WAITLIST];
+  global.document = {
+    querySelectorAll(selector) {
+      assert.equal(selector, "form[data-waitlist]");
+      return [form];
+    },
+  };
+  require(WAITLIST);
+}
+
+test.afterEach(() => {
+  delete global.document;
+  delete require.cache[WAITLIST];
+});
+
+test("empty email marks email invalid and focuses status", () => {
+  const form = new MockForm();
+  loadWaitlist(form);
+
+  assert.equal(form.submit(), true);
+
+  assert.equal(form.elements.email.getAttribute("aria-invalid"), "true");
+  assert.equal(form.elements.consent.getAttribute("aria-invalid"), null);
+  assert.equal(
+    form.status.textContent,
+    "Enter the email address where invitations should go.",
+  );
+  assert.equal(form.status.focusCount, 1);
+});
+
+test("invalid email marks email invalid", () => {
+  const form = new MockForm();
+  form.elements.email.value = "not-an-email";
+  form.elements.consent.checked = true;
+  loadWaitlist(form);
+
+  assert.equal(form.submit(), true);
+
+  assert.equal(form.elements.email.getAttribute("aria-invalid"), "true");
+  assert.equal(
+    form.status.textContent,
+    "That does not look like an email address. Check for a missing @ or domain.",
+  );
+  assert.equal(form.status.focusCount, 1);
+});
+
+test("missing consent marks consent invalid", () => {
+  const form = new MockForm();
+  form.elements.email.value = "tester@example.com";
+  loadWaitlist(form);
+
+  assert.equal(form.submit(), true);
+
+  assert.equal(form.elements.email.getAttribute("aria-invalid"), null);
+  assert.equal(form.elements.consent.getAttribute("aria-invalid"), "true");
+  assert.equal(
+    form.status.textContent,
+    "Please tick the consent box so we can email you about Mala.",
+  );
+  assert.equal(form.status.focusCount, 1);
+});
+
+test("correction clears stale invalid state", () => {
+  const form = new MockForm();
+  loadWaitlist(form);
+
+  form.submit();
+  assert.equal(form.elements.email.getAttribute("aria-invalid"), "true");
+
+  form.elements.email.value = "tester@example.com";
+  form.elements.email.dispatchEvent("input");
+  assert.equal(form.elements.email.getAttribute("aria-invalid"), null);
+
+  form.submit();
+  assert.equal(form.elements.consent.getAttribute("aria-invalid"), "true");
+
+  form.elements.consent.checked = true;
+  form.elements.consent.dispatchEvent("change");
+  assert.equal(form.elements.consent.getAttribute("aria-invalid"), null);
+});
+
+test("valid submit keeps honest fallback message and never implies success", () => {
+  const form = new MockForm();
+  form.elements.email.value = "tester@example.com";
+  form.elements.consent.checked = true;
+  loadWaitlist(form);
+
+  assert.equal(form.submit(), true);
+
+  assert.equal(form.elements.email.getAttribute("aria-invalid"), null);
+  assert.equal(form.elements.consent.getAttribute("aria-invalid"), null);
+  assert.equal(
+    form.status.textContent,
+    "The signup form is unavailable right now. Use the email link below and you will be added by hand.",
+  );
+  assert.doesNotMatch(form.status.textContent, /success|subscribed|joined/i);
+  assert.equal(form.status.focusCount, 1);
+});
+
+test("controls are described by the stable status element", () => {
+  const form = new MockForm();
+  loadWaitlist(form);
+
+  assert.equal(form.elements.email.getAttribute("aria-describedby"), "waitlist-status-mala");
+  assert.equal(form.elements.consent.getAttribute("aria-describedby"), "waitlist-status-mala");
+});
