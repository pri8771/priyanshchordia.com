+"""Chrome discovery portability contracts (C3 item 3)."""
+
+from __future__ import annotations
+
+import importlib.util
+import os
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+from unittest import mock
+
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+def load_cdp():
+    spec = importlib.util.spec_from_file_location("cdp_client_c3", ROOT / "scripts" / "cdp_client.py")
+    assert spec and spec.loader
+    mod = importlib.util.module_from_spec(spec)
+    sys.modules["cdp_client_c3"] = mod
+    spec.loader.exec_module(mod)
+    return mod
+
+
+class ChromeDiscoveryTests(unittest.TestCase):
+    def test_discover_succeeds_on_this_host_or_skip_message(self) -> None:
+        cdp = load_cdp()
+        report = cdp.chrome_discovery_report()
+        self.assertIn("ok", report)
+        self.assertIn("candidates_tried", report)
+        if report["ok"]:
+            self.assertTrue(Path(report["resolved"]).is_file())
+        else:
+            self.assertIn("PCH_CHROME_PATH", report["hint"] or "")
+
+    def test_override_env_wins(self) -> None:
+        cdp = load_cdp()
+        with tempfile.TemporaryDirectory() as tmp:
+            fake = Path(tmp) / "fake-chrome"
+            fake.write_text("#!/bin/sh\nexit 0\n", encoding="utf-8")
+            fake.chmod(0o755)
+            with mock.patch.dict(os.environ, {"PCH_CHROME_PATH": str(fake)}):
+                resolved = cdp.discover_chrome(require=True)
+            self.assertEqual(resolved, fake)
+
+    def test_missing_override_raises_actionable_error(self) -> None:
+        cdp = load_cdp()
+        bogus = "/tmp/pch-c3-missing-chrome-binary-xyz"
+        with self.assertRaises(cdp.ChromeDiscoveryError) as ctx:
+            cdp.discover_chrome(override=bogus, require=True)
+        message = str(ctx.exception)
+        self.assertIn(bogus, message)
+        self.assertIn("PCH_CHROME_PATH", message)
+        self.assertIn("Tried:", message)
+
+    def test_require_false_returns_none(self) -> None:
+        cdp = load_cdp()
+        resolved = cdp.discover_chrome(override="/tmp/pch-c3-missing-chrome-binary-xyz", require=False)
+        self.assertIsNone(resolved)
+
+
+    def test_discovery_report_env_exclusive(self) -> None:
+        cdp = load_cdp()
+        bogus = "/tmp/pch-c3-missing-chrome-binary-report"
+        with mock.patch.dict(os.environ, {"PCH_CHROME_PATH": bogus}):
+            report = cdp.chrome_discovery_report()
+        self.assertFalse(report["ok"])
+        self.assertEqual(report["mode"], "env")
+        self.assertEqual(report["candidates_tried"][0]["path"], bogus)
+
+    def test_browser_probe_imports_discover(self) -> None:
+        source = (ROOT / "scripts" / "chrome_browser_probe.py").read_text(encoding="utf-8")
+        self.assertIn("discover_chrome", source)
+        self.assertIn("ChromeDiscoveryError", source)
+        self.assertNotIn(
+            'CHROME = Path("/Applications/Google Chrome.app/Contents/MacOS/Google Chrome")',
+            source,
+        )
+
+
+if __name__ == "__main__":
+    unittest.main()
