+    parser.add_argument("--skip-clean-checkout", action="store_true")
+    parser.add_argument("--skip-c4-matrix", action="store_true")
+    parser.add_argument("--skip-c4-a11y-depth", action="store_true")
+    parser.add_argument("--skip-c4-content", action="store_true")
+    parser.add_argument("--skip-c4-static-host", action="store_true")
+    parser.add_argument("--skip-c4-privacy", action="store_true")
+    parser.add_argument("--skip-c4-perf", action="store_true")
+    parser.add_argument("--skip-c4-seo", action="store_true")
+    parser.add_argument("--skip-c4-visual-depth", action="store_true")
+    parser.add_argument("--skip-c4-receipt-hardening", action="store_true")
+    parser.add_argument(
+        "--fast",
+        action="store_true",
+        help="Skip the longest Chrome matrix/visual-depth runs (still runs core C3 + lighter C4).",
+    )
+    args = parser.parse_args()
+
+    if args.fast:
