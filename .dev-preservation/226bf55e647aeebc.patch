+#!/usr/bin/env python3
+"""SEO and machine-readable metadata validation (C4 Lane 7).
+
+Static checks for titles, descriptions, canonical/OG/Twitter tags, JSON-LD,
+robots/sitemap consistency, and duplicate metadata across HTML pages.
+Does not invent or rewrite page content — reports failures for integration owner.
+"""
+
+from __future__ import annotations
+
+import argparse
+import importlib.util
+import json
+import sys
+import xml.etree.ElementTree as ET
+from collections import Counter
+from datetime import datetime, timezone
+from pathlib import Path
+from typing import Any
+
+ROOT = Path(__file__).resolve().parents[1]
+SITE = ROOT / "site"
+DEFAULT_EVIDENCE = ROOT / "session-c4-evidence" / "seo"
+BASE_URL = "https://priyanshchordia.com"
+SITEMAP_NS = "{http://www.sitemaps.org/schemas/sitemap/0.9}"
+
+TITLE_MIN_LEN = 1
+TITLE_MAX_LEN = 120
+DESC_MIN_LEN = 1
+DESC_MAX_LEN = 320
+
+# Reuse required meta sets from scripts/check_site.py and tests/test_discovery_quality.py
+REQUIRED_META_NAMES_INDEXABLE = (
+    "description",
+    "robots",
+    "viewport",
+    "twitter:card",
+    "twitter:image",
+    "twitter:image:alt",
+)
+REQUIRED_META_PROPERTIES_INDEXABLE = (
+    "og:type",
+    "og:title",
+    "og:description",
+    "og:url",
+    "og:image",
+    "og:image:width",
+    "og:image:height",
+    "og:image:alt",
+)
+INDEXABLE_OG_TWITTER_CORE = (
+    "og:title",
+    "og:description",
+    "og:image",
+    "twitter:card",
+)
+
+
+def _load_check_site():
+    spec = importlib.util.spec_from_file_location("check_site", ROOT / "scripts" / "check_site.py")
+    assert spec and spec.loader
+    mod = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(mod)
+    return mod
+
+
+CHECK = _load_check_site()
+PageParser = CHECK.PageParser
+
+
+class SeoPageParser(PageParser):
+    """PageParser extended with Open Graph / Twitter property values."""
+
+    def __init__(self) -> None:
+        super().__init__()
+        self.meta_property_values: dict[str, str] = {}
+
+    def handle_starttag(self, tag: str, attrs: list[tuple[str, str | None]]) -> None:
+        super().handle_starttag(tag, attrs)
+        if tag != "meta":
+            return
+        values = {key: value or "" for key, value in attrs}
+        if values.get("property"):
+            prop = values["property"].lower()
+            self.meta_property_values[prop] = values.get("content", "")
+
+
+def expected_canonical(rel: Path) -> str:
+    if rel == Path("index.html"):
+        return BASE_URL + "/"
+    if rel.name == "index.html" and rel.parent != Path("."):
+        return BASE_URL + "/" + rel.parent.as_posix() + "/"
+    return BASE_URL + "/" + rel.as_posix()
+
+
+def is_not_found_page(rel: Path) -> bool:
+    return rel == Path("404.html")
+
+
+def is_indexable(rel: Path, parser: SeoPageParser) -> bool:
+    if is_not_found_page(rel):
+        return False
+    robots = parser.meta_name_values.get("robots", "").lower()
+    return "noindex" not in robots
+
+
+def validate_json_ld(payload: str, canonical: str | None) -> list[str]:
+    issues: list[str] = []
+    try:
+        data = json.loads(payload)
+    except json.JSONDecodeError as exc:
+        return [f"invalid JSON-LD: {exc}"]
+
+    nodes: list[dict[str, Any]] = []
+    if isinstance(data, dict):
+        nodes.append(data)
+    elif isinstance(data, list):
+        nodes.extend(item for item in data if isinstance(item, dict))
+    else:
+        return ["JSON-LD root must be an object or array of objects"]
+
+    for idx, node in enumerate(nodes):
+        prefix = f"JSON-LD block {idx + 1}"
+        context = node.get("@context")
+        if not context:
+            issues.append(f"{prefix}: missing @context")
+        elif isinstance(context, str) and not context.startswith("https://schema.org"):
+            issues.append(f"{prefix}: @context should reference schema.org")
+        if not node.get("@type"):
+            issues.append(f"{prefix}: missing @type")
+        node_url = node.get("url")
+        if node_url and canonical and node_url.rstrip("/") != canonical.rstrip("/"):
+            issues.append(f"{prefix}: url {node_url!r} does not match canonical {canonical!r}")
+        node_type = node.get("@type")
+        if node_type in {"WebSite", "SoftwareApplication", "WebPage", "CollectionPage"}:
+            if not str(node.get("name", "")).strip():
+                issues.append(f"{prefix}: {node_type} missing non-empty name")
+        is_part_of = node.get("isPartOf")
+        if isinstance(is_part_of, dict):
+            site_url = is_part_of.get("url")
+            if site_url and site_url.rstrip("/") != BASE_URL.rstrip("/"):
+                issues.append(f"{prefix}: isPartOf.url {site_url!r} is not site root")
+    return issues
+
+
+def analyze_page(rel: str, html: str) -> dict[str, Any]:
+    rel_path = Path(rel)
+    parser = SeoPageParser()
+    parser.feed(html)
+    parser.close()
+
+    issues: list[str] = []
+    indexable = is_indexable(rel_path, parser)
+    canonical = parser.canonicals[0] if len(parser.canonicals) == 1 else None
+
+    if not parser.html_lang.strip():
+        issues.append("missing html lang attribute")
+    if parser.title_count != 1:
+        issues.append(f"expected exactly one title tag, found {parser.title_count}")
+    title = parser.title_text.strip()
+    if not title:
+        issues.append("empty title text")
+    elif len(title) < TITLE_MIN_LEN or len(title) > TITLE_MAX_LEN:
+        issues.append(f"title length {len(title)} outside {TITLE_MIN_LEN}-{TITLE_MAX_LEN}")
+
+    if "robots" not in parser.meta_names:
+        issues.append("missing meta name=robots")
+    elif is_not_found_page(rel_path):
+        robots = parser.meta_name_values.get("robots", "").lower()
+        if "noindex" not in robots:
+            issues.append("404 page must include noindex in robots meta")
+
+    if indexable:
+        for required in REQUIRED_META_NAMES_INDEXABLE:
+            if required not in parser.meta_names:
+                issues.append(f"missing meta name={required}")
+        for required in REQUIRED_META_PROPERTIES_INDEXABLE:
+            if required not in parser.meta_properties:
+                issues.append(f"missing meta property={required}")
+        for required in INDEXABLE_OG_TWITTER_CORE:
+            if required.startswith("og:"):
+                if required not in parser.meta_properties:
+                    issues.append(f"missing meta property={required}")
+                elif not parser.meta_property_values.get(required, "").strip():
+                    issues.append(f"empty meta property={required}")
+            elif required not in parser.meta_names:
+                issues.append(f"missing meta name={required}")
+            elif not parser.meta_name_values.get(required, "").strip():
+                issues.append(f"empty meta name={required}")
+
+    if not is_not_found_page(rel_path):
+        if "description" not in parser.meta_names:
+            issues.append("missing meta name=description")
+        else:
+            description = parser.meta_name_values.get("description", "").strip()
+            if not description:
+                issues.append("empty meta description")
+            elif len(description) < DESC_MIN_LEN or len(description) > DESC_MAX_LEN:
+                issues.append(
+                    f"description length {len(description)} outside {DESC_MIN_LEN}-{DESC_MAX_LEN}"
+                )
+
+    if len(parser.canonicals) != 1:
+        issues.append(f"expected exactly one canonical link, found {len(parser.canonicals)}")
+    else:
+        expected = expected_canonical(rel_path)
+        if parser.canonicals[0] != expected:
+            issues.append(f"canonical is {parser.canonicals[0]!r}, expected {expected!r}")
+        og_url = parser.meta_property_values.get("og:url", "").strip()
+        if og_url and og_url != parser.canonicals[0]:
+            issues.append(f"og:url {og_url!r} does not match canonical {parser.canonicals[0]!r}")
+
+    for payload in parser.json_ld:
+        issues.extend(validate_json_ld(payload, canonical))
+
+    return {
+        "path": rel,
+        "indexable": indexable,
+        "lang": parser.html_lang,
+        "title": title,
+        "canonical": canonical,
+        "description_len": len(parser.meta_name_values.get("description", "").strip()),
+        "json_ld_blocks": len(parser.json_ld),
+        "issues": issues,
+        "ok": not issues,
+    }
+
+
+def validate_robots_and_sitemap(site: Path, pages: dict[Path, SeoPageParser]) -> list[str]:
+    issues: list[str] = []
+    robots_path = site / "robots.txt"
+    sitemap_path = site / "sitemap.xml"
+    not_found = site / "404.html"
+
+    for path in (robots_path, sitemap_path):
+        if not path.is_file():
+            issues.append(f"missing discovery file: {path.name}")
+
+    if robots_path.is_file():
+        robots_text = robots_path.read_text(encoding="utf-8")
+        if f"Sitemap: {BASE_URL}/sitemap.xml" not in robots_text:
+            issues.append("robots.txt does not reference production sitemap URL")
+
+    if not sitemap_path.is_file():
+        return issues
+
+    try:
+        root = ET.parse(sitemap_path).getroot()
+        loc_nodes = [
+            node.text.strip()
+            for node in root.findall(f"{SITEMAP_NS}url/{SITEMAP_NS}loc")
+            if node.text and node.text.strip()
+        ]
+    except ET.ParseError as exc:
+        return issues + [f"sitemap.xml is invalid XML: {exc}"]
+
+    duplicate_locs = sorted(url for url, count in Counter(loc_nodes).items() if count > 1)
+    if duplicate_locs:
+        issues.append("sitemap contains duplicate loc entries: " + ", ".join(duplicate_locs))
+
+    invalid_locs = sorted(
+        url for url in loc_nodes if not url.startswith(BASE_URL + "/") and url != BASE_URL + "/"
+    )
+    if invalid_locs:
+        issues.append("sitemap contains invalid loc entries: " + ", ".join(invalid_locs))
+
+    sitemap_urls = set(loc_nodes)
+    canonical_urls = {
+        parser.canonicals[0]
+        for path, parser in pages.items()
+        if path != not_found.resolve()
+        and len(parser.canonicals) == 1
+        and "noindex" not in parser.meta_name_values.get("robots", "").lower()
+    }
+    missing = canonical_urls - sitemap_urls
+    extra = sitemap_urls - canonical_urls
+    if missing:
+        issues.append("sitemap missing canonical URLs: " + ", ".join(sorted(missing)))
+    if extra:
+        issues.append("sitemap contains URLs without matching indexable pages: " + ", ".join(sorted(extra)))
+
+    return issues
+
+
+def collect_pages(site: Path) -> tuple[list[dict[str, Any]], dict[Path, SeoPageParser], list[str]]:
+    page_results: list[dict[str, Any]] = []
+    parsed: dict[Path, SeoPageParser] = {}
+    site_errors: list[str] = []
+
+    for path in sorted(site.rglob("*.html")):
+        rel = path.relative_to(site)
+        html = path.read_text(encoding="utf-8")
+        parser = SeoPageParser()
+        parser.feed(html)
+        parser.close()
+        parsed[path.resolve()] = parser
+        result = analyze_page(rel.as_posix(), html)
+        page_results.append(result)
+        site_errors.extend(f"{rel}: {issue}" for issue in result["issues"])
+
+    site_errors.extend(validate_robots_and_sitemap(site, parsed))
+
+    titles: dict[str, list[str]] = {}
+    for result in page_results:
+        if result.get("indexable") and result.get("title"):
+            titles.setdefault(result["title"], []).append(result["path"])
+    for title, paths in sorted(titles.items()):
+        if len(paths) > 1:
+            site_errors.append(
+                f"duplicate indexable title {title!r} on: {', '.join(sorted(paths))}"
+            )
+
+    return page_results, parsed, site_errors
+
+
+def run(site: Path) -> dict[str, Any]:
+    if not site.is_dir():
+        raise FileNotFoundError(f"site directory missing: {site}")
+
+    started = datetime.now(timezone.utc).isoformat()
+    page_results, _parsed, errors = collect_pages(site)
+    failed_pages = sorted({result["path"] for result in page_results if not result["ok"]})
+    finished = datetime.now(timezone.utc).isoformat()
+
+    return {
+        "started_at": started,
+        "finished_at": finished,
+        "boundary": (
+            "Static SEO metadata validation for generated HTML. "
+            "Does not rewrite markup or invent public claims."
+        ),
+        "site": str(site),
+        "page_count": len(page_results),
+        "pages": page_results,
+        "errors": errors,
+        "failed_pages": failed_pages,
+        "ok": not errors,
+    }
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--site", type=Path, default=SITE, help="Path to generated site/ tree")
+    parser.add_argument("--evidence", type=Path, default=DEFAULT_EVIDENCE)
+    args = parser.parse_args()
+
+    if not args.site.is_dir():
+        print(f"site missing: {args.site}", file=sys.stderr)
+        return 2
+
+    args.evidence.mkdir(parents=True, exist_ok=True)
+    summary = run(args.site)
+    out = args.evidence / "seo_metadata_summary.json"
+    out.write_text(json.dumps(summary, indent=2) + "\n", encoding="utf-8")
+
+    print(
+        json.dumps(
+            {
+                "ok": summary["ok"],
+                "page_count": summary["page_count"],
+                "error_count": len(summary["errors"]),
+                "failed_pages": summary["failed_pages"],
+                "summary": str(out),
+            },
+            indent=2,
+        )
+    )
+    if summary["errors"]:
+        print("seo metadata validation failed:", file=sys.stderr)
+        for error in summary["errors"]:
+            print(f"  - {error}", file=sys.stderr)
+    return 0 if summary["ok"] else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
