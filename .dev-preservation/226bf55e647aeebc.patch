+class StoreAvailabilityCtaTests(unittest.TestCase):
+    def test_verified_store_id_emits_download_not_waitlist(self) -> None:
+        products = GEN.load_products()
+        apps = {str(app["slug"]): app for app in GEN.load_apps(products)}
+        landings = GEN.load_landing_pages(products)
+        mala = next(p for p in products if p["slug"] == "mala")
+        rendered = GEN.product_page(mala, landings["mala"], apps["mala"])
