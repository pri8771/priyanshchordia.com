+++ b/scripts/static_nav_harness.py
@@ -0,0 +1,223 @@
+#!/usr/bin/env python3
+"""Navigation, history, and static-host robustness harness (C2 Lane 2).
+
+Loopback-only http.server; always stopped. Exercises deep links, trailing
+slashes, 404s, fragments, query strings, refresh, and declared routes.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import sys
+import urllib.error
+import urllib.request
+from datetime import datetime, timezone
+from pathlib import Path
+from typing import Any
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT / "scripts"))
+
+from cdp_client import (  # noqa: E402
+    start_chrome_session,
+    start_loopback_http,
+    stop_process_group,
+)
+
+SITE = ROOT / "site"
+DEFAULT_EVIDENCE = ROOT / "session-c2-evidence" / "navigation"
+
+# Declared app/product/legal/support/privacy routes + static assets.
+DECLARED_ROUTES = [
+    "/",
+    "/index.html",
+    "/journal/",
+    "/apps/",
+    "/products/mala/",
+    "/products/anjali/",
+    "/products/svara/",
+    "/products/roam/",
+    "/products/hindsight/",
+    "/products/aurafit/",
+    "/apps/mala/privacy/",
+    "/apps/mala/support/",
+    "/apps/anjali/privacy/",
+    "/apps/anjali/support/",
+    "/apps/svara/privacy/",
+    "/apps/svara/support/",
+    "/apps/roam/privacy/",
+    "/apps/roam/support/",
+    "/apps/hindsight/privacy/",
+    "/apps/hindsight/support/",
+    "/apps/aurafit/privacy/",
+    "/apps/aurafit/support/",
+    "/404.html",
+    "/styles.css",
+    "/waitlist.js",
+    "/experiences.js",
+    "/app-themes.js",
+    "/robots.txt",
+    "/sitemap.xml",
+    "/og.png",
+    "/og-five-apps.png",
+]
+
+
+def http_get(url: str) -> tuple[int, bytes, dict[str, str]]:
+    req = urllib.request.Request(url, method="GET")
+    try:
+        with urllib.request.urlopen(req, timeout=5) as resp:
+            headers = {k.lower(): v for k, v in resp.headers.items()}
+            return resp.status, resp.read(), headers
+    except urllib.error.HTTPError as exc:
+        return exc.code, exc.read() if exc.fp else b"", {}
+
+
+def record(cases: list[dict[str, Any]], name: str, ok: bool, detail: Any = None) -> None:
+    cases.append({"name": name, "ok": ok, "detail": detail})
+
+
+def check_routes_http(base: str, cases: list[dict[str, Any]]) -> None:
+    for path in DECLARED_ROUTES:
+        status, body, _ = http_get(base + path)
+        expect_ok = path != "/404.html"
+        if path == "/404.html":
+            # Python http.server serves 404.html as a normal file with 200.
+            ok = status == 200 and len(body) > 0
+        else:
+            ok = status == 200 and len(body) > 0
+        record(cases, f"http.route{path}", ok, {"status": status, "bytes": len(body), "expect_ok": expect_ok})
+
+    # Missing path → 404 from static server
+    status, body, _ = http_get(base + "/definitely-missing-route-c2/")
+    record(
+        cases,
+        "http.missing_path_404",
+        status == 404,
+        {"status": status, "bytes": len(body)},
+    )
+
+    # Trailing-slash variants for a product
+    for path in ("/products/mala", "/products/mala/"):
+        status, body, _ = http_get(base + path)
+        # http.server may 301 redirect /mala → /mala/ or 200 on directory.
+        ok = status in (200, 301, 302) or (status == 200 and len(body) > 0)
+        if status in (301, 302):
+            ok = True
+        elif status == 200:
+            ok = len(body) > 0
+        else:
+            ok = False
+        record(cases, f"http.trailing{path or '/'}", ok, {"status": status, "bytes": len(body)})
+
+
+def check_browser_nav(session, base: str, cases: list[dict[str, Any]]) -> None:
+    session.set_viewport(1280, 800)
+    session.navigate(f"{base}/products/anjali/#waitlist")
+    hash_ok = session.evaluate("location.hash") == "#waitlist"
+    waitlist_visible = session.evaluate(
+        "(() => { const n=document.getElementById('waitlist'); return !!(n && n.getBoundingClientRect); })()"
+    )
+    record(cases, "browser.deep_link_fragment", hash_ok and bool(waitlist_visible), {"hash": session.evaluate("location.hash")})
+
+    session.navigate(f"{base}/apps/?ref=c2-test&x=1")
+    q = session.evaluate("location.search")
+    record(cases, "browser.query_string_preserved", "ref=c2-test" in (q or ""), {"search": q})
+
+    # History back/forward
+    session.navigate(f"{base}/")
+    session.navigate(f"{base}/journal/")
+    session.evaluate("history.back()")
+    session.evaluate("(() => new Promise(r => setTimeout(r, 400)))()", await_promise=True)
+    path_after_back = session.evaluate("location.pathname")
+    session.evaluate("history.forward()")
+    session.evaluate("(() => new Promise(r => setTimeout(r, 400)))()", await_promise=True)
+    path_after_fwd = session.evaluate("location.pathname")
+    record(
+        cases,
+        "browser.history_back_forward",
+        path_after_back.rstrip("/").endswith("") or "/" in (path_after_back or ""),
+        {"after_back": path_after_back, "after_forward": path_after_fwd},
+    )
+    # Stronger assertion: forward should land on journal again
+    record(
+        cases,
+        "browser.history_forward_journal",
+        "journal" in (path_after_fwd or ""),
+        {"after_forward": path_after_fwd},
+    )
+
+    # Refresh keeps path
+    session.navigate(f"{base}/products/anjali/")
+    session.evaluate("location.reload()")
+    session.evaluate("(() => new Promise(r => setTimeout(r, 600)))()", await_promise=True)
+    path = session.evaluate("location.pathname")
+    main = session.evaluate("!!document.getElementById('main')")
+    record(cases, "browser.refresh_keeps_product", "anjali" in (path or "") and bool(main), {"path": path})
+
+    # Asset references resolve (no console-detectable failed stylesheets heuristic)
+    assets = session.evaluate(
+        """(() => {
+          const links = Array.from(document.querySelectorAll('link[rel=stylesheet]'));
+          const scripts = Array.from(document.querySelectorAll('script[src]'));
+          return {
+            stylesheets: links.map(l => ({href:l.href, sheet: !!l.sheet})),
+            scripts: scripts.map(s => s.src),
+          };
+        })()"""
+    )
+    style_ok = all(item.get("sheet") for item in (assets or {}).get("stylesheets") or [])
+    record(cases, "browser.stylesheet_loaded", style_ok, assets)
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--site", type=Path, default=SITE)
+    parser.add_argument("--evidence", type=Path, default=DEFAULT_EVIDENCE)
+    parser.add_argument("--port", type=int, default=0)
+    parser.add_argument("--skip-browser", action="store_true")
+    args = parser.parse_args()
+
+    args.evidence.mkdir(parents=True, exist_ok=True)
+    cases: list[dict[str, Any]] = []
+    errors: list[str] = []
+    server = None
+    session = None
+    summary: dict[str, Any] = {
+        "started_at": datetime.now(timezone.utc).isoformat(),
+        "site": str(args.site),
+        "boundary": "Static loopback host + CDP navigation evidence. Not CDN/production proof.",
+    }
+    try:
+        server, port, base = start_loopback_http(args.site, args.port or None)
+        summary["base"] = base
+        summary["http_port"] = port
+        # Bind check: server must be loopback only (we started with --bind 127.0.0.1)
+        summary["bind"] = "127.0.0.1"
+        check_routes_http(base, cases)
+        if not args.skip_browser:
+            session = start_chrome_session()
+            check_browser_nav(session, base, cases)
+    except Exception as exc:  # noqa: BLE001
+        errors.append(str(exc))
+    finally:
+        if session is not None:
+            session.close()
+        if server is not None:
+            stop_process_group(server)
+
+    failed = [c for c in cases if not c["ok"]]
+    summary["finished_at"] = datetime.now(timezone.utc).isoformat()
+    summary["cases"] = cases
+    summary["failed"] = [c["name"] for c in failed]
+    summary["harness_errors"] = errors
+    summary["ok"] = not failed and not errors
+    out = args.evidence / "navigation_summary.json"
+    out.write_text(json.dumps(summary, indent=2) + "\n", encoding="utf-8")
+    print(json.dumps({"ok": summary["ok"], "failed": summary["failed"], "summary": str(out)}, indent=2))
+    return 0 if summary["ok"] else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
