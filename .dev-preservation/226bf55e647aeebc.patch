+                "Home",
+                '<main><h1>Home</h1><p><a href="/about/">About</a></p></main>',
+            ),
+            encoding="utf-8",
+        )
+        about = self.site / "about" / "index.html"
+        about.parent.mkdir(parents=True, exist_ok=True)
+        about.write_text(
+            _page(
+                "https://priyanshchordia.com/about/",
+                "About",
+                "<main><h1>About</h1><p><a href='/'>Home</a></p></main>",
