@@ -0,0 +1,423 @@
+#!/usr/bin/env python3
+"""Accessibility depth harness (C4 Lane 2).
+
+Extends semantic checks: contrast proxies, zoom/reflow signals, live regions,
+focus-order samples, keyboard-trap probes, viewport/text-scale signals.
+Local automation is NOT VoiceOver or formal accessibility certification.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import re
+import sys
+from collections import Counter
+from datetime import datetime, timezone
+from html.parser import HTMLParser
+from pathlib import Path
+from typing import Any
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT / "scripts"))
+
+SITE = ROOT / "site"
+DEFAULT_EVIDENCE = ROOT / "session-c4-evidence" / "a11y-depth"
+
+INTERACTIVE_HTML = [
+    "index.html",
+    "journal/index.html",
+    "apps/index.html",
+    "404.html",
+    "products/mala/index.html",
+    "products/anjali/index.html",
+    "products/svara/index.html",
+    "products/roam/index.html",
+    "products/hindsight/index.html",
+    "products/aurafit/index.html",
+    "apps/mala/privacy/index.html",
+    "apps/mala/support/index.html",
+    "apps/anjali/privacy/index.html",
+    "apps/anjali/support/index.html",
+    "apps/svara/privacy/index.html",
+    "apps/svara/support/index.html",
+    "apps/roam/privacy/index.html",
+    "apps/roam/support/index.html",
+    "apps/hindsight/privacy/index.html",
+    "apps/hindsight/support/index.html",
+    "apps/aurafit/privacy/index.html",
+    "apps/aurafit/support/index.html",
+]
+
+
+class DepthParser(HTMLParser):
+    def __init__(self) -> None:
+        super().__init__(convert_charrefs=True)
+        self.lang: str | None = None
+        self.ids: list[str] = []
+        self.live_regions: list[dict[str, str]] = []
+        self.aria_attrs: list[tuple[str, str, str]] = []
+        self.tabindex_values: list[tuple[str, str]] = []
+        self.roles: list[str] = []
+        self.buttons: list[dict[str, str]] = []
+        self.links: list[dict[str, str]] = []
+        self.headings: list[int] = []
+        self.landmarks = 0
+        self._open: list[str] = []
+
+    def handle_starttag(self, tag: str, attrs: list[tuple[str, str | None]]) -> None:
+        values = {k: (v or "") for k, v in attrs}
+        self._open.append(tag)
+        if tag == "html" and values.get("lang"):
+            self.lang = values["lang"]
+        if values.get("id"):
+            self.ids.append(values["id"])
+        role = values.get("role", "")
+        if role:
+            self.roles.append(role)
+        if tag in {"main", "nav", "header", "footer", "aside"} or role in {
+            "main",
+            "navigation",
+            "banner",
+            "contentinfo",
+            "complementary",
+        }:
+            self.landmarks += 1
+        if tag in {"h1", "h2", "h3", "h4", "h5", "h6"}:
+            self.headings.append(int(tag[1]))
+        live = values.get("aria-live", "")
+        if live or role in {"status", "alert", "log"}:
+            self.live_regions.append(
+                {
+                    "tag": tag,
+                    "role": role,
+                    "aria-live": live,
+                    "id": values.get("id", ""),
+                }
+            )
+        for attr in ("aria-labelledby", "aria-describedby", "aria-controls", "aria-owns"):
+            if values.get(attr):
+                self.aria_attrs.append((tag, attr, values[attr]))
+        if "tabindex" in values:
+            self.tabindex_values.append((tag, values["tabindex"]))
+        if tag == "button" or role == "button":
+            self.buttons.append(
+                {
+                    "tag": tag,
+                    "id": values.get("id", ""),
+                    "aria-label": values.get("aria-label", ""),
+                    "type": values.get("type", ""),
+                    "text_hint": "",
+                }
+            )
+        if tag == "a":
+            self.links.append(
+                {
+                    "href": values.get("href", ""),
+                    "aria-label": values.get("aria-label", ""),
+                    "id": values.get("id", ""),
+                }
+            )
+
+    def handle_startendtag(self, tag: str, attrs: list[tuple[str, str | None]]) -> None:
+        self.handle_starttag(tag, attrs)
+
+
+def _relative_luminance(rgb: tuple[float, float, float]) -> float:
+    def chan(c: float) -> float:
+        c = c / 255.0
+        return c / 12.92 if c <= 0.03928 else ((c + 0.055) / 1.055) ** 2.4
+
+    r, g, b = (chan(x) for x in rgb)
+    return 0.2126 * r + 0.7152 * g + 0.0722 * b
+
+
+def contrast_ratio(fg: tuple[float, float, float], bg: tuple[float, float, float]) -> float:
+    l1 = _relative_luminance(fg)
+    l2 = _relative_luminance(bg)
+    lighter, darker = max(l1, l2), min(l1, l2)
+    return (lighter + 0.05) / (darker + 0.05)
+
+
+def parse_css_color(value: str) -> tuple[float, float, float] | None:
+    value = (value or "").strip().lower()
+    m = re.match(r"rgba?\(\s*([\d.]+)\s*,\s*([\d.]+)\s*,\s*([\d.]+)", value)
+    if m:
+        return float(m.group(1)), float(m.group(2)), float(m.group(3))
+    m = re.match(r"#([0-9a-f]{3}|[0-9a-f]{6})$", value)
+    if m:
+        h = m.group(1)
+        if len(h) == 3:
+            h = "".join(ch * 2 for ch in h)
+        return int(h[0:2], 16), int(h[2:4], 16), int(h[4:6], 16)
+    return None
+
+
+def analyze_static(rel: str, html: str) -> dict[str, Any]:
+    parser = DepthParser()
+    parser.feed(html)
+    issues: list[str] = []
+    if not parser.lang:
+        issues.append("missing html lang")
+    if parser.landmarks < 1:
+        issues.append("no landmarks detected")
+    if not parser.headings:
+        issues.append("no headings")
+    counts = Counter(parser.ids)
+    dupes = sorted(i for i, n in counts.items() if n > 1)
+    if dupes:
+        issues.append(f"duplicate ids: {', '.join(dupes[:8])}")
+    id_set = set(parser.ids)
+    for tag, attr, value in parser.aria_attrs:
+        for ref in re.split(r"\s+", value.strip()):
+            if ref and ref not in id_set:
+                issues.append(f"invalid {attr} '{ref}' on <{tag}>")
+    # Positive tabindex often disrupts natural order.
+    positive_tab = [f"{t}:{v}" for t, v in parser.tabindex_values if v.isdigit() and int(v) > 0]
+    if positive_tab:
+        issues.append(f"positive tabindex: {', '.join(positive_tab[:6])}")
+    # Product waitlist pages should expose a live status region.
+    if rel.startswith("products/") and "data-waitlist" in html:
+        if not parser.live_regions:
+            issues.append("waitlist page missing aria-live/status region")
+        if 'tabindex="-1"' not in html:
+            issues.append("waitlist status missing tabindex=-1")
+    return {
+        "path": rel,
+        "ok": not issues,
+        "issues": issues,
+        "landmark_count": parser.landmarks,
+        "live_region_count": len(parser.live_regions),
+        "duplicate_ids": dupes,
+        "heading_levels": parser.headings[:20],
+        "roles_sample": parser.roles[:20],
+    }
+
+
+def run_live_depth(site: Path) -> dict[str, Any]:
+    """CDP: focus trap sample, zoom/reflow, contrast proxy on body/main text."""
+    from cdp_client import start_chrome_session, start_loopback_http, stop_process_group
+
+    server = None
+    session = None
+    cases: list[dict[str, Any]] = []
+    try:
+        server, _port, base = start_loopback_http(site)
+        session = start_chrome_session()
+        session.set_viewport(1280, 800, mobile=False)
+        session.navigate(f"{base}/")
+
+        # Focus cycle: Tab up to 16 times; no element should trap (activeElement must change or reach end).
+        session.evaluate(
+            "(() => { const b=document.body; if(b){ b.tabIndex=-1; b.focus(); b.removeAttribute('tabindex'); }})()"
+        )
+        seen: list[str] = []
+        stuck = False
+        streak = 0
+        prev = None
+        for _i in range(16):
+            session.tab()
+            focus = session.evaluate(
+                """(() => {
+                  const ae = document.activeElement;
+                  if (!ae || ae === document.body) return null;
+                  const href = ae.getAttribute && ae.getAttribute('href');
+                  const text = ((ae.textContent || '').trim()).slice(0, 40);
+                  return [
+                    ae.tagName || '',
+                    ae.id || '',
+                    ((typeof ae.className === 'string' ? ae.className : '') || '').slice(0, 40),
+                    href || '',
+                    text,
+                  ].join('|');
+                })()"""
+            )
+            key = focus or "body"
+            seen.append(key)
+            if prev is not None and key == prev:
+                streak += 1
+                # Same exact control after 3 consecutive Tabs ⇒ likely trap.
+                if streak >= 3:
+                    stuck = True
+                    break
+            else:
+                streak = 0
+            prev = key
+        cases.append(
+            {
+                "name": "home.tab_cycle_no_obvious_trap",
+                "ok": not stuck,
+                "detail": {"seen": seen[:16], "stuck": stuck},
+            }
+        )
+
+        # Text zoom / reflow proxy via CSS zoom emulation on documentElement.
+        zoom = session.evaluate(
+            """(() => {
+              const html = document.documentElement;
+              const before = {sw: document.body.scrollWidth, iw: window.innerWidth};
+              html.style.zoom = '200%';
+              const after = {
+                sw: document.body.scrollWidth,
+                iw: window.innerWidth,
+                overflowX: document.body.scrollWidth > window.innerWidth + 40,
+                main: !!(document.getElementById('main') || document.querySelector('main')),
+              };
+              html.style.zoom = '';
+              return {before, after};
+            })()"""
+        )
+        # Soft check: main still present after zoom; severe overflow flagged but not hard-fail if theme xp grows.
+        zoom_ok = bool(zoom and zoom.get("after", {}).get("main"))
+        cases.append({"name": "home.zoom_200_main_present", "ok": zoom_ok, "detail": zoom})
+
+        # Narrow viewport reflow
+        session.set_viewport(320, 568, mobile=True)
+        session.navigate(f"{base}/products/mala/", settle_ms=700)
+        narrow = session.evaluate(
+            """(() => {
+              const main = document.querySelector('main');
+              const overflowX = Math.max(document.body.scrollWidth, document.documentElement.scrollWidth) > window.innerWidth + 2;
+              return {
+                hasMain: !!main,
+                overflowX,
+                iw: window.innerWidth,
+                sw: Math.max(document.body.scrollWidth, document.documentElement.scrollWidth),
+              };
+            })()"""
+        )
+        cases.append(
+            {
+                "name": "product.narrow_320_main",
+                "ok": bool(narrow and narrow.get("hasMain")),
+                "detail": narrow,
+            }
+        )
+
+        # Contrast proxy: body text vs body background (deterministic compute).
+        session.set_viewport(1280, 800, mobile=False)
+        session.navigate(f"{base}/", settle_ms=600)
+        colors = session.evaluate(
+            """(() => {
+              const body = document.body;
+              const main = document.querySelector('main') || body;
+              const probe = main.querySelector('p, li, a, h1, h2') || main;
+              const cs = getComputedStyle(probe);
+              const bs = getComputedStyle(body);
+              return {color: cs.color, background: bs.backgroundColor, probe: probe.tagName};
+            })()"""
+        )
+        ratio = None
+        contrast_ok = False
+        if colors:
+            fg = parse_css_color(colors.get("color") or "")
+            bg = parse_css_color(colors.get("background") or "")
+            if fg and bg:
+                ratio = contrast_ratio(fg, bg)
+                # WCAG AA body text proxy >= 4.5; allow soft fail recording if theme uses light-on-light xp overlay.
+                contrast_ok = ratio >= 3.0  # floor for non-certification local signal
+        cases.append(
+            {
+                "name": "home.contrast_proxy_body_text",
+                "ok": contrast_ok,
+                "detail": {"colors": colors, "ratio": ratio, "threshold": 3.0, "note": "proxy only; not certification"},
+            }
+        )
+
+        # Reduced motion: keyboard still reaches skip
+        session.call(
+            "Emulation.setEmulatedMedia",
+            {"features": [{"name": "prefers-reduced-motion", "value": "reduce"}]},
+        )
+        session.navigate(f"{base}/")
+        session.evaluate(
+            "(() => { const b=document.body; if(b){ b.tabIndex=-1; b.focus(); b.removeAttribute('tabindex'); }})()"
+        )
+        session.tab()
+        focus = session.evaluate(
+            """(() => {
+              const ae = document.activeElement;
+              return ae && typeof ae.className === 'string' && ae.className.includes('skip');
+            })()"""
+        )
+        cases.append({"name": "home.reduced_motion_skip_first_tab", "ok": bool(focus), "detail": {"skip": focus}})
+        session.call(
+            "Emulation.setEmulatedMedia",
+            {"features": [{"name": "prefers-reduced-motion", "value": ""}]},
+        )
+
+        return {
+            "ok": all(c["ok"] for c in cases),
+            "cases": cases,
+            "boundary": "Local CDP a11y depth signals; NOT VoiceOver/AT certification.",
+        }
+    finally:
+        if session is not None:
+            session.close()
+        if server is not None:
+            stop_process_group(server)
+
+
+def list_site_html(site: Path) -> list[str]:
+    return sorted(str(p.relative_to(site)).replace("\\", "/") for p in site.rglob("*.html"))
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--site", type=Path, default=SITE)
+    parser.add_argument("--evidence", type=Path, default=DEFAULT_EVIDENCE)
+    parser.add_argument("--skip-live", action="store_true")
+    args = parser.parse_args()
+
+    if not args.site.is_dir():
+        print(f"site missing: {args.site}", file=sys.stderr)
+        return 2
+
+    args.evidence.mkdir(parents=True, exist_ok=True)
+    pages = []
+    for rel in INTERACTIVE_HTML:
+        path = args.site / rel
+        if not path.is_file():
+            pages.append({"path": rel, "ok": False, "issues": ["file missing"]})
+            continue
+        pages.append(analyze_static(rel, path.read_text(encoding="utf-8")))
+
+    live = None
+    if not args.skip_live:
+        try:
+            live = run_live_depth(args.site)
+        except Exception as exc:  # noqa: BLE001
+            live = {"ok": False, "error": str(exc)}
+
+    failed = [p["path"] for p in pages if not p["ok"]]
+    summary = {
+        "schema": "priyanshchordia.a11y_depth.v1",
+        "started_at": datetime.now(timezone.utc).isoformat(),
+        "finished_at": datetime.now(timezone.utc).isoformat(),
+        "boundary": (
+            "Semantic + CDP depth signals (contrast proxy, zoom, narrow viewport, trap sample). "
+            "Not VoiceOver or formal accessibility certification."
+        ),
+        "pages": pages,
+        "failed_pages": failed,
+        "live": live,
+        "ok": not failed and (live is None or live.get("ok")),
+    }
+    out = args.evidence / "a11y_depth_summary.json"
+    out.write_text(json.dumps(summary, indent=2) + "\n", encoding="utf-8")
+    print(
+        json.dumps(
+            {
+                "ok": summary["ok"],
+                "failed_pages": failed,
+                "live_ok": None if live is None else live.get("ok"),
+                "summary": str(out),
+            },
+            indent=2,
+        )
+    )
+    return 0 if summary["ok"] else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
