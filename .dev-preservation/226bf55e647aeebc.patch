+#!/usr/bin/env python3
+"""Deterministic visual/responsive regression manifest (C2 Lane 3).
+
+Builds a reviewable manifest from screenshots with viewport, route, dimensions,
+hashes, and explicit tolerances. Detects blank pages, horizontal overflow, and
+missing primary content via robust DOM/layout signals — not brittle pixels.
+"""
+
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import sys
+from datetime import datetime, timezone
+from pathlib import Path
+from typing import Any
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT / "scripts"))
+
+from cdp_client import start_chrome_session, start_loopback_http, stop_process_group  # noqa: E402
+
+SITE = ROOT / "site"
+DEFAULT_EVIDENCE = ROOT / "session-c2-evidence" / "visual"
+
+ROUTES = [
+    "/",
+    "/products/mala/",
+    "/apps/",
+    "/journal/",
+    "/404.html",
+]
+
+VIEWPORTS = [
+    ("desktop", 1280, 800, False),
+    ("mobile", 375, 812, True),
+]
+
+
+def sha256_file(path: Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as handle:
+        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+def capture(session, base: str, path: str, name: str, width: int, height: int, mobile: bool, out_dir: Path) -> dict[str, Any]:
+    session.set_viewport(width, height, mobile=mobile)
+    session.navigate(base + path, settle_ms=900)
+    signals = session.evaluate(
+        """(() => {
+          const pageMain = document.getElementById('main');
+          const xpMain = document.getElementById('xp-main') || document.querySelector('#xp main');
+          const main = (xpMain && !xpMain.hidden) ? xpMain
+            : (pageMain && !pageMain.hidden) ? pageMain
+            : (document.querySelector('main:not([hidden])') || pageMain || xpMain);
+          const body = document.body;
+          const html = document.documentElement;
+          const overflowX = Math.max(body.scrollWidth, html.scrollWidth) > (window.innerWidth + 1);
+          const mainRect = main ? main.getBoundingClientRect() : null;
+          const textLen = (main && (main.innerText || '').trim().length) || 0;
+          const bg = getComputedStyle(body).backgroundColor;
+          const brokenImages = Array.from(document.images).filter(img => img.complete && img.naturalWidth === 0).map(img => img.src);
+          const hasXp = html.classList.contains('has-xp');
+          return {
+            title: document.title || '',
+            readyState: document.readyState,
+            theme: html.getAttribute('data-theme'),
+            hasMain: !!main,
+            hasXp,
+            mainId: main && main.id,
+            mainTextLen: textLen,
+            overflowX,
+            viewport: {w: window.innerWidth, h: window.innerHeight},
+            scroll: {w: Math.max(body.scrollWidth, html.scrollWidth), h: Math.max(body.scrollHeight, html.scrollHeight)},
+            mainRect: mainRect ? {x: mainRect.x, y: mainRect.y, w: mainRect.width, h: mainRect.height} : null,
+            backgroundColor: bg,
+            brokenImages,
+            fontFamily: getComputedStyle(body).fontFamily,
+          };
+        })()"""
+    )
+    # Screenshot via CDP (bounded; one per route/viewport).
+    slug = path.strip("/").replace("/", "_") or "home"
+    png_path = out_dir / f"{slug}__{name}.png"
+    shot = session.call("Page.captureScreenshot", {"format": "png", "fromSurface": True})
+    import base64
+
+    png_path.write_bytes(base64.b64decode(shot["data"]))
+    png_hash = sha256_file(png_path)
+    png_size = png_path.stat().st_size
+
+    blank = False
+    clipped = False
+    errors: list[str] = []
+    if not signals or not signals.get("hasMain"):
+        # 404 page still has main in this generator; flag if missing.
+        if path != "/404.html":
+            errors.append("missing_main")
+            blank = True
+    if signals and signals.get("mainTextLen", 0) < 20:
+        errors.append("primary_content_too_short")
+        blank = True
+    if signals and signals.get("overflowX"):
+        errors.append("horizontal_overflow")
+    if signals and signals.get("brokenImages"):
+        errors.append("broken_images")
+    if png_size < 1500:
+        errors.append("screenshot_suspiciously_small")
+        blank = True
+    if signals and signals.get("mainRect"):
+        mr = signals["mainRect"]
+        if mr["h"] < 40 or mr["w"] < 40:
+            clipped = True
+            errors.append("main_rect_tiny")
+
+    return {
+        "route": path,
+        "viewport": name,
+        "width": width,
+        "height": height,
+        "mobile": mobile,
+        "dom_state": {
+            "title": (signals or {}).get("title"),
+            "theme": (signals or {}).get("theme"),
+            "readyState": (signals or {}).get("readyState"),
+            "mainTextLen": (signals or {}).get("mainTextLen"),
+        },
+        "layout_signals": {
+            "overflowX": (signals or {}).get("overflowX"),
+            "scroll": (signals or {}).get("scroll"),
+            "mainRect": (signals or {}).get("mainRect"),
+            "backgroundColor": (signals or {}).get("backgroundColor"),
+            "fontFamily": (signals or {}).get("fontFamily"),
+            "brokenImages": (signals or {}).get("brokenImages"),
+        },
+        "screenshot": {
+            "path": str(png_path.relative_to(ROOT)) if png_path.is_relative_to(ROOT) else str(png_path),
+            "bytes": png_size,
+            "sha256": png_hash,
+        },
+        "blank_suspected": blank,
+        "clipped_suspected": clipped,
+        "errors": errors,
+        "ok": not errors,
+    }
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--site", type=Path, default=SITE)
+    parser.add_argument("--evidence", type=Path, default=DEFAULT_EVIDENCE)
+    parser.add_argument("--port", type=int, default=0)
+    args = parser.parse_args()
+
+    args.evidence.mkdir(parents=True, exist_ok=True)
+    shots_dir = args.evidence / "shots"
+    shots_dir.mkdir(parents=True, exist_ok=True)
+
+    server = None
+    session = None
+    entries: list[dict[str, Any]] = []
+    try:
+        server, port, base = start_loopback_http(args.site, args.port or None)
+        session = start_chrome_session()
+        for path in ROUTES:
+            for name, w, h, mobile in VIEWPORTS:
+                entries.append(capture(session, base, path, name, w, h, mobile, shots_dir))
+    finally:
+        if session is not None:
+            session.close()
+        if server is not None:
+            stop_process_group(server)
+
+    failed = [e for e in entries if not e["ok"]]
+    manifest = {
+        "schema": "priyanshchordia.visual_manifest.v1",
+        "started_at": datetime.now(timezone.utc).isoformat(),
+        "site": str(args.site),
+        "tolerances": {
+            "pixel_diff": "not_enforced",
+            "reason": (
+                "OS/font/antialias variance makes pixel-perfect asserts brittle. "
+                "This manifest proves DOM presence, overflow, blank/clip heuristics, and screenshot hashes."
+            ),
+            "overflow_slack_px": 1,
+            "min_main_text_chars": 20,
+            "min_screenshot_bytes": 1500,
+        },
+        "limitations": [
+            "Not a cross-machine visual CI golden suite.",
+            "Font substitution may change pixels without failing layout signals.",
+            "Console error capture is limited to broken image naturalWidth heuristic.",
+        ],
+        "entries": entries,
+        "ok": not failed,
+        "failed_routes": [f"{e['route']}@{e['viewport']}" for e in failed],
+    }
+    out = args.evidence / "visual_manifest.json"
+    out.write_text(json.dumps(manifest, indent=2) + "\n", encoding="utf-8")
+    # Keep evidence bounded: do not dump HTML.
+    print(json.dumps({"ok": manifest["ok"], "failed": manifest["failed_routes"], "manifest": str(out)}, indent=2))
+    return 0 if manifest["ok"] else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
