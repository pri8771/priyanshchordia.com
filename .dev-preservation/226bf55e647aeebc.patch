+"""Privacy, secrets, and client robustness contracts (Lane 3)."""
+
+from __future__ import annotations
+
+import re
+import subprocess
+import tempfile
+import unittest
+from pathlib import Path
+
+
+ROOT = Path(__file__).resolve().parents[1]
+SITE = ROOT / "site"
+SCRIPTS = ROOT / "scripts"
+
+
+SECRETISH = re.compile(
+    r"(?i)("
+    r"api[_-]?key\s*[:=]\s*['\"][^'\"]{8,}"
+    r"|secret\s*[:=]\s*['\"][^'\"]{8,}"
+    r"|password\s*[:=]\s*['\"][^'\"]+"
+    r"|BEGIN (RSA |OPENSSH |EC )?PRIVATE KEY"
+    r"|sk_live_[A-Za-z0-9]+"
+    r"|AKIA[0-9A-Z]{16}"
+    r")"
+)
+
+TRACKERISH = re.compile(
+    r"(?i)("
+    r"google-analytics\.com|googletagmanager\.com|gtag\("
+    r"|facebook\.net|connect\.facebook\.com"
+    r"|hotjar\.com|segment\.(io|com)|mixpanel\.com"
+    r"|fullstory\.com|amplitude\.com"
+    r")"
+)
+
+
+class PrivacyScanTests(unittest.TestCase):
+    def test_generated_and_source_have_no_secret_or_tracker_patterns(self) -> None:
+        roots = [SITE, SCRIPTS, ROOT / "data"]
+        hits: list[str] = []
+        for root in roots:
+            for path in root.rglob("*"):
+                if not path.is_file():
+                    continue
+                if path.suffix.lower() in {".png", ".jpg", ".jpeg", ".webp", ".gif", ".ico", ".pyc"}:
+                    continue
+                try:
+                    text = path.read_text(encoding="utf-8")
+                except UnicodeDecodeError:
+                    continue
+                if SECRETISH.search(text):
+                    hits.append(f"secretish:{path.relative_to(ROOT)}")
+                if TRACKERISH.search(text):
+                    hits.append(f"tracker:{path.relative_to(ROOT)}")
+        self.assertEqual(hits, [], f"privacy scan hits: {hits}")
+
+    def test_no_javascript_source_maps_in_site(self) -> None:
+        maps = list(SITE.rglob("*.map"))
+        self.assertEqual(maps, [])
+        for js in SITE.rglob("*.js"):
+            text = js.read_text(encoding="utf-8")
+            self.assertNotIn("sourceMappingURL=", text)
+
+
+class RobustnessContractTests(unittest.TestCase):
+    def test_waitlist_never_claims_success_and_always_prevents_default(self) -> None:
+        source = (SCRIPTS / "waitlist.js").read_text(encoding="utf-8")
+        self.assertIn("event.preventDefault()", source)
+        self.assertIn("signup form is unavailable", source.lower())
+        lowered = source.lower()
+        for phrase in ("you're on the list", "successfully signed", "thanks for joining", "submission received"):
+            self.assertNotIn(phrase, lowered)
+
+    def test_app_themes_tolerates_storage_disabled_and_malformed_url(self) -> None:
+        source = (SCRIPTS / "app-themes.js").read_text(encoding="utf-8")
+        self.assertIn("try { localStorage.setItem", source)
+        self.assertIn("catch (error)", source)
+        self.assertIn("try { initial = new URL", source)
+        self.assertIn("isAllowed", source)
+
+    def test_experiences_guard_missing_host_and_empty_products(self) -> None:
+        common = (SCRIPTS / "experiences" / "common.js").read_text(encoding="utf-8")
+        self.assertIn("if (!products.length) return;", common)
+        self.assertIn("if (!host) return;", common)
+
+    def test_js_syntax_of_site_bundles(self) -> None:
+        for name in ("experiences.js", "app-themes.js", "waitlist.js"):
+            path = SITE / name
+            result = subprocess.run(
+                ["node", "--check", str(path)],
+                capture_output=True,
+                text=True,
+                check=False,
+            )
+            self.assertEqual(result.returncode, 0, result.stderr)
+
+    def test_theme_switching_contract_rejects_unknown_design_param(self) -> None:
+        """Executable contract: unknown ?design= falls back to first allowed."""
+        script = r"""
+const fs = require('fs');
+const path = require('path');
+const vm = require('vm');
+const src = fs.readFileSync(path.resolve('scripts/app-themes.js'), 'utf8');
+
+function run(href, storageValue) {
+  const scenes = [
+    { getAttribute: (n) => n === 'data-app-scene' ? 'mala-01' : null, hidden: false },
+    { getAttribute: (n) => n === 'data-app-scene' ? 'mala-02' : null, hidden: false },
+    { getAttribute: (n) => n === 'data-app-scene' ? 'mala-03' : null, hidden: false },
+  ];
+  const options = [
+    { value: 'mala-01', getAttribute: () => 'p1' },
+    { value: 'mala-02', getAttribute: () => 'p2' },
+    { value: 'mala-03', getAttribute: () => 'p3' },
+  ];
+  const picker = {
+    options,
+    value: 'mala-01',
+    selectedIndex: 0,
+    addEventListener() {},
+  };
+  Object.defineProperty(picker, 'selectedIndex', {
+    get() { return options.findIndex((o) => o.value === picker.value); },
+  });
+  const description = { textContent: '' };
+  const root = {
+    attrs: { 'data-app': 'mala', 'data-app-theme': '' },
+    getAttribute(name) { return this.attrs[name] || null; },
+    setAttribute(name, value) { this.attrs[name] = value; },
+    querySelector(sel) {
+      if (sel === '[data-app-theme-picker]') return picker;
+      if (sel === '[data-app-theme-description]') return description;
+      return null;
+    },
+    querySelectorAll(sel) {
+      if (sel === '[data-app-scene]') return scenes;
+      return [];
+    },
+  };
+  const storage = {
+    data: storageValue ? { 'pc-app-theme-mala': storageValue } : {},
+    getItem(k) { if (this.fail) throw new Error('denied'); return this.data[k] || null; },
+    setItem(k, v) { if (this.fail) throw new Error('denied'); this.data[k] = String(v); },
+  };
+  const sandbox = {
+    document: { querySelector: (sel) => sel === '[data-app-landing]' ? root : null },
+    window: {
+      location: { href },
+      history: { replaceState() {} },
+      URL,
+    },
+    localStorage: storage,
+  };
+  vm.runInNewContext(src, sandbox);
+  return root.attrs['data-app-theme'];
+}
+
+const a = run('https://priyanshchordia.com/products/mala/?design=not-real', null);
+if (a !== 'mala-01') { console.error('expected fallback mala-01 got', a); process.exit(1); }
+const storage = { fail: true };
+// storage-disabled path: craft via throwing localStorage
+function runStorageDenied() {
+  const scenes = [
+    { getAttribute: (n) => n === 'data-app-scene' ? 'mala-01' : null, hidden: false },
+    { getAttribute: (n) => n === 'data-app-scene' ? 'mala-02' : null, hidden: false },
+    { getAttribute: (n) => n === 'data-app-scene' ? 'mala-03' : null, hidden: false },
+  ];
+  const options = [
+    { value: 'mala-01', getAttribute: () => 'p1' },
+    { value: 'mala-02', getAttribute: () => 'p2' },
+    { value: 'mala-03', getAttribute: () => 'p3' },
+  ];
+  const picker = { options, value: 'mala-01', addEventListener() {} };
+  Object.defineProperty(picker, 'selectedIndex', {
+    get() { return options.findIndex((o) => o.value === picker.value); },
+  });
+  const description = { textContent: '' };
+  const root = {
+    attrs: { 'data-app': 'mala', 'data-app-theme': '' },
+    getAttribute(name) { return this.attrs[name] || null; },
+    setAttribute(name, value) { this.attrs[name] = value; },
+    querySelector(sel) {
+      if (sel === '[data-app-theme-picker]') return picker;
+      if (sel === '[data-app-theme-description]') return description;
+      return null;
+    },
+    querySelectorAll(sel) { return sel === '[data-app-scene]' ? scenes : []; },
+  };
+  const denied = {
+    getItem() { throw new Error('denied'); },
+    setItem() { throw new Error('denied'); },
+  };
+  require('vm').runInNewContext(require('fs').readFileSync('scripts/app-themes.js','utf8'), {
+    document: { querySelector: (sel) => sel === '[data-app-landing]' ? root : null },
+    window: { location: { href: 'https://priyanshchordia.com/products/mala/' }, history: { replaceState() {} }, URL },
+    localStorage: denied,
+  });
+  return root.attrs['data-app-theme'];
+}
+const b = runStorageDenied();
+if (b !== 'mala-01') { console.error('storage-denied expected mala-01 got', b); process.exit(1); }
+console.log('ok');
+"""
+        with tempfile.NamedTemporaryFile("w", suffix=".cjs", delete=False, encoding="utf-8") as handle:
+            handle.write(script)
+            path = Path(handle.name)
+        try:
+            result = subprocess.run(
+                ["node", str(path)],
+                cwd=str(ROOT),
+                capture_output=True,
+                text=True,
+                check=False,
+            )
+            self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
+        finally:
+            path.unlink(missing_ok=True)
+
+
+if __name__ == "__main__":
+    unittest.main()
