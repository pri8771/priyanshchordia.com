+"""SEO metadata harness contracts (C4 Lane 7) — markup validation only."""
+
+from __future__ import annotations
+
+import importlib.util
+import json
+import shutil
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+
+
+ROOT = Path(__file__).resolve().parents[1]
+
+MINIMAL_HEAD = """<!DOCTYPE html>
+<html lang="en"><head><meta charset="utf-8">
+<meta name="viewport" content="width=device-width,initial-scale=1">
+<meta name="description" content="Fixture page">
+<meta name="robots" content="index,follow">
+<meta name="twitter:card" content="summary">
+<meta name="twitter:image" content="https://priyanshchordia.com/og.png">
+<meta name="twitter:image:alt" content="alt">
+<meta property="og:type" content="website">
+<meta property="og:title" content="Fixture">
+<meta property="og:description" content="Fixture page">
+<meta property="og:url" content="CANONICAL">
+<meta property="og:image" content="https://priyanshchordia.com/og.png">
+<meta property="og:image:width" content="1200">
+<meta property="og:image:height" content="630">
+<meta property="og:image:alt" content="alt">
+<link rel="canonical" href="CANONICAL">
+<title>TITLE</title></head>"""
+
+
+def load_seo_harness():
+    spec = importlib.util.spec_from_file_location(
+        "seo_metadata_harness", ROOT / "scripts" / "seo_metadata_harness.py"
+    )
+    assert spec and spec.loader
+    mod = importlib.util.module_from_spec(spec)
+    sys.modules["seo_metadata_harness"] = mod
+    spec.loader.exec_module(mod)
+    return mod
+
+
+def _page(
+    canonical: str,
+    title: str,
+    body: str,
+    *,
+    lang: str = "en",
+    description: str = "Fixture page",
+    robots: str = "index,follow",
+    extra_head: str = "",
+) -> str:
+    head = (
+        MINIMAL_HEAD.replace("CANONICAL", canonical)
+        .replace("TITLE", title)
+        .replace('lang="en"', f'lang="{lang}"')
+        .replace('content="Fixture page"', f'content="{description}"', 1)
+        .replace('content="index,follow"', f'content="{robots}"', 1)
+    )
+    return (
+        f"{head}{extra_head}<body><main id=\"main\"><h1>{title}</h1>{body}</main></body></html>"
+    )
+
+
+class SeoMetadataFixtureTests(unittest.TestCase):
+    def setUp(self) -> None:
+        self.tmp = Path(tempfile.mkdtemp(prefix="pch-c4-seo-"))
+        self.site = self.tmp / "site"
+        self.site.mkdir()
+        self.seo = load_seo_harness()
+        (self.site / "index.html").write_text(
+            _page("https://priyanshchordia.com/", "Home", "<p>hi</p>"),
+            encoding="utf-8",
+        )
+        (self.site / "404.html").write_text(
+            _page(
+                "https://priyanshchordia.com/404.html",
+                "Missing",
+                "<p>lost</p>",
+                robots="noindex,follow",
+            ),
+            encoding="utf-8",
+        )
+        (self.site / "robots.txt").write_text(
+            "User-agent: *\nAllow: /\nSitemap: https://priyanshchordia.com/sitemap.xml\n",
+            encoding="utf-8",
+        )
+        self._write_sitemap(["https://priyanshchordia.com/"])
+
+    def tearDown(self) -> None:
+        shutil.rmtree(self.tmp, ignore_errors=True)
+
+    def _write_sitemap(self, locs: list[str]) -> None:
+        urls = "".join(f"<url><loc>{loc}</loc></url>" for loc in locs)
+        (self.site / "sitemap.xml").write_text(
+            '<?xml version="1.0" encoding="UTF-8"?>'
+            f'<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">{urls}</urlset>',
+            encoding="utf-8",
+        )
+
+    def test_clean_fixture_passes(self) -> None:
+        summary = self.seo.run(self.site)
+        self.assertTrue(summary["ok"], summary["errors"])
+
+    def test_missing_html_lang_fails(self) -> None:
+        bad = _page("https://priyanshchordia.com/", "Home", "<p>hi</p>", lang="")
+        bad = bad.replace('lang=""', "", 1)
+        (self.site / "index.html").write_text(bad, encoding="utf-8")
+        summary = self.seo.run(self.site)
+        self.assertFalse(summary["ok"])
+        self.assertTrue(any("lang" in err for err in summary["errors"]))
+
+    def test_duplicate_title_tags_fail(self) -> None:
+        html = _page("https://priyanshchordia.com/", "Home", "<p>hi</p>")
+        html = html.replace("</title>", "</title><title>Duplicate</title>", 1)
+        (self.site / "index.html").write_text(html, encoding="utf-8")
+        summary = self.seo.run(self.site)
+        self.assertFalse(summary["ok"])
+        self.assertTrue(any("title tag" in err for err in summary["errors"]))
+
+    def test_duplicate_canonical_links_fail(self) -> None:
+        html = _page("https://priyanshchordia.com/", "Home", "<p>hi</p>")
+        html = html.replace(
+            "</head>",
+            '<link rel="canonical" href="https://priyanshchordia.com/extra/">'
+            "</head>",
+            1,
+        )
+        (self.site / "index.html").write_text(html, encoding="utf-8")
+        summary = self.seo.run(self.site)
+        self.assertFalse(summary["ok"])
+        self.assertTrue(any("canonical" in err for err in summary["errors"]))
+
+    def test_og_url_must_match_canonical(self) -> None:
+        html = _page("https://priyanshchordia.com/", "Home", "<p>hi</p>")
+        html = html.replace(
+            'property="og:url" content="https://priyanshchordia.com/"',
+            'property="og:url" content="https://priyanshchordia.com/wrong/"',
+            1,
+        )
+        (self.site / "index.html").write_text(html, encoding="utf-8")
+        summary = self.seo.run(self.site)
+        self.assertFalse(summary["ok"])
+        self.assertTrue(any("og:url" in err for err in summary["errors"]))
+
+    def test_not_found_must_be_noindex(self) -> None:
+        (self.site / "404.html").write_text(
+            _page("https://priyanshchordia.com/404.html", "Missing", "<p>lost</p>"),
+            encoding="utf-8",
+        )
+        summary = self.seo.run(self.site)
+        self.assertFalse(summary["ok"])
+        self.assertTrue(any("noindex" in err for err in summary["errors"]))
+
+    def test_missing_og_image_on_indexable_fails(self) -> None:
+        html = _page("https://priyanshchordia.com/", "Home", "<p>hi</p>")
+        html = html.replace('<meta property="og:image" content="https://priyanshchordia.com/og.png">', "")
+        (self.site / "index.html").write_text(html, encoding="utf-8")
+        summary = self.seo.run(self.site)
+        self.assertFalse(summary["ok"])
+        self.assertTrue(any("og:image" in err for err in summary["errors"]))
+
+    def test_invalid_json_ld_fails(self) -> None:
+        html = _page(
+            "https://priyanshchordia.com/",
+            "Home",
+            "<p>hi</p>",
+            extra_head='<script type="application/ld+json">{not json</script>',
+        )
+        (self.site / "index.html").write_text(html, encoding="utf-8")
+        summary = self.seo.run(self.site)
+        self.assertFalse(summary["ok"])
+        self.assertTrue(any("JSON-LD" in err for err in summary["errors"]))
+
+    def test_json_ld_url_must_match_canonical(self) -> None:
+        payload = json.dumps(
+            {
+                "@context": "https://schema.org",
+                "@type": "WebSite",
+                "name": "priyanshchordia.com",
+                "url": "https://priyanshchordia.com/wrong/",
+            }
+        )
+        html = _page(
+            "https://priyanshchordia.com/",
+            "Home",
+            "<p>hi</p>",
+            extra_head=f'<script type="application/ld+json">{payload}</script>',
+        )
+        (self.site / "index.html").write_text(html, encoding="utf-8")
+        summary = self.seo.run(self.site)
+        self.assertFalse(summary["ok"])
+        self.assertTrue(any("does not match canonical" in err for err in summary["errors"]))
+
+    def test_duplicate_sitemap_loc_fails(self) -> None:
+        self._write_sitemap(
+            ["https://priyanshchordia.com/", "https://priyanshchordia.com/"]
+        )
+        summary = self.seo.run(self.site)
+        self.assertFalse(summary["ok"])
+        self.assertTrue(any("duplicate loc" in err for err in summary["errors"]))
+
+    def test_robots_must_reference_sitemap(self) -> None:
+        (self.site / "robots.txt").write_text("User-agent: *\nAllow: /\n", encoding="utf-8")
+        summary = self.seo.run(self.site)
+        self.assertFalse(summary["ok"])
+        self.assertTrue(any("sitemap" in err.lower() for err in summary["errors"]))
+
+    def test_site_wide_duplicate_titles_fail(self) -> None:
+        other = self.site / "journal" / "index.html"
+        other.parent.mkdir(parents=True)
+        other.write_text(
+            _page("https://priyanshchordia.com/journal/", "Home", "<p>journal</p>"),
+            encoding="utf-8",
+        )
+        self._write_sitemap(
+            ["https://priyanshchordia.com/", "https://priyanshchordia.com/journal/"]
+        )
+        summary = self.seo.run(self.site)
+        self.assertFalse(summary["ok"])
+        self.assertTrue(any("duplicate indexable title" in err for err in summary["errors"]))
+
+
+class SeoMetadataLiveSiteTests(unittest.TestCase):
+    def test_generated_site_passes_seo_harness(self) -> None:
+        seo = load_seo_harness()
+        site = ROOT / "site"
+        if not site.is_dir():
+            self.skipTest("site/ not present")
+        summary = seo.run(site)
+        self.assertTrue(summary["ok"], summary["errors"])
+
+    def test_home_page_analyze_passes(self) -> None:
+        seo = load_seo_harness()
+        html = (ROOT / "site" / "index.html").read_text(encoding="utf-8")
+        result = seo.analyze_page("index.html", html)
+        self.assertTrue(result["ok"], result.get("issues"))
+        self.assertTrue(result["lang"])
+        self.assertEqual(result["canonical"], "https://priyanshchordia.com/")
+
+    def test_product_page_json_ld_present(self) -> None:
+        seo = load_seo_harness()
+        html = (ROOT / "site" / "products" / "mala" / "index.html").read_text(encoding="utf-8")
+        result = seo.analyze_page("products/mala/index.html", html)
+        self.assertTrue(result["ok"], result.get("issues"))
+        self.assertGreaterEqual(result["json_ld_blocks"], 1)
+
+    def test_boundary_states_no_content_invention(self) -> None:
+        source = (ROOT / "scripts" / "seo_metadata_harness.py").read_text(encoding="utf-8")
+        self.assertIn("Does not rewrite markup or invent public claims", source)
+
+
+if __name__ == "__main__":
+    unittest.main()
