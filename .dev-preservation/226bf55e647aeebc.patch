+#!/usr/bin/env python3
+"""Minimal Chrome DevTools Protocol client (stdlib only).
+
+Uses installed Google Chrome with --remote-debugging-port. No Playwright/npm.
+"""
+
+from __future__ import annotations
+
+import base64
+import json
+import os
+import signal
+import socket
+import struct
+import subprocess
+import tempfile
+import time
+import urllib.error
+import urllib.request
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Any
+
+
+# Candidate Chrome/Chromium binaries for macOS + common Linux/CI layouts.
+# Override with PCH_CHROME_PATH (absolute path to the browser binary).
+_CHROME_CANDIDATES = (
+    "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome",
+    "/Applications/Chromium.app/Contents/MacOS/Chromium",
+    "/usr/bin/google-chrome",
+    "/usr/bin/google-chrome-stable",
+    "/usr/bin/chromium",
+    "/usr/bin/chromium-browser",
+    "/usr/lib/chromium/chromium",
+    "/snap/bin/chromium",
+)
+
+
+class ChromeDiscoveryError(FileNotFoundError):
+    """Raised when no usable Chrome/Chromium binary can be resolved."""
+
+
+def discover_chrome(*, override: str | None = None, require: bool = True) -> Path | None:
+    """Resolve Chrome/Chromium with actionable failure output.
+
+    Priority:
+      1. explicit override argument (exclusive — no silent fallback)
+      2. PCH_CHROME_PATH environment variable (exclusive when set)
+      3. first existing candidate on macOS/Linux/CI paths
+    """
+    tried: list[str] = []
+
+    def _try_one(raw: str) -> Path | None:
+        path = Path(raw).expanduser()
+        tried.append(str(path))
+        if path.is_file() and os.access(path, os.X_OK):
+            return path
+        return None
+
+    def _fail() -> Path | None:
+        if not require:
+            return None
+        hint = (
+            "Set PCH_CHROME_PATH to an absolute executable path, e.g.\n"
+            "  export PCH_CHROME_PATH='/Applications/Google Chrome.app/Contents/MacOS/Google Chrome'\n"
+            "  export PCH_CHROME_PATH=/usr/bin/google-chrome-stable\n"
+            "No installs are performed by this harness."
+        )
+        raise ChromeDiscoveryError(
+            "Chrome/Chromium not found.\n"
+            f"Tried: {tried}\n"
+            f"{hint}"
+        )
+
+    if override:
+        found = _try_one(override)
+        return found if found is not None else _fail()
+
+    env = os.environ.get("PCH_CHROME_PATH")
+    if env:
+        found = _try_one(env)
+        return found if found is not None else _fail()
+
+    for raw in _CHROME_CANDIDATES:
+        found = _try_one(raw)
+        if found is not None:
+            return found
+    return _fail()
+
+
+def chrome_discovery_report(*, override: str | None = None) -> dict[str, object]:
+    """Structured report matching discover_chrome resolution rules.
+
+    Explicit override / PCH_CHROME_PATH are exclusive (no silent fallback).
+    """
+    env = os.environ.get("PCH_CHROME_PATH")
+    tried: list[dict[str, object]] = []
+    found = None
+    exclusive = override or env
+    if exclusive:
+        candidates = [exclusive]
+        mode = "override" if override else "env"
+    else:
+        candidates = list(_CHROME_CANDIDATES)
+        mode = "candidates"
+    seen: set[str] = set()
+    for raw in candidates:
+        if not raw or raw in seen:
+            continue
+        seen.add(raw)
+        path = Path(raw).expanduser()
+        exists = path.is_file()
+        executable = bool(exists and os.access(path, os.X_OK))
+        tried.append({"path": str(path), "exists": exists, "executable": executable})
+        if executable and found is None:
+            found = str(path)
+    return {
+        "ok": found is not None,
+        "resolved": found,
+        "override_env": env,
+        "mode": mode,
+        "candidates_tried": tried,
+        "hint": (
+            "Set PCH_CHROME_PATH to an absolute Chrome/Chromium binary path."
+            if found is None
+            else None
+        ),
+    }
+
+
+# Back-compat module attribute: resolved lazily where possible; may be missing.
+try:
+    CHROME = discover_chrome(require=True)
+except ChromeDiscoveryError:
+    CHROME = Path(
+        os.environ.get(
+            "PCH_CHROME_PATH",
+            "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome",
+        )
+    )
+
+
+class WebSocketClient:
+    """Tiny RFC6455 client sufficient for local CDP (text frames, client-masked)."""
+
+    def __init__(self, url: str, timeout: float = 10.0) -> None:
+        if not url.startswith("ws://"):
+            raise ValueError(f"only ws:// supported, got {url!r}")
+        rest = url[5:]
+        host_port, _, path = rest.partition("/")
+        host, _, port_s = host_port.partition(":")
+        port = int(port_s or "80")
+        path = "/" + path
+        self._sock = socket.create_connection((host, port), timeout=timeout)
+        self._sock.settimeout(timeout)
+        key = base64.b64encode(os.urandom(16)).decode("ascii")
+        req = (
+            f"GET {path} HTTP/1.1\r\n"
+            f"Host: {host_port}\r\n"
+            "Upgrade: websocket\r\n"
+            "Connection: Upgrade\r\n"
+            f"Sec-WebSocket-Key: {key}\r\n"
+            "Sec-WebSocket-Version: 13\r\n"
+            "\r\n"
+        )
+        self._sock.sendall(req.encode("ascii"))
+        header = b""
+        while b"\r\n\r\n" not in header:
+            chunk = self._sock.recv(4096)
+            if not chunk:
+                raise RuntimeError("websocket handshake closed")
+            header += chunk
+        status = header.split(b"\r\n", 1)[0]
+        if b"101" not in status:
+            raise RuntimeError(f"websocket handshake failed: {status!r}")
+
+    def send_json(self, obj: dict[str, Any]) -> None:
+        payload = json.dumps(obj, separators=(",", ":")).encode("utf-8")
+        fin_opcode = 0x81
+        mask_bit = 0x80
+        n = len(payload)
+        if n < 126:
+            hdr = bytes([fin_opcode, mask_bit | n])
+        elif n < 65536:
+            hdr = bytes([fin_opcode, mask_bit | 126]) + struct.pack("!H", n)
+        else:
+            hdr = bytes([fin_opcode, mask_bit | 127]) + struct.pack("!Q", n)
+        mask = os.urandom(4)
+        masked = bytes(b ^ mask[i % 4] for i, b in enumerate(payload))
+        self._sock.sendall(hdr + mask + masked)
+
+    def recv_json(self) -> dict[str, Any]:
+        while True:
+            opcode, payload = self._recv_frame()
+            if opcode == 0x8:
+                raise RuntimeError("websocket closed by peer")
+            if opcode == 0x9:  # ping → pong
+                self._send_raw(0xA, payload)
+                continue
+            if opcode == 0xA:  # pong
+                continue
+            if opcode != 0x1:
+                continue
+            return json.loads(payload.decode("utf-8"))
+
+    def _recv_frame(self) -> tuple[int, bytes]:
+        b1, b2 = self._readn(2)
+        opcode = b1 & 0x0F
+        masked = bool(b2 & 0x80)
+        length = b2 & 0x7F
+        if length == 126:
+            length = struct.unpack("!H", self._readn(2))[0]
+        elif length == 127:
+            length = struct.unpack("!Q", self._readn(8))[0]
+        mask = self._readn(4) if masked else b""
+        payload = self._readn(length)
+        if masked:
+            payload = bytes(b ^ mask[i % 4] for i, b in enumerate(payload))
+        return opcode, payload
+
+    def _send_raw(self, opcode: int, payload: bytes) -> None:
+        fin_opcode = 0x80 | (opcode & 0x0F)
+        mask_bit = 0x80
+        n = len(payload)
+        if n < 126:
+            hdr = bytes([fin_opcode, mask_bit | n])
+        elif n < 65536:
+            hdr = bytes([fin_opcode, mask_bit | 126]) + struct.pack("!H", n)
+        else:
+            hdr = bytes([fin_opcode, mask_bit | 127]) + struct.pack("!Q", n)
+        mask = os.urandom(4)
+        masked = bytes(b ^ mask[i % 4] for i, b in enumerate(payload))
+        self._sock.sendall(hdr + mask + masked)
+
+    def _readn(self, n: int) -> bytes:
+        buf = b""
+        while len(buf) < n:
+            chunk = self._sock.recv(n - len(buf))
+            if not chunk:
+                raise RuntimeError("socket closed mid-frame")
+            buf += chunk
+        return buf
+
+    def close(self) -> None:
+        try:
+            self._send_raw(0x8, b"")
+        except OSError:
+            pass
+        try:
+            self._sock.close()
+        except OSError:
+            pass
+
+
+@dataclass
+class ChromeSession:
+    proc: subprocess.Popen[bytes]
+    user_data: Path
+    port: int
+    ws: WebSocketClient
+    session_id: str
+    _next_id: int = 1
+
+    def call(self, method: str, params: dict[str, Any] | None = None, timeout: float = 15.0) -> Any:
+        msg_id = self._next_id
+        self._next_id += 1
+        payload: dict[str, Any] = {
+            "id": msg_id,
+            "sessionId": self.session_id,
+            "method": method,
+        }
+        if params is not None:
+            payload["params"] = params
+        self.ws.send_json(payload)
+        deadline = time.time() + timeout
+        while time.time() < deadline:
+            msg = self.ws.recv_json()
+            if msg.get("id") == msg_id:
+                if "error" in msg:
+                    raise RuntimeError(f"CDP {method} error: {msg['error']}")
+                return msg.get("result")
+        raise TimeoutError(f"CDP {method} timed out")
+
+    def evaluate(self, expression: str, await_promise: bool = False) -> Any:
+        result = self.call(
+            "Runtime.evaluate",
+            {
+                "expression": expression,
+                "returnByValue": True,
+                "awaitPromise": await_promise,
+                "userGesture": True,
+            },
+        )
+        remote = result.get("result") or {}
+        if remote.get("subtype") == "error" or result.get("exceptionDetails"):
+            raise RuntimeError(f"evaluate failed: {result}")
+        return remote.get("value")
+
+    def navigate(self, url: str, settle_ms: int = 800) -> None:
+        self.call("Page.enable")
+        self.call("Page.navigate", {"url": url})
+        # Poll readyState rather than relying on lifecycle events across Chrome builds.
+        deadline = time.time() + 20.0
+        while time.time() < deadline:
+            state = self.evaluate("document.readyState")
+            if state == "complete":
+                break
+            time.sleep(0.05)
+        time.sleep(settle_ms / 1000.0)
+
+    def set_viewport(self, width: int, height: int, mobile: bool = False) -> None:
+        self.call(
+            "Emulation.setDeviceMetricsOverride",
+            {
+                "width": width,
+                "height": height,
+                "deviceScaleFactor": 1,
+                "mobile": mobile,
+            },
+        )
+
+    def key(self, key: str, *, code: str | None = None, modifiers: int = 0, text: str | None = None) -> None:
+        """Dispatch a key press (keydown + keyup). modifiers: Alt=1, Ctrl=2, Meta=4, Shift=8."""
+        code = code or key
+        params_down: dict[str, Any] = {
+            "type": "keyDown",
+            "key": key,
+            "code": code,
+            "modifiers": modifiers,
+            "windowsVirtualKeyCode": _vk(key),
+            "nativeVirtualKeyCode": _vk(key),
+        }
+        if text is not None:
+            params_down["text"] = text
+        self.call("Input.dispatchKeyEvent", params_down)
+        self.call(
+            "Input.dispatchKeyEvent",
+            {
+                "type": "keyUp",
+                "key": key,
+                "code": code,
+                "modifiers": modifiers,
+                "windowsVirtualKeyCode": _vk(key),
+                "nativeVirtualKeyCode": _vk(key),
+            },
+        )
+
+    def tab(self, *, shift: bool = False) -> None:
+        mods = 8 if shift else 0
+        self.key("Tab", code="Tab", modifiers=mods)
+
+    def escape(self) -> None:
+        self.key("Escape", code="Escape")
+
+    def close(self) -> None:
+        try:
+            self.ws.close()
+        except Exception:  # noqa: BLE001
+            pass
+        try:
+            os.killpg(self.proc.pid, signal.SIGTERM)
+            try:
+                self.proc.wait(timeout=5)
+            except subprocess.TimeoutExpired:
+                os.killpg(self.proc.pid, signal.SIGKILL)
+                self.proc.wait(timeout=3)
+        except ProcessLookupError:
+            pass
+        import shutil
+
+        shutil.rmtree(self.user_data, ignore_errors=True)
+
+
+def _vk(key: str) -> int:
+    special = {
+        "Tab": 9,
+        "Enter": 13,
+        "Escape": 27,
+        "ArrowLeft": 37,
+        "ArrowUp": 38,
+        "ArrowRight": 39,
+        "ArrowDown": 40,
+        " ": 32,
+    }
+    if key in special:
+        return special[key]
+    if len(key) == 1:
+        return ord(key.upper())
+    return 0
+
+
+def wait_http(url: str, timeout: float = 15.0) -> None:
+    deadline = time.time() + timeout
+    last: Exception | None = None
+    while time.time() < deadline:
+        try:
+            with urllib.request.urlopen(url, timeout=1) as resp:
+                if 200 <= resp.status < 500:
+                    return
+        except Exception as exc:  # noqa: BLE001
+            last = exc
+            time.sleep(0.05)
+    raise RuntimeError(f"not ready: {url} ({last})")
+
+
+def find_free_port() -> int:
+    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as sock:
+        sock.bind(("127.0.0.1", 0))
+        return int(sock.getsockname()[1])
+
+
+def start_loopback_http(site: Path, port: int | None = None) -> tuple[subprocess.Popen[bytes], int, str]:
+    port = port or find_free_port()
+    server = subprocess.Popen(
+        [os.environ.get("PYTHON", "python3"), "-m", "http.server", str(port), "--bind", "127.0.0.1"],
+        cwd=str(site),
+        stdout=subprocess.DEVNULL,
+        stderr=subprocess.DEVNULL,
+        start_new_session=True,
+    )
+    base = f"http://127.0.0.1:{port}"
+    try:
+        wait_http(f"{base}/")
+    except Exception:
+        stop_process_group(server)
+        raise
+    return server, port, base
+
+
+def stop_process_group(proc: subprocess.Popen[bytes]) -> None:
+    if proc.poll() is not None:
+        return
+    try:
+        os.killpg(proc.pid, signal.SIGTERM)
+        try:
+            proc.wait(timeout=5)
+        except subprocess.TimeoutExpired:
+            os.killpg(proc.pid, signal.SIGKILL)
+            proc.wait(timeout=3)
+    except ProcessLookupError:
+        pass
+
+
+def start_chrome_session(
+    *,
+    port: int | None = None,
+    headless: bool = True,
+    chrome_path: str | Path | None = None,
+) -> ChromeSession:
+    chrome = discover_chrome(override=str(chrome_path) if chrome_path else None, require=True)
+    assert chrome is not None
+    port = port or find_free_port()
+    user_data = Path(tempfile.mkdtemp(prefix="pch-cdp-ud-"))
+    args = [
+        str(chrome),
+        "--disable-gpu",
+        "--no-first-run",
+        "--no-default-browser-check",
+        "--disable-background-networking",
+        "--disable-sync",
+        "--disable-extensions",
+        f"--remote-debugging-port={port}",
+        f"--user-data-dir={user_data}",
+        "about:blank",
+    ]
+    if headless:
+        args.insert(1, "--headless=new")
+    proc = subprocess.Popen(
+        args,
+        stdout=subprocess.DEVNULL,
+        stderr=subprocess.DEVNULL,
+        start_new_session=True,
+    )
+    try:
+        ws_url = None
+        deadline = time.time() + 20.0
+        while time.time() < deadline:
+            try:
+                with urllib.request.urlopen(f"http://127.0.0.1:{port}/json/version", timeout=0.5) as resp:
+                    ws_url = json.load(resp)["webSocketDebuggerUrl"]
+                    break
+            except (urllib.error.URLError, TimeoutError, KeyError, json.JSONDecodeError):
+                if proc.poll() is not None:
+                    raise RuntimeError(f"Chrome exited early with code {proc.returncode}")
+                time.sleep(0.05)
+        if not ws_url:
+            raise RuntimeError("Chrome CDP endpoint did not become ready")
+        ws = WebSocketClient(ws_url)
+        # Create and attach to a dedicated page target.
+        create_id = 1
+        ws.send_json({"id": create_id, "method": "Target.createTarget", "params": {"url": "about:blank"}})
+        target_id = None
+        while target_id is None:
+            msg = ws.recv_json()
+            if msg.get("id") == create_id:
+                target_id = msg["result"]["targetId"]
+        attach_id = 2
+        ws.send_json(
+            {
+                "id": attach_id,
+                "method": "Target.attachToTarget",
+                "params": {"targetId": target_id, "flatten": True},
+            }
+        )
+        session_id = None
+        while session_id is None:
+            msg = ws.recv_json()
+            if msg.get("id") == attach_id:
+                session_id = msg["result"]["sessionId"]
+        session = ChromeSession(
+            proc=proc,
+            user_data=user_data,
+            port=port,
+            ws=ws,
+            session_id=session_id,
+            _next_id=10,
+        )
+        session.call("Runtime.enable")
+        session.call("Page.enable")
+        return session
+    except Exception:
+        stop_process_group(proc)
+        import shutil
+
+        shutil.rmtree(user_data, ignore_errors=True)
+        raise
