new file mode 100644
index 0000000..87d102b
--- /dev/null
+++ b/scripts/code_tree_digest.py
@@ -0,0 +1,165 @@
+#!/usr/bin/env python3
+"""Compute a stable code-tree digest independent of documentation tip commits.
+
+Binds release validation to tested code/assets without requiring a self-referential
+commit that only exists to embed its own SHA into SESSION_* return docs.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import subprocess
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+
+# Paths that constitute the tested product/code tree for receipt binding.
+CODE_PREFIXES = (
+    "scripts/",
+    "site/",
+    "tests/",
+    "data/",
+    "assets/",
+    "content/",
+    ".github/",
+    "README.md",
+    "COLLAB.md",
+    ".gitignore",
+)
+
+# Explicitly excluded from code-tree binding (session docs / evidence / receipts).
+EXCLUDE_PREFIXES = (
+    "SESSION_",
+    "session-c-evidence/",
+    "session-c2-evidence/",
+    "session-c3-evidence/",
+    "session-c4-evidence/",
+)
+
+
+def _git_ls_files(root: Path) -> list[str]:
+    result = subprocess.run(
+        ["git", "ls-files", "-z"],
+        cwd=str(root),
+        capture_output=True,
+        check=False,
+    )
+    if result.returncode != 0:
+        return []
+    return [p for p in result.stdout.decode("utf-8").split("\0") if p]
+
+
+def _filesystem_code_files(root: Path) -> list[str]:
+    """Fallback when .git is absent (e.g. git archive extract / clean temp tree)."""
+    found: list[str] = []
+    skip_dir_names = {
+        "__pycache__",
+        ".git",
+        "node_modules",
+        "session-c-evidence",
+        "session-c2-evidence",
+        "session-c3-evidence",
+        "session-c4-evidence",
+    }
+    for prefix in CODE_PREFIXES:
+        path = root / prefix
+        if prefix.endswith("/"):
+            if not path.is_dir():
+                continue
+            for file_path in path.rglob("*"):
+                if not file_path.is_file():
+                    continue
+                if any(part in skip_dir_names for part in file_path.parts):
+                    continue
+                rel = str(file_path.relative_to(root)).replace("\\", "/")
+                if is_code_path(rel):
+                    found.append(rel)
+        elif path.is_file():
+            rel = prefix.replace("\\", "/")
+            if is_code_path(rel):
+                found.append(rel)
+    return sorted(set(found))
+
+
+def is_code_path(rel: str) -> bool:
+    if any(rel.startswith(prefix) for prefix in EXCLUDE_PREFIXES):
+        return False
+    if any(rel.startswith(prefix) for prefix in CODE_PREFIXES):
+        return True
+    # top-level tracked non-session files already listed; ignore other SESSION_* etc.
+    return False
+
+
+def sha256_file(path: Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as handle:
+        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+def compute_code_tree_sha256(
+    root: Path | None = None,
+    *,
+    force_filesystem: bool = False,
+) -> dict[str, object]:
+    root = root or ROOT
+    if force_filesystem:
+        files = _filesystem_code_files(root)
+        source = "filesystem-walk"
+    else:
+        files = sorted(p for p in _git_ls_files(root) if is_code_path(p))
+        source = "git-ls-files"
+        if not files:
+            files = _filesystem_code_files(root)
+            source = "filesystem-walk"
+    lines: list[str] = []
+    file_hashes: dict[str, str] = {}
+    for rel in files:
+        path = root / rel
+        if not path.is_file():
+            continue
+        digest = sha256_file(path)
+        file_hashes[rel] = digest
+        lines.append(f"{digest}  {rel}")
+    material = "\n".join(lines) + ("\n" if lines else "")
+    return {
+        "code_tree_sha256": hashlib.sha256(material.encode("utf-8")).hexdigest(),
+        "file_count": len(file_hashes),
+        "files": file_hashes,
+        "source": source,
+        "algorithm": "sha256-over-sorted-'digest  rel'-lines",
+        "prefixes": list(CODE_PREFIXES),
+        "excluded_prefixes": list(EXCLUDE_PREFIXES),
+    }
+
+
+def git_head(root: Path | None = None) -> str:
+    root = root or ROOT
+    result = subprocess.run(
+        ["git", "rev-parse", "HEAD"],
+        cwd=str(root),
+        capture_output=True,
+        text=True,
+        check=False,
+    )
+    return result.stdout.strip() if result.returncode == 0 else "UNKNOWN"
+
+
+def main() -> int:
+    import json
+    import sys
+
+    info = compute_code_tree_sha256()
+    info["git_head"] = git_head()
+    # Drop full file map from default stdout unless --verbose
+    verbose = "--verbose" in sys.argv
+    out = dict(info)
+    if not verbose:
+        out.pop("files", None)
+    print(json.dumps(out, indent=2))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/scripts/content_integrity_harness.py b/scripts/content_integrity_harness.py
new file mode 100644
index 0000000..c46957e
--- /dev/null
+++ b/scripts/content_integrity_harness.py
@@ -0,0 +1,576 @@
+#!/usr/bin/env python3
+"""Content, route, and link integrity audit (Session C4 Lane 3).
+
+Parses generated HTML with stdlib html.parser only. Verifies local href/src/srcset
+resolution, canonical identities, robots/sitemap consistency, safe external link
+attributes, JSON-LD validity, and orphan route detection. No network fetches.
+
+Usage:
+    python3 scripts/content_integrity_harness.py [--site SITE] [--evidence DIR]
+
+Importable API (for tests):
+    run_content_integrity(site_root: Path, evidence_dir: Path | None = None) -> dict
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import re
+import sys
+import xml.etree.ElementTree as ET
+from collections import Counter, deque
+from datetime import datetime, timezone
+from html.parser import HTMLParser
+from pathlib import Path
+from typing import Any
+from urllib.parse import unquote, urlsplit
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT / "scripts"))
+
+from check_local_links import _resolve_target, check_links  # noqa: E402
+
+SITE = ROOT / "site"
+DEFAULT_EVIDENCE = ROOT / "session-c4-evidence" / "content-integrity"
+
+PUBLIC_HOSTS = {"priyanshchordia.com", "www.priyanshchordia.com"}
+BASE_URL = "https://priyanshchordia.com"
+SITEMAP_NS = "{http://www.sitemaps.org/schemas/sitemap/0.9}"
+
+ORPHAN_ALLOWLIST = {"404.html"}
+
+_LINK_RELS_WITH_REFS = {"stylesheet", "icon", "shortcut icon", "apple-touch-icon", "manifest"}
+_REF_TAGS: dict[str, str] = {
+    "a": "href",
+    "area": "href",
+    "img": "src",
+    "script": "src",
+    "audio": "src",
+    "video": "src",
+    "source": "src",
+    "track": "src",
+    "embed": "src",
+    "iframe": "src",
+}
+
+
+class ContentParser(HTMLParser):
+    """Collect content-integrity signals from one HTML document."""
+
+    def __init__(self) -> None:
+        super().__init__(convert_charrefs=True)
+        self.canonicals: list[str] = []
+        self.anchors: list[str] = []
+        self.asset_refs: list[str] = []
+        self.srcset_refs: list[str] = []
+        self.external_links: list[dict[str, str]] = []
+        self.meta_robots = ""
+        self.json_ld: list[str] = []
+        self._json_parts: list[str] | None = None
+
+    def handle_starttag(self, tag: str, attrs: list[tuple[str, str | None]]) -> None:
+        values = {k: (v or "") for k, v in attrs}
+
+        if tag in _REF_TAGS and values.get(_REF_TAGS[tag]):
+            ref = values[_REF_TAGS[tag]]
+            if tag == "a":
+                self.anchors.append(ref)
+                self._maybe_record_external(tag, values, ref)
+            else:
+                self.asset_refs.append(ref)
+        elif tag == "link":
+            rel_parts = set(values.get("rel", "").lower().split())
+            href = values.get("href", "")
+            if "canonical" in rel_parts and href:
+                self.canonicals.append(href)
+            elif rel_parts & _LINK_RELS_WITH_REFS and href:
+                self.asset_refs.append(href)
+        elif tag == "img" and values.get("srcset"):
+            self.srcset_refs.extend(_parse_srcset(values["srcset"]))
+        elif tag == "source" and values.get("srcset"):
+            self.srcset_refs.extend(_parse_srcset(values["srcset"]))
+        elif tag == "meta" and values.get("name", "").lower() == "robots":
+            self.meta_robots = values.get("content", "")
+        elif tag == "script" and values.get("type", "").lower() == "application/ld+json":
+            self._json_parts = []
+
+    def handle_startendtag(self, tag: str, attrs: list[tuple[str, str | None]]) -> None:
+        self.handle_starttag(tag, attrs)
+
+    def handle_endtag(self, tag: str) -> None:
+        if tag == "script" and self._json_parts is not None:
+            self.json_ld.append("".join(self._json_parts))
+            self._json_parts = None
+
+    def handle_data(self, data: str) -> None:
+        if self._json_parts is not None:
+            self._json_parts.append(data)
+
+    def _maybe_record_external(self, tag: str, values: dict[str, str], href: str) -> None:
+        parsed = urlsplit(href)
+        if parsed.scheme not in {"http", "https"}:
+            return
+        self.external_links.append(
+            {
+                "tag": tag,
+                "href": href,
+                "target": values.get("target", ""),
+                "rel": values.get("rel", ""),
+            }
+        )
+
+
+def _parse_srcset(raw: str) -> list[str]:
+    """Extract URL candidates from a srcset attribute value."""
+    urls: list[str] = []
+    for part in raw.split(","):
+        candidate = part.strip().split()[0] if part.strip() else ""
+        if candidate:
+            urls.append(candidate)
+    return urls
+
+
+def _canonical_for_page(rel: Path) -> str:
+    if rel == Path("index.html"):
+        return BASE_URL + "/"
+    if rel.name == "index.html" and rel.parent != Path("."):
+        return BASE_URL + "/" + rel.parent.as_posix() + "/"
+    return BASE_URL + "/" + rel.as_posix()
+
+
+def _url_to_local_path(site_root: Path, url: str) -> Path | None:
+    parsed = urlsplit(url)
+    if parsed.scheme:
+        if parsed.scheme != "https" or parsed.hostname not in PUBLIC_HOSTS:
+            return None
+    elif parsed.netloc:
+        return None
+    path = unquote(parsed.path or "/")
+    if path == "/":
+        target = site_root / "index.html"
+    elif path.endswith("/"):
+        target = site_root / path.lstrip("/") / "index.html"
+    else:
+        candidate = site_root / path.lstrip("/")
+        if candidate.is_dir():
+            target = candidate / "index.html"
+        elif not candidate.suffix:
+            target = candidate / "index.html"
+        else:
+            target = candidate
+    try:
+        resolved = target.resolve()
+        resolved.relative_to(site_root.resolve())
+        return resolved
+    except (OSError, ValueError):
+        return None
+
+
+def _is_noindex(robots: str) -> bool:
+    return "noindex" in robots.lower()
+
+
+def _parse_pages(site_root: Path) -> dict[Path, ContentParser]:
+    pages: dict[Path, ContentParser] = {}
+    for html_file in sorted(site_root.rglob("*.html")):
+        parser = ContentParser()
+        parser.feed(html_file.read_text(encoding="utf-8", errors="replace"))
+        parser.close()
+        pages[html_file.resolve()] = parser
+    return pages
+
+
+def _check_srcset(site_root: Path, pages: dict[Path, ContentParser]) -> list[str]:
+    errors: list[str] = []
+    for source_abs, parser in pages.items():
+        rel = source_abs.relative_to(site_root)
+        for raw_url in parser.srcset_refs:
+            target_path, _fragment = _resolve_target(source_abs, raw_url, site_root)
+            if target_path is None:
+                continue
+            if target_path.name == "__outside_site__":
+                errors.append(f"{rel}: srcset escapes site root: {raw_url!r}")
+            elif not target_path.exists():
+                errors.append(f"{rel}: broken srcset reference {raw_url!r}")
+    return errors
+
+
+def _check_canonicals(site_root: Path, pages: dict[Path, ContentParser]) -> tuple[list[str], list[str]]:
+    failures: list[str] = []
+    warnings: list[str] = []
+    url_to_pages: dict[str, list[str]] = {}
+
+    for path, parser in pages.items():
+        rel = path.relative_to(site_root).as_posix()
+        if len(parser.canonicals) == 0:
+            failures.append(f"{rel}: missing canonical link")
+            continue
+        if len(parser.canonicals) > 1:
+            failures.append(f"{rel}: multiple canonical links ({len(parser.canonicals)})")
+            continue
+
+        canonical = parser.canonicals[0]
+        parsed = urlsplit(canonical)
+        if parsed.scheme != "https":
+            failures.append(f"{rel}: canonical must use https: {canonical!r}")
+        elif parsed.hostname not in PUBLIC_HOSTS:
+            failures.append(f"{rel}: canonical has wrong host: {canonical!r}")
+
+        url_to_pages.setdefault(canonical, []).append(rel)
+
+        expected = _canonical_for_page(path.relative_to(site_root))
+        if canonical != expected and rel not in ORPHAN_ALLOWLIST:
+            warnings.append(
+                f"{rel}: canonical {canonical!r} differs from expected {expected!r}"
+            )
+
+    for canonical, rels in sorted(url_to_pages.items()):
+        if len(rels) > 1:
+            failures.append(
+                f"duplicate canonical identity {canonical!r} claimed by: {', '.join(sorted(rels))}"
+            )
+
+    return failures, warnings
+
+
+def _check_external_links(pages: dict[Path, ContentParser], site_root: Path) -> list[str]:
+    failures: list[str] = []
+    for path, parser in pages.items():
+        rel = path.relative_to(site_root).as_posix()
+        for link in parser.external_links:
+            target = link.get("target", "").lower()
+            if target != "_blank":
+                continue
+            rel_tokens = set(re.split(r"\s+", link.get("rel", "").strip().lower()))
+            rel_tokens.discard("")
+            missing = []
+            if "noopener" not in rel_tokens:
+                missing.append("noopener")
+            if "noreferrer" not in rel_tokens:
+                missing.append("noreferrer")
+            if missing:
+                failures.append(
+                    f"{rel}: external target=_blank link missing rel={'/'.join(missing)}: {link['href']!r}"
+                )
+    return failures
+
+
+def _check_json_ld(site_root: Path, pages: dict[Path, ContentParser]) -> list[str]:
+    failures: list[str] = []
+    for path, parser in pages.items():
+        rel = path.relative_to(site_root).as_posix()
+        canonical = parser.canonicals[0] if len(parser.canonicals) == 1 else None
+        for index, payload in enumerate(parser.json_ld):
+            label = f"{rel} JSON-LD block {index + 1}"
+            try:
+                data = json.loads(payload)
+            except json.JSONDecodeError as exc:
+                failures.append(f"{label}: invalid JSON: {exc}")
+                continue
+
+            blocks = data if isinstance(data, list) else [data]
+            for block in blocks:
+                if not isinstance(block, dict):
+                    failures.append(f"{label}: expected object, got {type(block).__name__}")
+                    continue
+                if "@type" not in block:
+                    failures.append(f"{label}: missing @type")
+                url_value = block.get("url")
+                if url_value is not None and canonical is not None and url_value != canonical:
+                    failures.append(
+                        f"{label}: @url {url_value!r} inconsistent with canonical {canonical!r}"
+                    )
+    return failures
+
+
+def _parse_robots(site_root: Path) -> tuple[list[str], list[str]]:
+    failures: list[str] = []
+    warnings: list[str] = []
+    robots_path = site_root / "robots.txt"
+    if not robots_path.is_file():
+        return [f"missing discovery file: robots.txt"], warnings
+
+    text = robots_path.read_text(encoding="utf-8")
+    sitemap_lines = [
+        line.split(":", 1)[1].strip()
+        for line in text.splitlines()
+        if line.lower().startswith("sitemap:")
+    ]
+    if not sitemap_lines:
+        failures.append("robots.txt does not advertise a sitemap")
+    elif f"{BASE_URL}/sitemap.xml" not in sitemap_lines:
+        warnings.append(
+            "robots.txt sitemap line differs from production default "
+            f"({BASE_URL}/sitemap.xml)"
+        )
+    return failures, warnings
+
+
+def _parse_sitemap(site_root: Path) -> tuple[set[str], list[str], list[str]]:
+    failures: list[str] = []
+    warnings: list[str] = []
+    sitemap_path = site_root / "sitemap.xml"
+    if not sitemap_path.is_file():
+        return set(), [f"missing discovery file: sitemap.xml"], warnings
+
+    try:
+        root = ET.parse(sitemap_path).getroot()
+    except ET.ParseError as exc:
+        return set(), [f"sitemap.xml is invalid XML: {exc}"], warnings
+
+    loc_nodes = [
+        (node.text or "").strip()
+        for node in root.findall(f"{SITEMAP_NS}url/{SITEMAP_NS}loc")
+        if (node.text or "").strip()
+    ]
+    duplicate_locs = sorted(url for url, count in Counter(loc_nodes).items() if count > 1)
+    if duplicate_locs:
+        failures.append("sitemap contains duplicate loc entries: " + ", ".join(duplicate_locs))
+
+    sitemap_urls: set[str] = set(loc_nodes)
+    for url in sorted(sitemap_urls):
+        parsed = urlsplit(url)
+        if parsed.scheme != "https" or parsed.hostname not in PUBLIC_HOSTS:
+            failures.append(f"sitemap loc has invalid host or scheme: {url!r}")
+            continue
+        local = _url_to_local_path(site_root, url)
+        if local is None:
+            failures.append(f"sitemap loc does not map to site tree: {url!r}")
+        elif not local.exists():
+            failures.append(
+                f"sitemap loc maps to missing file: {url!r} -> {local.relative_to(site_root)}"
+            )
+
+    return sitemap_urls, failures, warnings
+
+
+def _check_sitemap_indexable_consistency(
+    site_root: Path,
+    pages: dict[Path, ContentParser],
+    sitemap_urls: set[str],
+) -> tuple[list[str], list[str]]:
+    failures: list[str] = []
+    warnings: list[str] = []
+
+    indexable_canonicals: set[str] = set()
+    noindex_canonicals: set[str] = set()
+    for path, parser in pages.items():
+        if len(parser.canonicals) != 1:
+            continue
+        canonical = parser.canonicals[0]
+        if _is_noindex(parser.meta_robots):
+            noindex_canonicals.add(canonical)
+        else:
+            indexable_canonicals.add(canonical)
+
+    missing_from_sitemap = sorted(indexable_canonicals - sitemap_urls)
+    if missing_from_sitemap:
+        failures.append(
+            "indexable pages missing from sitemap: " + ", ".join(missing_from_sitemap)
+        )
+
+    stale_sitemap = sorted(sitemap_urls - indexable_canonicals - noindex_canonicals)
+    if stale_sitemap:
+        warnings.append(
+            "sitemap contains URLs with no matching indexable/noindex page: "
+            + ", ".join(stale_sitemap)
+        )
+
+    noindex_in_sitemap = sorted(noindex_canonicals & sitemap_urls)
+    if noindex_in_sitemap:
+        failures.append(
+            "noindex pages must not appear in sitemap: " + ", ".join(noindex_in_sitemap)
+        )
+
+    return failures, warnings
+
+
+def _check_orphans(site_root: Path, pages: dict[Path, ContentParser]) -> tuple[list[str], list[str]]:
+    failures: list[str] = []
+    warnings: list[str] = []
+
+    graph: dict[Path, set[Path]] = {path: set() for path in pages}
+    for path, parser in pages.items():
+        for raw_url in parser.anchors:
+            target_path, _fragment = _resolve_target(path, raw_url, site_root)
+            if target_path is None or target_path.name == "__outside_site__":
+                continue
+            if target_path.suffix.lower() == ".html" and target_path in pages:
+                graph[path].add(target_path)
+
+    start = (site_root / "index.html").resolve()
+    reachable: set[Path] = set()
+    queue: deque[Path] = deque([start]) if start in pages else deque()
+    while queue:
+        page = queue.popleft()
+        if page in reachable:
+            continue
+        reachable.add(page)
+        queue.extend(graph.get(page, set()) - reachable)
+
+    ignored = {(site_root / name).resolve() for name in ORPHAN_ALLOWLIST}
+    for path in sorted(set(pages) - reachable - ignored):
+        rel = path.relative_to(site_root).as_posix()
+        parser = pages[path]
+        if _is_noindex(parser.meta_robots):
+            warnings.append(f"{rel}: orphan HTML page (noindex)")
+        else:
+            failures.append(f"{rel}: orphan indexable HTML page unreachable from home")
+
+    return failures, warnings
+
+
+def run_content_integrity(
+    site_root: Path,
+    evidence_dir: Path | None = None,
+) -> dict[str, Any]:
+    """Run the full content integrity audit and optionally write JSON evidence."""
+    started = datetime.now(timezone.utc)
+    site_root = site_root.resolve()
+
+    failures: list[str] = []
+    warnings: list[str] = []
+    sections: dict[str, Any] = {}
+
+    if not site_root.is_dir():
+        summary = {
+            "started_at": started.isoformat(),
+            "finished_at": datetime.now(timezone.utc).isoformat(),
+            "site_root": str(site_root),
+            "ok": False,
+            "failures": [f"site root does not exist or is not a directory: {site_root}"],
+            "warnings": [],
+            "sections": {},
+        }
+        if evidence_dir is not None:
+            evidence_dir.mkdir(parents=True, exist_ok=True)
+            out = evidence_dir / "content_integrity_summary.json"
+            out.write_text(json.dumps(summary, indent=2) + "\n", encoding="utf-8")
+            summary["summary_path"] = str(out)
+        return summary
+
+    pages = _parse_pages(site_root)
+    page_count = len(pages)
+
+    link_errors = check_links(site_root)
+    sections["local_links"] = {"failures": link_errors, "count": len(link_errors)}
+    failures.extend(link_errors)
+
+    srcset_errors = _check_srcset(site_root, pages)
+    sections["srcset"] = {"failures": srcset_errors, "count": len(srcset_errors)}
+    failures.extend(srcset_errors)
+
+    canon_failures, canon_warnings = _check_canonicals(site_root, pages)
+    sections["canonicals"] = {
+        "failures": canon_failures,
+        "warnings": canon_warnings,
+        "count": len(canon_failures),
+    }
+    failures.extend(canon_failures)
+    warnings.extend(canon_warnings)
+
+    external_failures = _check_external_links(pages, site_root)
+    sections["external_links"] = {"failures": external_failures, "count": len(external_failures)}
+    failures.extend(external_failures)
+
+    json_ld_failures = _check_json_ld(site_root, pages)
+    sections["json_ld"] = {"failures": json_ld_failures, "count": len(json_ld_failures)}
+    failures.extend(json_ld_failures)
+
+    robots_failures, robots_warnings = _parse_robots(site_root)
+    sections["robots"] = {"failures": robots_failures, "warnings": robots_warnings}
+    failures.extend(robots_failures)
+    warnings.extend(robots_warnings)
+
+    sitemap_urls, sitemap_failures, sitemap_warnings = _parse_sitemap(site_root)
+    sections["sitemap"] = {
+        "url_count": len(sitemap_urls),
+        "failures": sitemap_failures,
+        "warnings": sitemap_warnings,
+    }
+    failures.extend(sitemap_failures)
+    warnings.extend(sitemap_warnings)
+
+    if sitemap_urls:
+        consistency_failures, consistency_warnings = _check_sitemap_indexable_consistency(
+            site_root, pages, sitemap_urls
+        )
+        sections["sitemap_indexable"] = {
+            "failures": consistency_failures,
+            "warnings": consistency_warnings,
+        }
+        failures.extend(consistency_failures)
+        warnings.extend(consistency_warnings)
+
+    orphan_failures, orphan_warnings = _check_orphans(site_root, pages)
+    sections["orphans"] = {
+        "failures": orphan_failures,
+        "warnings": orphan_warnings,
+        "allowlist": sorted(ORPHAN_ALLOWLIST),
+    }
+    failures.extend(orphan_failures)
+    warnings.extend(orphan_warnings)
+
+    finished = datetime.now(timezone.utc)
+    summary: dict[str, Any] = {
+        "started_at": started.isoformat(),
+        "finished_at": finished.isoformat(),
+        "site_root": str(site_root),
+        "page_count": page_count,
+        "boundary": (
+            "Static HTML content integrity: local links/assets, canonicals, "
+            "robots/sitemap, external rel safety, JSON-LD, orphan routes. "
+            "No external network fetches."
+        ),
+        "ok": not failures,
+        "failure_count": len(failures),
+        "warning_count": len(warnings),
+        "failures": failures,
+        "warnings": warnings,
+        "sections": sections,
+    }
+
+    if evidence_dir is not None:
+        evidence_dir.mkdir(parents=True, exist_ok=True)
+        out = evidence_dir / "content_integrity_summary.json"
+        out.write_text(json.dumps(summary, indent=2) + "\n", encoding="utf-8")
+        summary["summary_path"] = str(out)
+
+    return summary
+
+
+def main(argv: list[str] | None = None) -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--site", type=Path, default=SITE, help="Site root directory")
+    parser.add_argument(
+        "--evidence",
+        type=Path,
+        default=DEFAULT_EVIDENCE,
+        help="Directory for JSON evidence output",
+    )
+    args = parser.parse_args(argv)
+
+    summary = run_content_integrity(args.site, args.evidence)
+    print(
+        json.dumps(
+            {
+                "ok": summary["ok"],
+                "failure_count": summary.get("failure_count", len(summary.get("failures", []))),
+                "warning_count": summary.get("warning_count", len(summary.get("warnings", []))),
+                "summary": summary.get("summary_path"),
+            },
+            indent=2,
+        )
+    )
+    if summary.get("failures"):
+        for failure in summary["failures"]:
+            print(f"FAIL: {failure}", file=sys.stderr)
+    if summary.get("warnings"):
+        for warning in summary["warnings"]:
+            print(f"WARN: {warning}", file=sys.stderr)
+    return 0 if summary["ok"] else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
