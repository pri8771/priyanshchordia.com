+
+        for path in POINTER_SAMPLE_ROUTES:
+            if path not in routes:
+                continue
+            try:
+                audit_route_pointer(session, base, path, cases)
+            except Exception as exc:  # noqa: BLE001
+                errors.append(f"pointer {path}: {exc}")
+                traceback.print_exc()
+
+        for path in STORAGE_SAMPLE_ROUTES:
+            if path not in routes:
+                continue
+            try:
+                audit_storage_edges(session, base, path, cases)
+            except Exception as exc:  # noqa: BLE001
+                errors.append(f"storage {path}: {exc}")
+                traceback.print_exc()
+
+        for path in QUERY_SAMPLE_ROUTES:
+            if path not in routes:
+                continue
+            try:
+                audit_weird_query(session, base, path, cases)
+            except Exception as exc:  # noqa: BLE001
+                errors.append(f"query {path}: {exc}")
+                traceback.print_exc()
+
+        try:
+            audit_emulated_media(session, base, cases)
+        except Exception as exc:  # noqa: BLE001
+            errors.append(f"media: {exc}")
+            traceback.print_exc()
+
+        try:
+            audit_waitlist(session, base, cases)
+        except Exception as exc:  # noqa: BLE001
+            errors.append(f"waitlist: {exc}")
+            traceback.print_exc()
+
+        try:
+            audit_offline_brief(session, base, cases)
+        except Exception as exc:  # noqa: BLE001
+            errors.append(f"offline: {exc}")
+            traceback.print_exc()
+
+    finally:
+        if session is not None:
+            session.close()
+        if server is not None:
+            stop_process_group(server)
+
+    return cases, errors, meta
+
+
+def build_summary(
+    *,
+    site: Path,
+    evidence: Path,
+    routes: list[str],
+    cases: list[dict[str, Any]],
+    errors: list[str],
+    meta: dict[str, Any],
+) -> dict[str, Any]:
+    failed = [c for c in cases if not c["ok"]]
+    return {
+        "started_at": datetime.now(timezone.utc).isoformat(),
+        "finished_at": datetime.now(timezone.utc).isoformat(),
+        "site": str(site),
+        "routes": routes,
+        "route_count": len(routes),
+        "boundary": BOUNDARY,
+        "browser": meta.get("browser"),
+        "base": meta.get("base"),
+        "http_port": meta.get("http_port"),
+        "cdp_port": meta.get("cdp_port"),
+        "cases": cases,
+        "case_count": len(cases),
+        "passed_count": len(cases) - len(failed),
+        "failed": [{"name": c["name"], "detail": c["detail"]} for c in failed],
+        "harness_errors": errors,
+        "ok": not failed and not errors,
+        "tested_boundaries": [
+            "keyboard_tab_skip",
+            "pointer_skip_click",
+            "focus_recovery_history",
+            "reload",
+            "fragment_main",
+            "weird_query_strings",
+            "storage_disabled",
+            "storage_corrupt_json",
+            "prefers-reduced-motion",
+            "prefers-color-scheme",
+            "waitlist_repeated_submit",
+            "offline_brief_restore",
+        ],
+    }
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--site", type=Path, default=SITE)
+    parser.add_argument("--evidence", type=Path, default=DEFAULT_EVIDENCE)
+    parser.add_argument("--port", type=int, default=0, help="HTTP loopback port (0=ephemeral)")
+    parser.add_argument("--routes", nargs="*", default=None, help="Optional route subset")
+    args = parser.parse_args()
+
+    if not args.site.is_dir():
+        print(f"site missing: {args.site}", file=sys.stderr)
+        return 2
+
+    args.evidence.mkdir(parents=True, exist_ok=True)
+    routes = args.routes or INTERACTIVE_ROUTES
+    summary_started = datetime.now(timezone.utc).isoformat()
+
+    cases, errors, meta = run_matrix(args.site, routes, port=args.port)
+    summary = build_summary(
+        site=args.site,
+        evidence=args.evidence,
+        routes=routes,
+        cases=cases,
+        errors=errors,
+        meta=meta,
+    )
+    summary["started_at"] = summary_started
+
+    out = args.evidence / "browser_matrix_summary.json"
+    out.write_text(json.dumps(summary, indent=2) + "\n", encoding="utf-8")
+
+    failed = [c for c in cases if not c["ok"]]
+    print(
+        json.dumps(
+            {
+                "ok": summary["ok"],
+                "case_count": summary["case_count"],
+                "passed_count": summary["passed_count"],
+                "failed": [c["name"] for c in failed],
+                "harness_errors": errors,
+                "browser": summary.get("browser", {}).get("resolved"),
+                "summary": str(out),
+            },
+            indent=2,
+        )
+    )
+    return 0 if summary["ok"] else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
