+#!/usr/bin/env python3
+"""Static-host mode verification harness (C4 Lane 4).
+
+Exercises Python http.server loopback hosting from the live site tree and from
+a temp publish-folder copy: trailing-slash resolution, 404s, nested routes,
+Content-Type / Cache-Control headers, HTTP refresh, and optional CDP reload.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import shutil
+import subprocess
+import sys
+import tempfile
+import urllib.error
+import urllib.request
+from datetime import datetime, timezone
+from pathlib import Path
+from typing import Any
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT / "scripts"))
+
+from cdp_client import (  # noqa: E402
+    ChromeDiscoveryError,
+    chrome_discovery_report,
+    discover_chrome,
+    start_chrome_session,
+    start_loopback_http,
+    stop_process_group,
+)
+
+SITE = ROOT / "site"
+DEFAULT_EVIDENCE = ROOT / "session-c4-evidence" / "static-host"
+
+# Nested directory routes backed by index.html on disk.
+NESTED_INDEX_ROUTES = (
+    "/apps/mala/privacy/",
+    "/apps/mala/support/",
+    "/products/mala/",
+    "/journal/",
+    "/apps/",
+)
+
+# Static assets for Content-Type checks (path -> acceptable MIME prefixes/types).
+MIME_PROBE_PATHS: dict[str, tuple[str, ...]] = {
+    "/index.html": ("text/html",),
+    "/styles.css": ("text/css",),
+    "/waitlist.js": ("text/javascript", "application/javascript"),
+    "/sitemap.xml": ("application/xml", "text/xml"),
+    "/robots.txt": ("text/plain",),
+    "/og.png": ("image/png",),
+}
+
+# Extra MIME probe added only in temp publish copies.
+TEMP_EXTRA_MIME_PATHS: dict[str, tuple[str, ...]] = {
+    "/probe.png": ("image/png",),
+}
+
+# Minimal 1x1 PNG (valid image/png payload for temp publish copies).
+_MINIMAL_PNG = bytes.fromhex(
+    "89504e470d0a1a0a0000000d49484452000000010000000108060000001f15c489"
+    "0000000a49444154789c6300010000050001b5a5a5a80000000049454e44ae426082"
+)
+
+MISSING_PATH = "/definitely-missing-route-c4/"
+DEEP_REFRESH_PATH = "/apps/mala/privacy/"
+
+
+def nested_route_variants(route: str) -> tuple[str, str]:
+    """Return (no_trailing_slash, with_trailing_slash) for a nested index route."""
+    route = route if route.startswith("/") else f"/{route}"
+    with_slash = route if route.endswith("/") else f"{route}/"
+    no_slash = with_slash.rstrip("/")
+    return no_slash, with_slash
+
+
+def expected_content_types(path: str) -> tuple[str, ...]:
+    """Acceptable Content-Type values for a probe path (empty if unknown)."""
+    return MIME_PROBE_PATHS.get(path, ())
+
+
+def content_type_matches(actual: str | None, expected: tuple[str, ...]) -> bool:
+    if not actual or not expected:
+        return False
+    base = actual.split(";", 1)[0].strip().lower()
+    return any(base == exp.lower() or base.startswith(exp.lower()) for exp in expected)
+
+
+def trailing_slash_resolution_ok(status: int, body: bytes) -> bool:
+    """http.server may 301/302 to add a slash or serve index.html with 200."""
+    if status in (301, 302, 308):
+        return True
+    if status == 200:
+        return len(body) > 0
+    return False
+
+
+def http_get(url: str) -> tuple[int, bytes, dict[str, str]]:
+    req = urllib.request.Request(url, method="GET")
+    try:
+        with urllib.request.urlopen(req, timeout=5) as resp:
+            headers = {k.lower(): v for k, v in resp.headers.items()}
+            return resp.status, resp.read(), headers
+    except urllib.error.HTTPError as exc:
+        headers = {k.lower(): v for k, v in exc.headers.items()} if exc.headers else {}
+        return exc.code, exc.read() if exc.fp else b"", headers
+
+
+def record(cases: list[dict[str, Any]], name: str, ok: bool, detail: Any = None) -> None:
+    cases.append({"name": name, "ok": ok, "detail": detail})
+
+
+def prepare_temp_publish_site(source: Path) -> Path:
+    """Copy site/ to a temp folder and add probe.png for MIME coverage."""
+    dest = Path(tempfile.mkdtemp(prefix="pch-c4-static-publish-"))
+    shutil.copytree(source, dest, dirs_exist_ok=True)
+    (dest / "probe.png").write_bytes(_MINIMAL_PNG)
+    return dest
+
+
+def mime_paths_for_mode(mode: str) -> dict[str, tuple[str, ...]]:
+    paths = dict(MIME_PROBE_PATHS)
+    if mode == "temp_publish_copy":
+        paths.update(TEMP_EXTRA_MIME_PATHS)
+    return paths
+
+
+def check_http_cases(base: str, mode: str, cases: list[dict[str, Any]]) -> None:
+    prefix = f"http.{mode}"
+
+    for route in NESTED_INDEX_ROUTES:
+        no_slash, with_slash = nested_route_variants(route)
+        for variant in (no_slash, with_slash):
+            status, body, _ = http_get(base + variant)
+            record(
+                cases,
+                f"{prefix}.nested{variant}",
+                trailing_slash_resolution_ok(status, body),
+                {"status": status, "bytes": len(body), "variant": variant},
+            )
+
+    status, body, _ = http_get(base + MISSING_PATH)
+    record(
+        cases,
+        f"{prefix}.missing_404",
+        status == 404,
+        {"status": status, "bytes": len(body), "path": MISSING_PATH},
+    )
+
+    for path, expected in mime_paths_for_mode(mode).items():
+        status, body, headers = http_get(base + path)
+        ctype = headers.get("content-type")
+        ok = status == 200 and content_type_matches(ctype, expected)
+        record(
+            cases,
+            f"{prefix}.mime{path}",
+            ok,
+            {"status": status, "content_type": ctype, "expected": list(expected)},
+        )
+
+    # Cache-Control: python http.server typically omits it; presence or absence is OK.
+    _, _, sample_headers = http_get(base + "/index.html")
+    cache = sample_headers.get("cache-control")
+    record(
+        cases,
+        f"{prefix}.cache_control_observed",
+        True,
+        {"cache_control": cache, "note": "absence acceptable for local http.server"},
+    )
+
+    status1, body1, _ = http_get(base + DEEP_REFRESH_PATH)
+    status2, body2, _ = http_get(base + DEEP_REFRESH_PATH)
+    record(
+        cases,
+        f"{prefix}.deep_refresh_http",
+        status1 == 200 and status2 == 200 and len(body1) > 0 and len(body2) > 0,
+        {"first_status": status1, "second_status": status2, "path": DEEP_REFRESH_PATH},
+    )
+
+    status, body, _ = http_get(base + "/apps/mala/privacy/")
+    record(
+        cases,
+        f"{prefix}.apps_mala_privacy",
+        status == 200 and len(body) > 0 and b"privacy" in body.lower(),
+        {"status": status, "bytes": len(body)},
+    )
+
+
+def check_chrome_deep_reload(base: str, cases: list[dict[str, Any]]) -> dict[str, Any]:
+    """Optional CDP navigate + reload; returns chrome section metadata."""
+    report = chrome_discovery_report()
+    chrome_meta: dict[str, Any] = {
+        "discovery_report": report,
+        "skipped": False,
+        "skip_reason": None,
+    }
+    try:
+        discover_chrome(require=True)
+    except ChromeDiscoveryError as exc:
+        chrome_meta["skipped"] = True
+        chrome_meta["skip_reason"] = "environment_blocked"
+        chrome_meta["error"] = str(exc)
+        record(
+            cases,
+            "chrome.deep_link_reload",
+            True,
+            {
+                "skipped": True,
+                "reason": "missing_chrome",
+                "tried_paths": [item.get("path") for item in report.get("candidates_tried", [])],
+            },
+        )
+        return chrome_meta
+
+    session = None
+    try:
+        session = start_chrome_session()
+        deep_url = f"{base}{DEEP_REFRESH_PATH}"
+        session.navigate(deep_url)
+        path = session.evaluate("location.pathname") or ""
+        title_ok = bool(session.evaluate("document.title && document.title.length > 0"))
+        session.evaluate("location.reload()")
+        session.evaluate("(() => new Promise(r => setTimeout(r, 600)))()", await_promise=True)
+        path_after = session.evaluate("location.pathname") or ""
+        main_ok = bool(session.evaluate("!!document.getElementById('main') || !!document.body"))
+        ok = "privacy" in path and "privacy" in path_after and title_ok and main_ok
+        record(
+            cases,
+            "chrome.deep_link_reload",
+            ok,
+            {"url": deep_url, "path_before": path, "path_after_reload": path_after},
+        )
+    except Exception as exc:  # noqa: BLE001
+        record(cases, "chrome.deep_link_reload", False, {"error": str(exc)})
+        chrome_meta["error"] = str(exc)
+    finally:
+        if session is not None:
+            session.close()
+    return chrome_meta
+
+
+def run_mode(site: Path, mode: str, cases: list[dict[str, Any]]) -> tuple[dict[str, Any], subprocess.Popen[bytes] | None]:
+    """Start loopback server, run HTTP checks; caller stops server when done."""
+    server, port, base = start_loopback_http(site)
+    info: dict[str, Any] = {
+        "mode": mode,
+        "site": str(site),
+        "bind": "127.0.0.1",
+        "base": base,
+        "http_port": port,
+    }
+    check_http_cases(base, mode, cases)
+    return info, server
+
+
+def http_cases_ok(cases: list[dict[str, Any]]) -> bool:
+    return all(c["ok"] for c in cases if c["name"].startswith("http."))
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--site", type=Path, default=SITE)
+    parser.add_argument("--evidence", type=Path, default=DEFAULT_EVIDENCE)
+    parser.add_argument("--skip-browser", action="store_true")
+    parser.add_argument("--skip-temp-copy", action="store_true")
+    args = parser.parse_args()
+
+    args.evidence.mkdir(parents=True, exist_ok=True)
+    cases: list[dict[str, Any]] = []
+    errors: list[str] = []
+    temp_site: Path | None = None
+    summary: dict[str, Any] = {
+        "started_at": datetime.now(timezone.utc).isoformat(),
+        "site": str(args.site),
+        "boundary": (
+            "Local Python http.server modes only. Not CDN, GitHub Pages, or production cache proof."
+        ),
+        "mime_reference": {k: list(v) for k, v in MIME_PROBE_PATHS.items()},
+        "temp_extra_mime": {k: list(v) for k, v in TEMP_EXTRA_MIME_PATHS.items()},
+    }
+
+    try:
+        modes_run: list[dict[str, Any]] = []
+        site_info, site_server = run_mode(args.site, "site_root", cases)
+        modes_run.append(site_info)
+        try:
+            if not args.skip_browser:
+                summary["chrome"] = check_chrome_deep_reload(site_info["base"], cases)
+            else:
+                summary["chrome"] = {"skipped": True, "skip_reason": "flag"}
+        finally:
+            if site_server is not None:
+                stop_process_group(site_server)
+
+        if not args.skip_temp_copy:
+            temp_site = prepare_temp_publish_site(args.site)
+            temp_info, temp_server = run_mode(temp_site, "temp_publish_copy", cases)
+            modes_run.append(temp_info)
+            if temp_server is not None:
+                stop_process_group(temp_server)
+
+        summary["modes"] = modes_run
+    except Exception as exc:  # noqa: BLE001
+        errors.append(str(exc))
+    finally:
+        if temp_site is not None and temp_site.exists():
+            shutil.rmtree(temp_site, ignore_errors=True)
+
+    http_ok = http_cases_ok(cases)
+    chrome_case = next((c for c in cases if c["name"] == "chrome.deep_link_reload"), None)
+    chrome_skipped = bool(chrome_case and (chrome_case.get("detail") or {}).get("skipped"))
+
+    failed = [c for c in cases if not c["ok"]]
+    summary["finished_at"] = datetime.now(timezone.utc).isoformat()
+    summary["cases"] = cases
+    summary["failed"] = [c["name"] for c in failed]
+    summary["harness_errors"] = errors
+    summary["http_ok"] = http_ok and not errors
+    summary["ok"] = summary["http_ok"] and (chrome_skipped or (chrome_case and chrome_case["ok"]))
+
+    out = args.evidence / "static_host_summary.json"
+    out.write_text(json.dumps(summary, indent=2) + "\n", encoding="utf-8")
+    print(json.dumps({"ok": summary["ok"], "http_ok": summary["http_ok"], "failed": summary["failed"], "summary": str(out)}, indent=2))
+    return 0 if summary["ok"] else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
