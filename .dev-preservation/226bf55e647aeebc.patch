+"""Release receipt validation proofs (Lane 4) — v1 + v2 code-tree binding."""
+
+from __future__ import annotations
+
+import copy
+import importlib.util
+import json
+import subprocess
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+
+
+ROOT = Path(__file__).resolve().parents[1]
+SPEC = importlib.util.spec_from_file_location(
+    "validate_release_receipt", ROOT / "scripts" / "validate_release_receipt.py"
+)
+assert SPEC and SPEC.loader
+VAL = importlib.util.module_from_spec(SPEC)
+SPEC.loader.exec_module(VAL)
+
+DIGEST_SPEC = importlib.util.spec_from_file_location(
+    "code_tree_digest", ROOT / "scripts" / "code_tree_digest.py"
+)
+assert DIGEST_SPEC and DIGEST_SPEC.loader
+DIGEST = importlib.util.module_from_spec(DIGEST_SPEC)
+DIGEST_SPEC.loader.exec_module(DIGEST)
+
+
+def sample_receipt_v1() -> dict:
+    hashes = {
+        "index.html": "a" * 64,
+        "styles.css": "b" * 64,
+    }
+    receipt = {
+        "schema": "priyanshchordia.release_receipt.v1",
+        "started_at": "2026-09-07T21:00:00+00:00",
+        "finished_at": "2026-09-07T21:05:00+00:00",
+        "ok": True,
+        "source_sha": "ba88c4123a1261855399394dfb2e51ee10fc781d",
+        "worktree": str(ROOT),
+        "branch": "codex/pch-browser-release-hardening-20260907",
+        "environment": {"python": "3.14.6", "node": "v24.18.0", "platform": "test-os"},
+        "artifact_count": 2,
+        "artifact_tree_sha256": VAL.recompute_tree_hash(hashes),
+        "artifact_hashes": hashes,
+        "steps": [{"name": "unittest", "ok": True, "exit_code": 0}],
+        "known_limitations": ["fixture"],
+    }
+    receipt["receipt_sha256"] = VAL.receipt_body_hash(receipt)
+    return receipt
+
+
+def sample_receipt_v2() -> dict:
+    receipt = sample_receipt_v1()
+    receipt["schema"] = "priyanshchordia.release_receipt.v2"
+    receipt["git_head_at_check"] = receipt["source_sha"]
+    receipt["code_tree_sha256"] = "c" * 64
+    receipt["receipt_sha256"] = VAL.receipt_body_hash(receipt)
+    return receipt
+
+
+class ReleaseReceiptValidationTests(unittest.TestCase):
+    def test_valid_receipt_passes(self) -> None:
+        receipt = sample_receipt_v1()
+        self.assertEqual(VAL.validate(receipt, expect_sha=receipt["source_sha"]), [])
+
+    def test_valid_v2_passes(self) -> None:
+        receipt = sample_receipt_v2()
+        self.assertEqual(
+            VAL.validate(receipt, expect_code_tree=receipt["code_tree_sha256"]),
+            [],
+        )
+
+    def test_partial_receipt_fails(self) -> None:
+        receipt = sample_receipt_v1()
+        del receipt["artifact_hashes"]
+        errors = VAL.validate(receipt)
+        self.assertTrue(any("partial" in e for e in errors))
+
+    def test_mismatched_source_sha_fails(self) -> None:
+        receipt = sample_receipt_v1()
+        errors = VAL.validate(receipt, expect_sha="0" * 40)
+        self.assertTrue(any("source_sha mismatch" in e for e in errors))
+
+    def test_mismatched_code_tree_fails(self) -> None:
+        receipt = sample_receipt_v2()
+        errors = VAL.validate(receipt, expect_code_tree="0" * 64)
+        self.assertTrue(any("code_tree_sha256 mismatch" in e for e in errors))
+
+    def test_stale_tree_hash_fails(self) -> None:
+        receipt = sample_receipt_v1()
+        receipt["artifact_tree_sha256"] = "0" * 64
+        errors = VAL.validate(receipt)
+        self.assertTrue(any("artifact_tree_sha256" in e or "tamper" in e for e in errors))
+
+    def test_tampered_ok_flag_fails_seal(self) -> None:
+        receipt = sample_receipt_v1()
+        receipt["ok"] = False
+        errors = VAL.validate(receipt)
+        self.assertTrue(any("tamper" in e or "ok is not true" in e for e in errors))
+
+    def test_tampered_step_without_reseal_fails(self) -> None:
+        receipt = sample_receipt_v1()
+        receipt["steps"] = list(receipt["steps"]) + [{"name": "evil", "ok": True}]
+        errors = VAL.validate(receipt)
+        self.assertTrue(any("tamper" in e for e in errors))
+
+    def test_path_traversal_artifact_key_fails(self) -> None:
+        receipt = sample_receipt_v2()
+        hashes = dict(receipt["artifact_hashes"])
+        hashes["../evil.txt"] = "d" * 64
+        receipt["artifact_hashes"] = hashes
+        receipt["artifact_tree_sha256"] = VAL.recompute_tree_hash(hashes)
+        receipt["receipt_sha256"] = VAL.receipt_body_hash(receipt)
+        errors = VAL.validate(receipt)
+        self.assertTrue(any("path-traversal" in e for e in errors))
+
+    def test_reordered_hashes_without_matching_tree_fails(self) -> None:
+        receipt = sample_receipt_v1()
+        # Swap tree hash seal integrity: change order in a way that breaks tree if unsorted —
+        # validator sorts, so reorder alone shouldn't break tree; break by corrupting one digest.
+        receipt["artifact_hashes"] = {
+            "styles.css": "b" * 64,
+            "index.html": "a" * 64,
+        }
+        # Keep old tree hash from insertion-order material that used different join — still sorted equal.
+        # Force mismatch:
+        receipt["artifact_tree_sha256"] = "e" * 64
+        errors = VAL.validate(receipt)
+        self.assertTrue(any("artifact_tree_sha256" in e or "tamper" in e for e in errors))
+
+    def test_mismatched_environment_platform_fails(self) -> None:
+        receipt = sample_receipt_v2()
+        errors = VAL.validate(receipt, expect_platform="other-os")
+        self.assertTrue(any("platform mismatch" in e for e in errors))
+
+    def test_malformed_artifact_digest_fails(self) -> None:
+        receipt = sample_receipt_v1()
+        receipt["artifact_hashes"] = {"index.html": "not-a-digest"}
+        receipt["artifact_count"] = 1
+        receipt["artifact_tree_sha256"] = VAL.recompute_tree_hash(receipt["artifact_hashes"])
+        receipt["receipt_sha256"] = VAL.receipt_body_hash(receipt)
+        errors = VAL.validate(receipt)
+        self.assertTrue(any("malformed artifact digest" in e for e in errors))
+
+    def test_artifact_count_mismatch_fails(self) -> None:
+        receipt = sample_receipt_v1()
+        receipt["artifact_count"] = 99
+        receipt["receipt_sha256"] = VAL.receipt_body_hash(receipt)
+        errors = VAL.validate(receipt)
+        self.assertTrue(any("artifact_count mismatch" in e for e in errors))
+
+    def test_cli_rejects_tampered_file(self) -> None:
+        receipt = sample_receipt_v1()
+        receipt["branch"] = "tampered-branch"
+        with tempfile.TemporaryDirectory(prefix="pch-c-receipt-") as tmp:
+            path = Path(tmp) / "receipt.json"
+            path.write_text(json.dumps(receipt), encoding="utf-8")
+            result = subprocess.run(
+                [sys.executable, str(ROOT / "scripts" / "validate_release_receipt.py"), str(path)],
+                capture_output=True,
+                text=True,
+                check=False,
+            )
+            self.assertNotEqual(result.returncode, 0)
+            self.assertIn("FAIL", result.stderr)
+
+    def test_code_tree_digest_stable_and_excludes_session_docs(self) -> None:
+        info = DIGEST.compute_code_tree_sha256(ROOT)
+        self.assertEqual(len(info["code_tree_sha256"]), 64)
+        files = info["files"]
+        self.assertTrue(any(k.startswith("scripts/") for k in files))
+        self.assertFalse(any(k.startswith("SESSION_") for k in files))
+        self.assertFalse(any("session-c-evidence" in k for k in files))
+        # Excluding a doc tip path must not require the digest to include SESSION_C_RETURN.md
+        self.assertNotIn("SESSION_C_RETURN.md", files)
+
+    def test_code_tree_filesystem_fallback_without_git(self) -> None:
+        with tempfile.TemporaryDirectory(prefix="pch-c2-digest-") as tmp:
+            root = Path(tmp)
+            (root / "scripts").mkdir()
+            (root / "scripts" / "example.py").write_text("print('x')\n", encoding="utf-8")
+            (root / "SESSION_C2_RETURN.md").write_text("doc\n", encoding="utf-8")
+            info = DIGEST.compute_code_tree_sha256(root)
+            self.assertEqual(info["source"], "filesystem-walk")
+            self.assertIn("scripts/example.py", info["files"])
+            self.assertNotIn("SESSION_C2_RETURN.md", info["files"])
+            self.assertEqual(len(info["code_tree_sha256"]), 64)
+
+    def test_code_tree_excludes_session_c3_evidence(self) -> None:
+        self.assertIn("session-c3-evidence/", DIGEST.EXCLUDE_PREFIXES)
+        with tempfile.TemporaryDirectory(prefix="pch-c3-digest-") as tmp:
+            root = Path(tmp)
+            (root / "scripts").mkdir()
+            (root / "scripts" / "x.py").write_text("x\n", encoding="utf-8")
+            evid = root / "session-c3-evidence" / "keyboard"
+            evid.mkdir(parents=True)
+            (evid / "keyboard_a11y_summary.json").write_text("{}\n", encoding="utf-8")
+            info = DIGEST.compute_code_tree_sha256(root)
+            self.assertNotIn("session-c3-evidence/keyboard/keyboard_a11y_summary.json", info["files"])
+
+
+if __name__ == "__main__":
+    unittest.main()
