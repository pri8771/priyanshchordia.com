+#!/usr/bin/env python3
+"""Semantic accessibility checks without new packages (C3 item 2).
+
+Static HTML + optional live CDP status/error focus checks.
+Not assistive-technology certification.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import re
+import sys
+from collections import Counter
+from datetime import datetime, timezone
+from html.parser import HTMLParser
+from pathlib import Path
+from typing import Any
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT / "scripts"))
+
+SITE = ROOT / "site"
+DEFAULT_EVIDENCE = ROOT / "session-c3-evidence" / "semantic"
+
+INTERACTIVE_HTML = [
+    "index.html",
+    "journal/index.html",
+    "apps/index.html",
+    "404.html",
+    "products/mala/index.html",
+    "products/anjali/index.html",
+    "products/svara/index.html",
+    "products/roam/index.html",
+    "products/hindsight/index.html",
+    "products/aurafit/index.html",
+    "apps/mala/privacy/index.html",
+    "apps/mala/support/index.html",
+    "apps/anjali/privacy/index.html",
+    "apps/anjali/support/index.html",
+    "apps/svara/privacy/index.html",
+    "apps/svara/support/index.html",
+    "apps/roam/privacy/index.html",
+    "apps/roam/support/index.html",
+    "apps/hindsight/privacy/index.html",
+    "apps/hindsight/support/index.html",
+    "apps/aurafit/privacy/index.html",
+    "apps/aurafit/support/index.html",
+]
+
+
+class SemanticParser(HTMLParser):
+    def __init__(self) -> None:
+        super().__init__(convert_charrefs=True)
+        self.lang: str | None = None
+        self.landmarks: list[dict[str, str]] = []
+        self.headings: list[tuple[int, str]] = []
+        self.ids: list[str] = []
+        self.aria_refs: list[tuple[str, str, str]] = []  # (tag, attr, value)
+        self.inputs: list[dict[str, str]] = []
+        self.images: list[dict[str, str]] = []
+        self.buttons: list[dict[str, str]] = []
+        self.links: list[dict[str, str]] = []
+        self._heading_level: int | None = None
+        self._heading_text: list[str] = []
+        self.label_for_map: dict[str, str] = {}
+        self._label_depth = 0
+        self._label_for_stack: list[str | None] = []
+        self._label_text_stack: list[list[str]] = []
+        self._wrapped_control_indexes: list[int] = []  # input indexes named by wrapping label
+        self._open_stack: list[str] = []
+
+    def handle_starttag(self, tag: str, attrs: list[tuple[str, str | None]]) -> None:
+        values = {k: (v or "") for k, v in attrs}
+        self._open_stack.append(tag)
+        if tag == "html" and values.get("lang"):
+            self.lang = values["lang"]
+        if "id" in values and values["id"]:
+            self.ids.append(values["id"])
+        role = values.get("role", "")
+        if tag in {"main", "nav", "header", "footer", "aside", "form", "search"} or role in {
+            "main",
+            "navigation",
+            "banner",
+            "contentinfo",
+            "complementary",
+            "form",
+            "search",
+        }:
+            self.landmarks.append(
+                {
+                    "tag": tag,
+                    "role": role,
+                    "id": values.get("id", ""),
+                    "aria-label": values.get("aria-label", ""),
+                    "aria-labelledby": values.get("aria-labelledby", ""),
+                }
+            )
+        if tag in {"h1", "h2", "h3", "h4", "h5", "h6"}:
+            self._heading_level = int(tag[1])
+            self._heading_text = []
+        for attr in ("aria-labelledby", "aria-describedby", "aria-controls", "aria-owns", "for"):
+            if values.get(attr):
+                self.aria_refs.append((tag, attr if attr != "for" else "for", values[attr]))
+        if tag == "label":
+            self._label_depth += 1
+            self._label_for_stack.append(values.get("for") or None)
+            self._label_text_stack.append([])
+        if tag in {"input", "textarea", "select"}:
+            idx = len(self.inputs)
+            self.inputs.append(
+                {
+                    "tag": tag,
+                    "type": values.get("type", "text" if tag == "input" else tag),
+                    "id": values.get("id", ""),
+                    "name": values.get("name", ""),
+                    "aria-label": values.get("aria-label", ""),
+                    "aria-labelledby": values.get("aria-labelledby", ""),
+                    "aria-describedby": values.get("aria-describedby", ""),
+                    "title": values.get("title", ""),
+                    "placeholder": values.get("placeholder", ""),
+                    "wrapped_label": "1" if self._label_depth > 0 else "",
+                }
+            )
+            if self._label_depth > 0:
+                self._wrapped_control_indexes.append(idx)
+        if tag == "img":
+            self.images.append(
+                {
+                    "src": values.get("src", ""),
+                    "alt": values["alt"] if "alt" in values else "__MISSING__",
+                    "role": values.get("role", ""),
+                }
+            )
+        if tag == "button":
+            self.buttons.append(
+                {
+                    "id": values.get("id", ""),
+                    "aria-label": values.get("aria-label", ""),
+                    "type": values.get("type", "submit"),
+                }
+            )
+        if tag == "a":
+            self.links.append(
+                {
+                    "href": values.get("href", ""),
+                    "aria-label": values.get("aria-label", ""),
+                    "cls": values.get("class", ""),
+                }
+            )
+
+    def handle_endtag(self, tag: str) -> None:
+        if tag in {"h1", "h2", "h3", "h4", "h5", "h6"} and self._heading_level:
+            text = "".join(self._heading_text).strip()
+            self.headings.append((self._heading_level, text))
+            self._heading_level = None
+            self._heading_text = []
+        if tag == "label" and self._label_depth > 0:
+            text = "".join(self._label_text_stack.pop()).strip() if self._label_text_stack else ""
+            for_id = self._label_for_stack.pop() if self._label_for_stack else None
+            if for_id:
+                self.label_for_map[for_id] = text
+            self._label_depth -= 1
+        if self._open_stack and self._open_stack[-1] == tag:
+            self._open_stack.pop()
+        elif tag in self._open_stack:
+            while self._open_stack and self._open_stack[-1] != tag:
+                self._open_stack.pop()
+            if self._open_stack:
+                self._open_stack.pop()
+
+    def handle_data(self, data: str) -> None:
+        if self._heading_level is not None:
+            self._heading_text.append(data)
+        if self._label_depth > 0 and self._label_text_stack:
+            self._label_text_stack[-1].append(data)
+
+
+
+def analyze_page(rel: str, html: str) -> dict[str, Any]:
+    parser = SemanticParser()
+    parser.feed(html)
+    issues: list[str] = []
+
+    if not parser.lang:
+        issues.append("missing html lang")
+
+    # Landmarks: at least one main; nav should be named when present.
+    mains = [l for l in parser.landmarks if l["tag"] == "main" or l["role"] == "main"]
+    if len(mains) != 1:
+        issues.append(f"expected exactly one main landmark, found {len(mains)}")
+    navs = [l for l in parser.landmarks if l["tag"] == "nav" or l["role"] == "navigation"]
+    for nav in navs:
+        if not (nav["aria-label"] or nav["aria-labelledby"] or nav["id"]):
+            issues.append("nav landmark missing accessible name")
+
+    # Heading consistency: at least one h1; no skips > 1 level.
+    if not parser.headings:
+        issues.append("no headings found")
+    else:
+        if parser.headings[0][0] != 1 and not any(level == 1 for level, _ in parser.headings):
+            issues.append("missing h1")
+        prev = parser.headings[0][0]
+        for level, _text in parser.headings[1:]:
+            if level > prev + 1:
+                issues.append(f"heading level skip {prev} -> {level}")
+                break
+            prev = level
+
+    # Duplicate IDs
+    counts = Counter(parser.ids)
+    dupes = sorted(i for i, n in counts.items() if n > 1)
+    if dupes:
+        issues.append(f"duplicate ids: {', '.join(dupes[:8])}")
+
+    id_set = set(parser.ids)
+    # Invalid ARIA / for references
+    for tag, attr, value in parser.aria_refs:
+        refs = [v for v in re.split(r"\s+", value.strip()) if v]
+        for ref in refs:
+            if ref not in id_set:
+                issues.append(f"invalid {attr} reference '{ref}' on <{tag}>")
+
+    # Form controls need names (explicit label for=/aria/title OR wrapping <label>).
+    for inp in parser.inputs:
+        if inp["type"] in {"hidden", "submit", "button", "reset", "image"}:
+            continue
+        named = bool(
+            inp["aria-label"]
+            or inp["aria-labelledby"]
+            or inp["title"]
+            or (inp["id"] and inp["id"] in parser.label_for_map)
+            or inp.get("wrapped_label")
+        )
+        if not named:
+            issues.append(
+                f"input name={inp['name']!r} id={inp['id']!r} missing accessible name association"
+            )
+
+    # Images need alt (empty alt ok for decorative).
+    for img in parser.images:
+        if img["alt"] == "__MISSING__":
+            issues.append(f"img missing alt: {img['src'][:80]}")
+
+    # Waitlist form error association contract on product pages.
+    if rel.startswith("products/") and "data-waitlist" in html:
+        if "aria-describedby" not in html:
+            issues.append("waitlist form missing aria-describedby")
+        if "aria-live" not in html:
+            issues.append("waitlist status missing aria-live")
+        if 'tabindex="-1"' not in html:
+            issues.append("waitlist status missing tabindex=-1 for focus")
+
+    return {
+        "path": rel,
+        "lang": parser.lang,
+        "landmark_count": len(parser.landmarks),
+        "main_count": len(mains),
+        "heading_outline": [f"h{level}:{text[:40]}" for level, text in parser.headings[:12]],
+        "id_count": len(parser.ids),
+        "duplicate_ids": dupes,
+        "input_count": len(parser.inputs),
+        "issues": issues,
+        "ok": not issues,
+    }
+
+
+def run_live_waitlist_status_focus(site: Path) -> dict[str, Any]:
+    """CDP check: form error/status receives focus (demonstrates status/error focus)."""
+    from cdp_client import start_chrome_session, start_loopback_http, stop_process_group
+
+    server = None
+    session = None
+    try:
+        server, _port, base = start_loopback_http(site)
+        session = start_chrome_session()
+        session.navigate(f"{base}/products/anjali/")
+        session.evaluate(
+            """(() => new Promise((resolve) => {
+              const start = performance.now();
+              const tick = () => {
+                if (document.querySelector('form[data-waitlist]')) return resolve(true);
+                if (performance.now() - start > 3000) return resolve(false);
+                requestAnimationFrame(tick);
+              };
+              tick();
+            }))()""",
+            await_promise=True,
+        )
+        result = session.evaluate(
+            """(() => {
+              const form = document.querySelector('form[data-waitlist]');
+              const status = form && form.querySelector('.waitlist-status');
+              const email = form && form.elements.email;
+              if (!form || !status || !email) return {ok:false, reason:'missing'};
+              email.value = '';
+              const consent = form.elements.consent;
+              if (consent) consent.checked = false;
+              form.requestSubmit ? form.requestSubmit() : form.dispatchEvent(new Event('submit', {bubbles:true, cancelable:true}));
+              return {
+                ok: true,
+                focused_status: document.activeElement === status,
+                ariaInvalid: email.getAttribute('aria-invalid'),
+                describedby: email.getAttribute('aria-describedby'),
+                statusText: (status.textContent || '').slice(0, 120),
+              };
+            })()"""
+        )
+        ok = bool(
+            result
+            and result.get("ok")
+            and result.get("focused_status")
+            and result.get("ariaInvalid") == "true"
+            and result.get("describedby")
+        )
+        return {"ok": ok, "detail": result, "boundary": "live CDP status/error focus; not AT cert"}
+    finally:
+        if session is not None:
+            session.close()
+        if server is not None:
+            stop_process_group(server)
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--site", type=Path, default=SITE)
+    parser.add_argument("--evidence", type=Path, default=DEFAULT_EVIDENCE)
+    parser.add_argument("--skip-live", action="store_true")
+    args = parser.parse_args()
+
+    if not args.site.is_dir():
+        print(f"site missing: {args.site}", file=sys.stderr)
+        return 2
+
+    args.evidence.mkdir(parents=True, exist_ok=True)
+    pages: list[dict[str, Any]] = []
+    for rel in INTERACTIVE_HTML:
+        path = args.site / rel
+        if not path.is_file():
+            pages.append({"path": rel, "ok": False, "issues": ["file missing"]})
+            continue
+        pages.append(analyze_page(rel, path.read_text(encoding="utf-8")))
+
+    live: dict[str, Any] | None = None
+    if not args.skip_live:
+        try:
+            live = run_live_waitlist_status_focus(args.site)
+        except Exception as exc:  # noqa: BLE001
+            live = {"ok": False, "error": str(exc)}
+
+    failed_pages = [p for p in pages if not p["ok"]]
+    summary = {
+        "started_at": datetime.now(timezone.utc).isoformat(),
+        "finished_at": datetime.now(timezone.utc).isoformat(),
+        "boundary": (
+            "Semantic HTML/ARIA static checks + optional CDP status focus. "
+            "Not assistive-technology certification."
+        ),
+        "page_count": len(pages),
+        "pages": pages,
+        "failed_pages": [p["path"] for p in failed_pages],
+        "live_status_focus": live,
+        "ok": not failed_pages and (live is None or live.get("ok")),
+    }
+    out = args.evidence / "semantic_a11y_summary.json"
+    out.write_text(json.dumps(summary, indent=2) + "\n", encoding="utf-8")
+    print(
+        json.dumps(
+            {
+                "ok": summary["ok"],
+                "failed_pages": summary["failed_pages"],
+                "live_ok": None if live is None else live.get("ok"),
+                "summary": str(out),
+            },
+            indent=2,
+        )
+    )
+    return 0 if summary["ok"] else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
