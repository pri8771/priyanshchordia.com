+# Representative routes for heavier edge-case probes (every route still gets core cases).
+STORAGE_SAMPLE_ROUTES = ["/", "/products/mala/", "/apps/mala/privacy/", "/404.html"]
+QUERY_SAMPLE_ROUTES = ["/", "/journal/", "/products/svara/", "/apps/roam/support/", "/404.html"]
