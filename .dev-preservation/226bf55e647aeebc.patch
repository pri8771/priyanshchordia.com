index 0000000..74eb70e
--- /dev/null
+++ b/scripts/validate_release_receipt.py
@@ -0,0 +1,201 @@
+#!/usr/bin/env python3
+"""Validate a release receipt (C2 Lane 4).
+
+Supports v1 (Session C) and v2 (code-tree bound) receipts.
+Fails closed on stale, partial, mismatched, tampered, path-traversal,
+replayed/reordered-hash, and mismatched-environment receipts.
+"""
+
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import re
+import sys
+from pathlib import Path
+from typing import Any
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT / "scripts"))
+from code_tree_digest import compute_code_tree_sha256  # noqa: E402
+
+
+REQUIRED_FIELDS_V1 = {
+    "schema",
+    "started_at",
+    "finished_at",
+    "ok",
+    "source_sha",
+    "worktree",
+    "branch",
+    "environment",
+    "artifact_count",
+    "artifact_tree_sha256",
+    "artifact_hashes",
+    "steps",
+    "known_limitations",
+    "receipt_sha256",
+}
+
+REQUIRED_FIELDS_V2 = REQUIRED_FIELDS_V1 | {
+    "code_tree_sha256",
+    "git_head_at_check",
+}
+
+
+def sha256_bytes(data: bytes) -> str:
+    return hashlib.sha256(data).hexdigest()
+
+
+def recompute_tree_hash(artifact_hashes: dict[str, str]) -> str:
+    material = "\n".join(f"{digest}  {rel}" for rel, digest in sorted(artifact_hashes.items())) + "\n"
+    return sha256_bytes(material.encode("utf-8"))
+
+
+def receipt_body_hash(receipt: dict[str, Any]) -> str:
+    body = {key: value for key, value in receipt.items() if key != "receipt_sha256"}
+    canonical = json.dumps(body, sort_keys=True, separators=(",", ":")).encode("utf-8")
+    return sha256_bytes(canonical)
+
+
+def _path_traversal(rel: str) -> bool:
+    if rel.startswith("/") or rel.startswith("\\"):
+        return True
+    parts = rel.replace("\\", "/").split("/")
+    return any(part == ".." for part in parts)
+
+
+def validate(
+    receipt: dict[str, Any],
+    *,
+    expect_sha: str | None = None,
+    expect_code_tree: str | None = None,
+    recompute_code_tree: bool = False,
+    expect_platform: str | None = None,
+) -> list[str]:
+    errors: list[str] = []
+    schema = receipt.get("schema")
+    required = REQUIRED_FIELDS_V2 if schema == "priyanshchordia.release_receipt.v2" else REQUIRED_FIELDS_V1
+    missing = sorted(required - set(receipt))
+    if missing:
+        errors.append(f"partial receipt; missing fields: {', '.join(missing)}")
+        return errors
+
+    if schema not in ("priyanshchordia.release_receipt.v1", "priyanshchordia.release_receipt.v2"):
+        errors.append(f"unexpected schema: {schema!r}")
+
+    if not isinstance(receipt.get("artifact_hashes"), dict) or not receipt["artifact_hashes"]:
+        errors.append("artifact_hashes missing or empty")
+
+    if not isinstance(receipt.get("steps"), list) or not receipt["steps"]:
+        errors.append("steps missing or empty")
+
+    if expect_sha and receipt.get("source_sha") != expect_sha:
+        errors.append(
+            f"source_sha mismatch: receipt={receipt.get('source_sha')} expected={expect_sha}"
+        )
+
+    hashes = receipt.get("artifact_hashes") or {}
+    if isinstance(hashes, dict) and hashes:
+        digest_re = re.compile(r"^[0-9a-f]{64}$")
+        for rel, digest in hashes.items():
+            if _path_traversal(str(rel)):
+                errors.append(f"path-traversal artifact key: {rel!r}")
+            if not isinstance(digest, str) or not digest_re.match(digest):
+                errors.append(f"malformed artifact digest for {rel!r}")
+            if not str(rel).strip() or "\0" in str(rel) or any(
+                ch in str(rel) for ch in ("\n", "\r")
+            ):
+                errors.append(f"suspicious artifact key: {rel!r}")
+        if receipt.get("artifact_count") != len(hashes):
+            errors.append(
+                f"artifact_count mismatch: receipt={receipt.get('artifact_count')} hashes={len(hashes)}"
+            )
+        # Sorted recompute detects reordering attempts that changed seal without matching tree.
+        tree = recompute_tree_hash({str(k): str(v) for k, v in hashes.items()})
+        if tree != receipt.get("artifact_tree_sha256"):
+            errors.append("artifact_tree_sha256 does not match artifact_hashes")
+
+    if schema == "priyanshchordia.release_receipt.v2":
+        code_tree = receipt.get("code_tree_sha256")
+        if not code_tree or not isinstance(code_tree, str) or len(code_tree) != 64:
+            errors.append("code_tree_sha256 missing or malformed")
+        if expect_code_tree and code_tree != expect_code_tree:
+            errors.append(
+                f"code_tree_sha256 mismatch: receipt={code_tree} expected={expect_code_tree}"
+            )
+        if recompute_code_tree:
+            live = compute_code_tree_sha256(ROOT)["code_tree_sha256"]
+            if live != code_tree:
+                errors.append(
+                    f"code_tree_sha256 stale vs live worktree: receipt={code_tree} live={live}"
+                )
+
+    if expect_platform:
+        env = receipt.get("environment") or {}
+        platform = env.get("platform") if isinstance(env, dict) else None
+        if platform != expect_platform:
+            errors.append(f"environment platform mismatch: receipt={platform!r} expected={expect_platform!r}")
+
+    try:
+        actual = receipt_body_hash(receipt)
+        if actual != receipt.get("receipt_sha256"):
+            errors.append("receipt_sha256 tamper check failed")
+    except (TypeError, ValueError) as exc:
+        errors.append(f"cannot hash receipt body: {exc}")
+
+    if receipt.get("ok") is not True:
+        errors.append("receipt.ok is not true")
+
+    return errors
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("receipt", type=Path)
+    parser.add_argument("--expect-sha", default=None, help="Optional git tip/source_sha check")
+    parser.add_argument(
+        "--expect-code-tree",
+        default=None,
+        help="Preferred binding: expect code_tree_sha256 (avoids doc-tip loops)",
+    )
+    parser.add_argument(
+        "--recompute-code-tree",
+        action="store_true",
+        help="Recompute live code_tree_sha256 from this worktree and require match",
+    )
+    parser.add_argument("--expect-platform", default=None)
+    args = parser.parse_args()
+
+    if not args.receipt.is_file():
+        print(f"receipt not found: {args.receipt}", file=sys.stderr)
+        return 2
+
+    try:
+        receipt = json.loads(args.receipt.read_text(encoding="utf-8"))
+    except json.JSONDecodeError as exc:
+        print(f"invalid JSON: {exc}", file=sys.stderr)
+        return 1
+
+    if not isinstance(receipt, dict):
+        print("receipt must be a JSON object", file=sys.stderr)
+        return 1
+
+    errors = validate(
+        receipt,
+        expect_sha=args.expect_sha,
+        expect_code_tree=args.expect_code_tree,
+        recompute_code_tree=args.recompute_code_tree,
+        expect_platform=args.expect_platform,
+    )
+    if errors:
+        for err in errors:
+            print(f"FAIL: {err}", file=sys.stderr)
+        return 1
+    print("OK: receipt valid")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
