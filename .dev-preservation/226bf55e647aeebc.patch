+#!/usr/bin/env node
+"use strict";
+
+/**
+ * Mocked-DOM contracts for experience a11y helpers extracted from common.js.
+ * Not a real browser AT pass — complements Chrome headless probe evidence.
+ */
+
+const assert = require("node:assert/strict");
+const fs = require("node:fs");
+const path = require("node:path");
+const test = require("node:test");
+const vm = require("node:vm");
+
+const COMMON = fs.readFileSync(
+  path.resolve(__dirname, "../scripts/experiences/common.js"),
+  "utf8"
+);
+
+function extractFunction(source, name) {
+  const start = source.indexOf(`function ${name}`);
+  assert.ok(start >= 0, `missing ${name}`);
+  let i = source.indexOf("{", start);
+  let depth = 0;
+  for (; i < source.length; i += 1) {
+    if (source[i] === "{") depth += 1;
+    else if (source[i] === "}") {
+      depth -= 1;
+      if (depth === 0) {
+        return source.slice(start, i + 1);
+      }
+    }
+  }
+  throw new Error(`unclosed ${name}`);
+}
+
+function loadHelpers() {
+  const body = [
+    extractFunction(COMMON, "dialogFocusables"),
+    extractFunction(COMMON, "trapDialogTab"),
+    "module.exports = { dialogFocusables, trapDialogTab };",
+  ].join("\n");
+  const sandbox = { module: { exports: {} }, exports: {}, document: {}, console };
+  vm.runInNewContext(body, sandbox);
+  return sandbox.module.exports;
+}
+
+test("dialogFocusables filters disabled and negative tabindex", () => {
+  const { dialogFocusables } = loadHelpers();
+  const nodes = [
+    { offsetParent: {}, matches: null },
+  ];
+  // Build a minimal dialog-like object
+  const dialog = {
+    querySelectorAll(sel) {
+      assert.match(sel, /tabindex/);
+      return [
+        { offsetParent: {}, tag: "button" },
+        { offsetParent: null, tag: "hidden-btn" },
+      ];
+    },
+  };
+  const result = dialogFocusables(dialog);
+  assert.equal(result.length, 1);
+});
+
+test("trapDialogTab wraps focus from last to first", () => {
+  const { trapDialogTab } = loadHelpers();
+  const first = { id: "first" };
+  const last = { id: "last", focusCount: 0, focus() { this.focusCount += 1; } };
+  const dialog = {
+    querySelectorAll() {
+      return [
+        { ...first, offsetParent: {}, focus() {} },
+        { ...last, offsetParent: {} },
+      ];
+    },
+  };
+  // Re-build with proper focus methods
+  const a = { id: "a", offsetParent: {}, focus() { this.focused = true; } };
+  const b = { id: "b", offsetParent: {}, focus() { this.focused = true; } };
+  const d = {
+    querySelectorAll() {
+      return [a, b];
+    },
+  };
+  const helpers = loadHelpers();
+  // Patch document.activeElement
+  const sandboxDoc = { activeElement: b };
+  // trapDialogTab uses document.activeElement from outer common closure —
+  // extracted function references document from sandbox. Rebuild with document.
+  const body = [
+    "var document = globalDocument;",
+    extractFunction(COMMON, "dialogFocusables"),
+    extractFunction(COMMON, "trapDialogTab"),
+    "module.exports = { dialogFocusables, trapDialogTab };",
+  ].join("\n");
+  const module = { exports: {} };
+  vm.runInNewContext(body, { module, exports: module.exports, globalDocument: sandboxDoc });
+  const { trapDialogTab: trap } = module.exports;
+  let prevented = false;
+  trap(d, {
+    key: "Tab",
+    shiftKey: false,
+    preventDefault() {
+      prevented = true;
+    },
+  });
+  assert.equal(prevented, true);
+  assert.equal(a.focused, true);
+});
+
+test("waitlist status is focusable target pattern in product markup", () => {
+  const root = path.resolve(__dirname, "../site/products");
+  const apps = JSON.parse(
+    fs.readFileSync(path.resolve(__dirname, "../data/apps.json"), "utf8"),
+  ).apps;
+  const storeBySlug = Object.fromEntries(
+    apps.map((app) => [app.slug, app.app_store_id]),
+  );
+  let waitlistPages = 0;
+  for (const dir of fs.readdirSync(root)) {
+    const html = fs.readFileSync(path.join(root, dir, "index.html"), "utf8");
+    if (storeBySlug[dir]) {
+      assert.match(html, /apps\.apple\.com\/app\/id/);
+      assert.doesNotMatch(html, /data-waitlist/);
+      continue;
+    }
+    waitlistPages += 1;
+    assert.match(html, /tabindex="-1"/);
+    assert.match(html, /waitlist-status/);
+    assert.match(html, /aria-live/);
+  }
+  assert.ok(waitlistPages >= 1, "expected at least one waitlist product page");
+});
