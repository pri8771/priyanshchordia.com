+++ b/scripts/release_receipt_hardening.py
@@ -0,0 +1,241 @@
+#!/usr/bin/env python3
+"""Release receipt hardening checks (C4 Lane 9).
+
+Extends v2 receipt validation with artifact allowlists, symlink/path containment,
+staleness heuristics, tool provenance fields, and missing-browser behavior
+without publishing. Prefer code_tree binding over tip SHA equality.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import os
+import sys
+from datetime import datetime, timezone
+from pathlib import Path
+from typing import Any
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT / "scripts"))
+
+from code_tree_digest import compute_code_tree_sha256  # noqa: E402
+from validate_release_receipt import (  # noqa: E402
+    receipt_body_hash,
+    recompute_tree_hash,
+    validate,
+)
+from cdp_client import ChromeDiscoveryError, chrome_discovery_report, discover_chrome  # noqa: E402
+
+DEFAULT_EVIDENCE = ROOT / "session-c4-evidence" / "receipt"
+DEFAULT_RECEIPT = ROOT / "session-c4-evidence" / "release_receipt.json"
+
+# Allowlisted relative artifact prefixes/suffixes inside a sealed receipt.
+ALLOWED_ARTIFACT_PREFIXES = (
+    "site/",
+    "scripts/",
+    "tests/",
+    "data/",
+    "content/",
+    "docs/",
+    "session-c4-evidence/",
+    "session-c3-evidence/",
+    "session-c2-evidence/",
+    "session-c-evidence/",
+)
+ALLOWED_ROOT_FILES = {
+    "README.md",
+    "COLLAB.md",
+    "CNAME",
+    ".gitignore",
+}
+
+
+def artifact_allowlist_errors(artifact_hashes: dict[str, str]) -> list[str]:
+    errors: list[str] = []
+    for rel in artifact_hashes:
+        norm = str(rel).replace("\\", "/")
+        if norm in ALLOWED_ROOT_FILES:
+            continue
+        if any(norm.startswith(prefix) for prefix in ALLOWED_ARTIFACT_PREFIXES):
+            continue
+        # allow bare site filenames that appear in older receipts
+        if "/" not in norm and norm.endswith((".html", ".css", ".js", ".txt", ".xml", ".png", ".json", ".md")):
+            continue
+        errors.append(f"artifact not on allowlist: {norm}")
+    return errors
+
+
+def symlink_containment_errors(root: Path) -> list[str]:
+    """Fail if tracked-looking symlinks escape the worktree."""
+    errors: list[str] = []
+    root = root.resolve()
+    for path in root.rglob("*"):
+        if not path.is_symlink():
+            continue
+        # Skip common cache dirs
+        parts = set(path.relative_to(root).parts)
+        if parts & {"__pycache__", ".git", "node_modules"}:
+            continue
+        try:
+            target = path.resolve()
+        except OSError as exc:
+            errors.append(f"symlink unresolvable: {path.relative_to(root)} ({exc})")
+            continue
+        try:
+            target.relative_to(root)
+        except ValueError:
+            errors.append(f"symlink escapes worktree: {path.relative_to(root)} -> {target}")
+    return errors
+
+
+def missing_browser_case() -> dict[str, Any]:
+    """Demonstrate actionable failure when Chrome path is forced missing."""
+    bogus = "/tmp/pch-c4-definitely-missing-chrome-binary"
+    try:
+        discover_chrome(override=bogus, require=True)
+        return {"name": "missing_browser_override", "ok": False, "detail": "expected failure"}
+    except ChromeDiscoveryError as exc:
+        text = str(exc)
+        ok = "Tried:" in text and "PCH_CHROME_PATH" in text and bogus in text
+        return {"name": "missing_browser_override", "ok": ok, "detail": text[:500]}
+
+
+def harden_validate(
+    receipt: dict[str, Any],
+    *,
+    recompute_code_tree: bool = True,
+) -> dict[str, Any]:
+    errors = validate(receipt, recompute_code_tree=recompute_code_tree)
+    errors.extend(artifact_allowlist_errors(receipt.get("artifact_hashes") or {}))
+    env = receipt.get("environment") or {}
+    if not isinstance(env, dict):
+        errors.append("environment must be object")
+    else:
+        for key in ("python", "platform"):
+            if not env.get(key):
+                errors.append(f"environment missing {key}")
+    return {"ok": not errors, "errors": errors}
+
+
+def build_minimal_sealed_receipt(*, source_sha: str, code_tree: str, branch: str) -> dict[str, Any]:
+    """Build a small valid v2 receipt for local hardening demos (not a full release_check)."""
+    hashes = {
+        "site/index.html": "a" * 64,
+        "scripts/local_verify.py": "b" * 64,
+        "session-c4-evidence/receipt/hardening_summary.json": "c" * 64,
+    }
+    receipt: dict[str, Any] = {
+        "schema": "priyanshchordia.release_receipt.v2",
+        "purpose": "HARNESS_SELF_TEST_ONLY_NOT_A_RELEASE_RECEIPT",
+        "started_at": datetime.now(timezone.utc).isoformat(),
+        "finished_at": datetime.now(timezone.utc).isoformat(),
+        "ok": True,
+        "source_sha": source_sha,
+        "git_head_at_check": source_sha,
+        "code_tree_sha256": code_tree,
+        "worktree": str(ROOT),
+        "branch": branch,
+        "environment": {
+            "python": sys.version.split()[0],
+            "platform": sys.platform,
+            "chrome": chrome_discovery_report().get("resolved"),
+        },
+        "artifact_count": len(hashes),
+        "artifact_hashes": hashes,
+        "artifact_tree_sha256": recompute_tree_hash(hashes),
+        "steps": [{"name": "c4-hardening", "ok": True, "exit_code": 0}],
+        "known_limitations": [
+            "SAMPLE ONLY — dummy artifact digests; not a release seal.",
+            "Full seal via release_check/local_verify under session-c4-evidence/release_receipt.json.",
+            "Local only; never publish.",
+        ],
+    }
+    receipt["receipt_sha256"] = receipt_body_hash(receipt)
+    return receipt
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--evidence", type=Path, default=DEFAULT_EVIDENCE)
+    parser.add_argument("--receipt", type=Path, default=None, help="Optional existing receipt to harden-validate")
+    args = parser.parse_args()
+    args.evidence.mkdir(parents=True, exist_ok=True)
+
+    cases: list[dict[str, Any]] = []
+    digest = compute_code_tree_sha256(ROOT)
+    code_tree = digest["code_tree_sha256"]
+
+    # Symlink containment on worktree
+    sym_errs = symlink_containment_errors(ROOT)
+    cases.append({"name": "symlink_containment", "ok": not sym_errs, "errors": sym_errs})
+
+    # Missing browser actionable path
+    cases.append(missing_browser_case())
+
+    # Allowlist rejects escape
+    bad_hashes = {"../../etc/passwd": "d" * 64, "site/index.html": "a" * 64}
+    allow_errs = artifact_allowlist_errors(bad_hashes)
+    cases.append(
+        {
+            "name": "allowlist_rejects_escape",
+            "ok": any("not on allowlist" in e for e in allow_errs),
+            "errors": allow_errs,
+        }
+    )
+
+    # Validate provided or sample receipt
+    if args.receipt and args.receipt.is_file():
+        receipt = json.loads(args.receipt.read_text(encoding="utf-8"))
+        # Prefer recompute only when receipt claims this worktree's code tree.
+        result = harden_validate(receipt, recompute_code_tree=True)
+        cases.append({"name": "harden_validate_provided_receipt", **result})
+    else:
+        # Sample sealed receipt with live code tree — validate without requiring full artifact files.
+        import subprocess
+
+        sha = subprocess.check_output(["git", "rev-parse", "HEAD"], cwd=str(ROOT), text=True).strip()
+        branch = subprocess.check_output(
+            ["git", "branch", "--show-current"], cwd=str(ROOT), text=True
+        ).strip()
+        sample = build_minimal_sealed_receipt(source_sha=sha, code_tree=code_tree, branch=branch)
+        # validate() with recompute should pass for matching code_tree
+        result = harden_validate(sample, recompute_code_tree=True)
+        cases.append({"name": "harden_validate_sample_receipt", **result})
+        sample_path = args.evidence / "sample_hardening_receipt.json"
+        sample_path.write_text(json.dumps(sample, indent=2) + "\n", encoding="utf-8")
+
+    # Staleness: mutate code_tree expectation
+    stale = build_minimal_sealed_receipt(
+        source_sha="0" * 40,
+        code_tree="f" * 64,
+        branch="stale",
+    )
+    stale_result = harden_validate(stale, recompute_code_tree=True)
+    cases.append(
+        {
+            "name": "stale_code_tree_detected",
+            "ok": not stale_result["ok"]
+            and any("stale" in e or "mismatch" in e for e in stale_result["errors"]),
+            "errors": stale_result["errors"],
+        }
+    )
+
+    summary = {
+        "schema": "priyanshchordia.receipt_hardening.v1",
+        "started_at": datetime.now(timezone.utc).isoformat(),
+        "finished_at": datetime.now(timezone.utc).isoformat(),
+        "code_tree_sha256": code_tree,
+        "cases": cases,
+        "ok": all(c.get("ok") for c in cases),
+        "boundary": "Local receipt hardening only; never publish.",
+        "chrome_report": chrome_discovery_report(),
+    }
+    out = args.evidence / "hardening_summary.json"
+    out.write_text(json.dumps(summary, indent=2) + "\n", encoding="utf-8")
+    print(json.dumps({"ok": summary["ok"], "failed": [c["name"] for c in cases if not c.get("ok")], "summary": str(out)}, indent=2))
+    return 0 if summary["ok"] else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
