+<meta property="og:url" content="https://priyanshchordia.com/apps/mala/privacy/"><meta property="og:image" content="https://priyanshchordia.com/og-five-apps.png"><meta property="og:image:width" content="1200"><meta property="og:image:height" content="630"><meta property="og:image:alt" content="Abstract marks for the independent iOS catalogue: Mala, Anjali, Svara, Roam, Hindsight, and AuraFit."><meta name="twitter:image" content="https://priyanshchordia.com/og-five-apps.png"><meta name="twitter:image:alt" content="Abstract marks for the independent iOS catalogue: Mala, Anjali, Svara, Roam, Hindsight, and AuraFit.">
+<meta name="twitter:card" content="summary_large_image"><meta name="twitter:title" content="Mala privacy policy — priyanshchordia.com">
+<meta name="twitter:description" content="Privacy information for Mala.">
+<title>Mala privacy policy — priyanshchordia.com</title><link rel="icon" href="data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%2032%2032'%3E%3Crect%20width='32'%20height='32'%20rx='7'%20fill='%23141414'/%3E%3Ccircle%20cx='16'%20cy='16'%20r='6'%20fill='%23d7ff4a'/%3E%3C/svg%3E" type="image/svg+xml">
