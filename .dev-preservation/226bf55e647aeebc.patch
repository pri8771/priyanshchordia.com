+    session.evaluate("history.back()")
+    session.evaluate("(() => new Promise(r => setTimeout(r, 250)))()", await_promise=True)
+    session.evaluate("history.forward()")
+    session.evaluate("(() => new Promise(r => setTimeout(r, 250)))()", await_promise=True)
+    reset_focus_to_start(session)
+    session.tab()
+    hist_focus = session.evaluate(FOCUS_PROBE)
