@@ -0,0 +1,221 @@
+#!/usr/bin/env python3
+"""Expanded visual/responsive regression evidence (C4 Lane 8).
+
+Extends route/viewport coverage with stable structural signals and explicit
+tolerances. Avoids fragile pixel-perfect goldens. Does not redesign the site.
+"""
+
+from __future__ import annotations
+
+import argparse
+import base64
+import hashlib
+import json
+import sys
+from datetime import datetime, timezone
+from pathlib import Path
+from typing import Any
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT / "scripts"))
+
+from cdp_client import start_chrome_session, start_loopback_http, stop_process_group  # noqa: E402
+
+SITE = ROOT / "site"
+DEFAULT_EVIDENCE = ROOT / "session-c4-evidence" / "visual"
+
+# Broader than C2 visual suite: products + legal + primary hubs.
+ROUTES = [
+    "/",
+    "/journal/",
+    "/apps/",
+    "/products/mala/",
+    "/products/anjali/",
+    "/products/svara/",
+    "/products/roam/",
+    "/products/hindsight/",
+    "/products/aurafit/",
+    "/apps/mala/privacy/",
+    "/apps/mala/support/",
+    "/404.html",
+]
+
+VIEWPORTS = [
+    ("desktop", 1280, 800, False),
+    ("tablet", 768, 1024, True),
+    ("mobile", 375, 812, True),
+]
+
+
+def sha256_bytes(data: bytes) -> str:
+    return hashlib.sha256(data).hexdigest()
+
+
+def capture(
+    session,
+    base: str,
+    path: str,
+    viewport: str,
+    width: int,
+    height: int,
+    mobile: bool,
+    out_dir: Path,
+    *,
+    take_screenshot: bool,
+) -> dict[str, Any]:
+    session.set_viewport(width, height, mobile=mobile)
+    session.navigate(base + path, settle_ms=800)
+    signals = session.evaluate(
+        """(() => {
+          const pageMain = document.getElementById('main');
+          const main = pageMain || document.querySelector('main');
+          const body = document.body;
+          const html = document.documentElement;
+          const overflowX = Math.max(body.scrollWidth, html.scrollWidth) > (window.innerWidth + 2);
+          const textLen = main ? (main.innerText || '').trim().length : 0;
+          const brokenImages = Array.from(document.images)
+            .filter(img => img.complete && img.naturalWidth === 0)
+            .map(img => img.getAttribute('src') || '');
+          const h1 = document.querySelector('h1');
+          return {
+            title: document.title || '',
+            hasMain: !!main,
+            mainTextLen: textLen,
+            overflowX,
+            brokenImages,
+            h1Text: h1 ? (h1.innerText || '').trim().slice(0, 80) : null,
+            theme: html.getAttribute('data-theme'),
+            viewport: {w: window.innerWidth, h: window.innerHeight},
+          };
+        })()"""
+    )
+    errors: list[str] = []
+    if not signals or not signals.get("hasMain"):
+        errors.append("missing main")
+    if signals and signals.get("mainTextLen", 0) < 8 and path != "/404.html":
+        # 404 may be short; hubs/products should have content.
+        if path not in {"/404.html"}:
+            errors.append("main text too short")
+    if signals and signals.get("brokenImages"):
+        errors.append(f"broken images: {signals['brokenImages'][:3]}")
+    # Soft overflow note: experience themes may intentionally widen; flag but only fail if extreme.
+    overflow_fail = bool(signals and signals.get("overflowX") and width <= 400)
+    if overflow_fail:
+        errors.append("horizontal overflow on mobile-width viewport")
+
+    png_hash = None
+    png_size = None
+    png_path = None
+    if take_screenshot:
+        slug = path.strip("/").replace("/", "_") or "home"
+        png_path = out_dir / f"{slug}__{viewport}.png"
+        shot = session.call("Page.captureScreenshot", {"format": "png", "fromSurface": True})
+        data = base64.b64decode(shot["data"])
+        # Bound screenshots: skip writing if huge (>1.5MiB) — keep hash only in memory then write if ok.
+        if len(data) <= 1_500_000:
+            png_path.write_bytes(data)
+            png_hash = sha256_bytes(data)
+            png_size = len(data)
+        else:
+            png_hash = sha256_bytes(data)
+            png_size = len(data)
+            errors.append("screenshot over size bound; not written")
+            png_path = None
+
+    return {
+        "route": path,
+        "viewport": viewport,
+        "width": width,
+        "height": height,
+        "ok": not errors,
+        "errors": errors,
+        "signals": signals,
+        "png": str(png_path) if png_path else None,
+        "png_sha256": png_hash,
+        "png_bytes": png_size,
+        "tolerances": {
+            "pixel_perfect": False,
+            "overflow_policy": "fail only on mobile-width extreme overflow",
+            "screenshot_max_bytes": 1_500_000,
+        },
+    }
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--site", type=Path, default=SITE)
+    parser.add_argument("--evidence", type=Path, default=DEFAULT_EVIDENCE)
+    parser.add_argument("--screenshots", action="store_true", help="Write bounded PNGs (default: signals only)")
+    parser.add_argument("--limit-routes", type=int, default=0, help="Optional cap for faster runs")
+    args = parser.parse_args()
+
+    args.evidence.mkdir(parents=True, exist_ok=True)
+    shot_dir = args.evidence / "shots"
+    if args.screenshots:
+        shot_dir.mkdir(parents=True, exist_ok=True)
+
+    routes = ROUTES[: args.limit_routes] if args.limit_routes else ROUTES
+    entries: list[dict[str, Any]] = []
+    server = None
+    session = None
+    try:
+        server, _port, base = start_loopback_http(args.site)
+        session = start_chrome_session()
+        for path in routes:
+            for name, w, h, mobile in VIEWPORTS:
+                # Screenshots only for desktop+mobile on primary routes to keep evidence bounded.
+                take = args.screenshots and name in {"desktop", "mobile"} and path in {
+                    "/",
+                    "/products/mala/",
+                    "/apps/",
+                    "/404.html",
+                }
+                entries.append(
+                    capture(
+                        session,
+                        base,
+                        path,
+                        name,
+                        w,
+                        h,
+                        mobile,
+                        shot_dir,
+                        take_screenshot=take,
+                    )
+                )
+    finally:
+        if session is not None:
+            session.close()
+        if server is not None:
+            stop_process_group(server)
+
+    failed = [e for e in entries if not e["ok"]]
+    summary = {
+        "schema": "priyanshchordia.visual_depth.v1",
+        "started_at": datetime.now(timezone.utc).isoformat(),
+        "finished_at": datetime.now(timezone.utc).isoformat(),
+        "boundary": "DOM/layout/screenshot structural signals; not pixel-perfect goldens; not design QA cert.",
+        "route_count": len(routes),
+        "entry_count": len(entries),
+        "entries": entries,
+        "failed": [{"route": e["route"], "viewport": e["viewport"], "errors": e["errors"]} for e in failed],
+        "ok": not failed,
+    }
+    out = args.evidence / "visual_depth_summary.json"
+    out.write_text(json.dumps(summary, indent=2) + "\n", encoding="utf-8")
+    print(
+        json.dumps(
+            {
+                "ok": summary["ok"],
+                "entry_count": len(entries),
+                "failed": summary["failed"],
+                "summary": str(out),
+            },
+            indent=2,
+        )
+    )
+    return 0 if summary["ok"] else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
