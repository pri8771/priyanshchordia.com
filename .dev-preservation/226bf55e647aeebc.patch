+class TimezoneIsolationTests(unittest.TestCase):
+    def test_generation_byte_identical_under_utc_and_positive_offset(self) -> None:
+        """Generator must not embed local timezone wall-clock into artifacts."""
+
+        def run_with_tz(tz: str, dest: Path) -> dict[str, bytes]:
+            env = os.environ.copy()
+            env["TZ"] = tz
+            # Importing already-loaded GEN.main uses process-local datetime only
+            # where present; re-invoke main with OUT override in-process after
+            # setting TZ for any future date.today() usage.
+            original = GEN.OUT
+            try:
+                os.environ["TZ"] = tz
+                try:
+                    import time
+
+                    time.tzset()
+                except AttributeError:
+                    pass
+                GEN.OUT = dest
+                self.assertEqual(GEN.main(), 0)
+            finally:
+                GEN.OUT = original
+            return {p.relative_to(dest): p.read_bytes() for p in dest.rglob("*") if p.is_file()}
+
+        with tempfile.TemporaryDirectory(prefix="pch-c-tz-a-") as a_dir, tempfile.TemporaryDirectory(
+            prefix="pch-c-tz-b-"
+        ) as b_dir:
+            out_a = Path(a_dir) / "site"
+            out_b = Path(b_dir) / "site"
+            files_a = run_with_tz("UTC", out_a)
+            files_b = run_with_tz("America/New_York", out_b)
+            self.assertEqual(set(files_a), set(files_b))
+            mismatches = [rel for rel, data in files_a.items() if files_b[rel] != data]
+            self.assertEqual(mismatches, [], f"timezone-sensitive outputs: {mismatches}")
+
+
+class CanonicalContentParityTests(unittest.TestCase):
+    def test_canonical_urls_and_discovery_files_present_in_temp_out(self) -> None:
+        with tempfile.TemporaryDirectory(prefix="pch-c-canon-") as tmp:
+            out = Path(tmp) / "site"
+            original = GEN.OUT
+            try:
+                GEN.OUT = out
+                self.assertEqual(GEN.main(), 0)
+            finally:
+                GEN.OUT = original
+
+            robots = (out / "robots.txt").read_text(encoding="utf-8")
+            self.assertIn("Sitemap: https://priyanshchordia.com/sitemap.xml", robots)
+            sitemap = (out / "sitemap.xml").read_text(encoding="utf-8")
+            self.assertIn("https://priyanshchordia.com/", sitemap)
+            home = (out / "index.html").read_text(encoding="utf-8")
+            self.assertIn('rel="canonical"', home)
+            self.assertIn("https://priyanshchordia.com/", home)
+            waitlist_js = (out / "waitlist.js").read_text(encoding="utf-8").lower()
+            self.assertIn("signup form is unavailable", waitlist_js)
+            apps = {str(app["slug"]): app for app in GEN.load_apps(GEN.load_products())}
+            for slug in ("mala", "anjali", "svara", "roam", "hindsight", "aurafit"):
+                product = (out / "products" / slug / "index.html").read_text(encoding="utf-8")
+                self.assertIn(f"/products/{slug}/", product)
+                if apps[slug].get("app_store_id"):
