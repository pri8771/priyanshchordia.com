+"""Local payload budgets derived from measured committed site assets (Lane 3).
+
+Budgets are ceilings with modest headroom above the Session C baseline inventory,
+not marketing performance claims (DEC-C-003).
+"""
+
+from __future__ import annotations
+
+import unittest
+from pathlib import Path
+
+
+ROOT = Path(__file__).resolve().parents[1]
+SITE = ROOT / "site"
+
+# Measured 2026-09-07 on source SHA ba88c41 committed site/:
+# HTML ~145 KiB total, CSS ~96 KiB, experiences.js ~62 KiB, og images ~2.1 MiB.
+BUDGETS = {
+    "per_html_max": 20_000,  # largest product page ~10.5 KiB
+    "styles_css_max": 120_000,  # ~96 KiB now
+    "experiences_js_max": 80_000,  # ~62 KiB now
+    "app_themes_js_max": 8_000,
+    "waitlist_js_max": 8_000,
+    "total_html_max": 200_000,
+    "total_css_max": 120_000,
+    "total_js_max": 90_000,
+    "single_image_max": 1_400_000,  # og-five-apps ~1.19 MiB
+    "total_images_max": 2_600_000,
+    "total_site_max": 3_000_000,
+}
+
+
+class PerformanceBudgetTests(unittest.TestCase):
+    def test_individual_and_aggregate_payload_budgets(self) -> None:
+        self.assertTrue(SITE.is_dir(), "committed site/ required for budget check")
+        html_files = list(SITE.rglob("*.html"))
+        css_files = list(SITE.rglob("*.css"))
+        js_files = list(SITE.rglob("*.js"))
+        image_files = [
+            p
+            for p in SITE.rglob("*")
+            if p.is_file() and p.suffix.lower() in {".png", ".jpg", ".jpeg", ".webp", ".gif", ".svg", ".ico"}
+        ]
+
+        for path in html_files:
+            with self.subTest(html=str(path.relative_to(SITE))):
+                self.assertLessEqual(path.stat().st_size, BUDGETS["per_html_max"])
+
+        styles = SITE / "styles.css"
+        self.assertTrue(styles.is_file())
+        self.assertLessEqual(styles.stat().st_size, BUDGETS["styles_css_max"])
+        self.assertLessEqual((SITE / "experiences.js").stat().st_size, BUDGETS["experiences_js_max"])
+        self.assertLessEqual((SITE / "app-themes.js").stat().st_size, BUDGETS["app_themes_js_max"])
+        self.assertLessEqual((SITE / "waitlist.js").stat().st_size, BUDGETS["waitlist_js_max"])
+
+        total_html = sum(p.stat().st_size for p in html_files)
+        total_css = sum(p.stat().st_size for p in css_files)
+        total_js = sum(p.stat().st_size for p in js_files)
+        total_images = sum(p.stat().st_size for p in image_files)
+        total_site = sum(p.stat().st_size for p in SITE.rglob("*") if p.is_file())
+
+        self.assertLessEqual(total_html, BUDGETS["total_html_max"])
+        self.assertLessEqual(total_css, BUDGETS["total_css_max"])
+        self.assertLessEqual(total_js, BUDGETS["total_js_max"])
+        self.assertLessEqual(total_images, BUDGETS["total_images_max"])
+        self.assertLessEqual(total_site, BUDGETS["total_site_max"])
+
+        for path in image_files:
+            with self.subTest(image=str(path.relative_to(SITE))):
+                self.assertLessEqual(path.stat().st_size, BUDGETS["single_image_max"])
+
+    def test_no_unexpected_heavy_binary_types(self) -> None:
+        banned = {".map", ".woff", ".woff2", ".ttf", ".eot", ".mp4", ".webm", ".mov"}
+        offenders = [
+            p.relative_to(SITE)
+            for p in SITE.rglob("*")
+            if p.is_file() and p.suffix.lower() in banned
+        ]
+        self.assertEqual(offenders, [], f"unexpected heavy/binary assets: {offenders}")
+
+
+if __name__ == "__main__":
+    unittest.main()
