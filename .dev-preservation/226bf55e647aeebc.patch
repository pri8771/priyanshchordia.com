+#!/usr/bin/env python3
+"""Tests for scripts/content_integrity_harness.py (Session C4 Lane 3).
+
+Run with:
+    python3 -m unittest tests/test_content_integrity.py -v
+"""
+
+from __future__ import annotations
+
+import importlib.util
+import shutil
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+
+
+ROOT = Path(__file__).resolve().parents[1]
+SPEC = importlib.util.spec_from_file_location(
+    "content_integrity_harness",
+    ROOT / "scripts" / "content_integrity_harness.py",
+)
+assert SPEC and SPEC.loader
+HARNESS = importlib.util.module_from_spec(SPEC)
+SPEC.loader.exec_module(HARNESS)
+
+
+MINIMAL_HEAD = """<!DOCTYPE html>
+<html lang="en"><head><meta charset="utf-8">
+<meta name="viewport" content="width=device-width,initial-scale=1">
+<meta name="description" content="Fixture page">
+<meta name="robots" content="ROBOTS">
+<link rel="canonical" href="CANONICAL">
+<title>TITLE</title></head>"""
+
+
+def _page(
+    canonical: str,
+    title: str,
+    body: str,
+    *,
+    robots: str = "index,follow",
+    extra_head: str = "",
+) -> str:
+    head = (
+        MINIMAL_HEAD.replace("CANONICAL", canonical)
+        .replace("TITLE", title)
+        .replace("ROBOTS", robots)
+    )
+    return f"{head}{extra_head}<body>{body}</body></html>"
+
+
+class ContentIntegrityFixtureTests(unittest.TestCase):
+    def setUp(self) -> None:
