+"""Focused generator/data contract tests (PCH-148 queue items 1–4).
+
+Documents current load_posts / product-app-landing behavior without inventing
+new content policy. Generator fixes, if any, belong in a lead-owned patch.
+"""
+
+from __future__ import annotations
+
+import importlib.util
+import json
+import shutil
+import tempfile
+import unittest
+from pathlib import Path
+
+
+ROOT = Path(__file__).resolve().parents[1]
+SPEC = importlib.util.spec_from_file_location("generate_site", ROOT / "scripts" / "generate_site.py")
+assert SPEC and SPEC.loader
+GEN = importlib.util.module_from_spec(SPEC)
+SPEC.loader.exec_module(GEN)
+
+
+def _write_post(directory: Path, name: str, body: str) -> Path:
+    path = directory / name
+    path.write_text(body, encoding="utf-8")
+    return path
+
+
+class LoadPostsContractTests(unittest.TestCase):
+    def setUp(self) -> None:
+        self._posts = GEN.POSTS
+        self.tmp = Path(tempfile.mkdtemp(prefix="pch148-posts-"))
+        GEN.POSTS = self.tmp
+
+    def tearDown(self) -> None:
+        GEN.POSTS = self._posts
+        shutil.rmtree(self.tmp, ignore_errors=True)
+
+    def test_missing_front_matter_raises(self) -> None:
+        _write_post(self.tmp, "no-matter.md", "Just a body with no front matter.\n")
+        with self.assertRaisesRegex(ValueError, "missing front matter"):
+            GEN.load_posts()
+
+    def test_malformed_front_matter_without_closing_fence_raises(self) -> None:
+        _write_post(self.tmp, "open-fence.md", "---\ntitle: Open\ndate: 2026-01-01\nBody without closing fence\n")
+        with self.assertRaisesRegex(ValueError, "missing front matter"):
+            GEN.load_posts()
+
+    def test_unsafe_slug_raises(self) -> None:
+        _write_post(
+            self.tmp,
+            "bad-slug.md",
+            "---\ntitle: Bad\ndate: 2026-01-01\nslug: Not Safe!\n---\nBody.\n",
+        )
+        with self.assertRaisesRegex(ValueError, "unsafe slug"):
+            GEN.load_posts()
+
+    def test_duplicate_post_slug_raises(self) -> None:
+        _write_post(
+            self.tmp,
+            "one.md",
+            "---\ntitle: One\ndate: 2026-01-01\nslug: shared\n---\nA.\n",
+        )
+        _write_post(
+            self.tmp,
+            "two.md",
+            "---\ntitle: Two\ndate: 2026-01-02\nslug: shared\n---\nB.\n",
+        )
+        with self.assertRaisesRegex(ValueError, "duplicate post slug"):
+            GEN.load_posts()
+
+    def test_readme_and_underscore_docs_are_skipped(self) -> None:
+        _write_post(self.tmp, "README.md", "# docs only\n")
+        _write_post(self.tmp, "_notes.md", "---\ntitle: Notes\ndate: 2026-01-01\n---\nSkip me.\n")
+        _write_post(
+            self.tmp,
+            "real.md",
+            "---\ntitle: Real\ndate: 2026-02-01\n---\nKept.\n",
+        )
+        posts = GEN.load_posts()
+        self.assertEqual([p["slug"] for p in posts], ["real"])
+
+    def test_invalid_date_is_currently_accepted_contract_gap(self) -> None:
+        """load_posts stores date as opaque string; it does not validate YYYY-MM-DD.
+
+        Documented gap (not inventing policy): invalid/empty dates are accepted
+        and only affect sort order as plain strings.
+        """
+        _write_post(
+            self.tmp,
+            "odd-date.md",
+            "---\ntitle: Odd\ndate: not-a-date\n---\nBody.\n",
+        )
+        posts = GEN.load_posts()
+        self.assertEqual(posts[0]["date"], "not-a-date")
+
+    def test_post_slug_reserved_route_collision_not_enforced_contract_gap(self) -> None:
+        """Posts are not checked against RESERVED_ROUTES today (apps are).
+
+        Documented gap: a post slug of `apps` would generate /journal/apps/,
+        which is nested under journal and does not collide with /apps/, but
+        load_posts itself does not consult RESERVED_ROUTES.
+        """
+        reserved = next(iter(GEN.RESERVED_ROUTES))
+        _write_post(
+            self.tmp,
