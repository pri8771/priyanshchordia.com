+#!/usr/bin/env python3
+"""Verify release receipt + harnesses from a clean archive/checkout (C3 item 4).
+
+Creates a temporary git-archive extract of the current HEAD (or --sha), recomputes
+code-tree digest, validates a receipt against that tree, and records tamper /
+path / environment / missing-browser regression cases.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import os
+import shutil
+import subprocess
+import sys
+import tempfile
+from datetime import datetime, timezone
+from pathlib import Path
+from typing import Any
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT / "scripts"))
+
+from code_tree_digest import compute_code_tree_sha256  # noqa: E402
+from validate_release_receipt import (  # noqa: E402
+    receipt_body_hash,
+    recompute_tree_hash,
+    validate,
+)
+
+DEFAULT_EVIDENCE = ROOT / "session-c3-evidence" / "clean_checkout"
+
+
+def run(cmd: list[str], cwd: Path | None = None) -> dict[str, Any]:
+    result = subprocess.run(
+        cmd,
+        cwd=str(cwd or ROOT),
+        capture_output=True,
+        text=True,
+        check=False,
+    )
+    return {
+        "cmd": cmd,
+        "exit_code": result.returncode,
+        "ok": result.returncode == 0,
+        "stdout_tail": result.stdout[-1500:],
+        "stderr_tail": result.stderr[-1500:],
+    }
+
+
+def extract_archive(sha: str, dest: Path) -> None:
+    dest.mkdir(parents=True, exist_ok=True)
+    archive = dest / "tree.tar"
+    result = subprocess.run(
+        ["git", "archive", "--format=tar", "-o", str(archive), sha],
+        cwd=str(ROOT),
+        capture_output=True,
+        text=True,
+        check=False,
+    )
+    if result.returncode != 0:
+        raise RuntimeError(f"git archive failed: {result.stderr}")
+    subprocess.run(["tar", "-xf", str(archive), "-C", str(dest)], check=True)
+    archive.unlink(missing_ok=True)
+
+
+def regression_cases(sample_receipt: dict[str, Any], archive_digest: str) -> list[dict[str, Any]]:
+    cases: list[dict[str, Any]] = []
+
+    # Tamper: flip ok without reseal
+    tampered = json.loads(json.dumps(sample_receipt))
+    tampered["ok"] = False
+    errs = validate(tampered)
+    cases.append(
+        {
+            "name": "tamper_ok_without_reseal",
+            "ok": any("tamper" in e or "ok is not true" in e for e in errs),
+            "errors": errs,
+        }
+    )
+
+    # Path traversal artifact key
+    trav = json.loads(json.dumps(sample_receipt))
+    hashes = dict(trav.get("artifact_hashes") or {"index.html": "a" * 64})
+    hashes["../evil.txt"] = "d" * 64
+    trav["artifact_hashes"] = hashes
+    trav["artifact_tree_sha256"] = recompute_tree_hash(hashes)
+    if "receipt_sha256" in trav:
+        trav["receipt_sha256"] = receipt_body_hash(trav)
+    errs = validate(trav)
+    cases.append(
+        {
+            "name": "path_traversal_artifact_key",
+            "ok": any("path-traversal" in e for e in errs),
+            "errors": errs,
+        }
+    )
+
+    # Environment / platform mismatch
+    env = json.loads(json.dumps(sample_receipt))
+    errs = validate(env, expect_platform="definitely-not-this-platform")
+    cases.append(
+        {
+            "name": "environment_platform_mismatch",
+            "ok": any("platform mismatch" in e for e in errs),
+            "errors": errs,
+        }
+    )
+
+    # Code-tree mismatch against archive digest
+    tree = json.loads(json.dumps(sample_receipt))
+    if tree.get("schema") != "priyanshchordia.release_receipt.v2":
+        tree["schema"] = "priyanshchordia.release_receipt.v2"
+        tree["code_tree_sha256"] = "0" * 64
+        tree["git_head_at_check"] = tree.get("source_sha", "0" * 40)
+        tree["receipt_sha256"] = receipt_body_hash(tree)
+    errs = validate(tree, expect_code_tree=archive_digest)
+    # Expect mismatch unless sample already equals archive digest
+    mismatch = any("code_tree_sha256 mismatch" in e for e in errs)
+    # If sample was sealed for this archive, mismatch may be false — still ok if validate clean.
+    cases.append(
+        {
+            "name": "code_tree_expect_binding",
+            "ok": mismatch or not errs,
+            "detail": {
+                "mismatch_detected": mismatch,
+                "errors": errs,
+                "expect": archive_digest,
+                "receipt_tree": tree.get("code_tree_sha256"),
+            },
+        }
+    )
+
+    return cases
+
+
+def missing_chrome_failure_path() -> dict[str, Any]:
+    from cdp_client import chrome_discovery_report, discover_chrome, ChromeDiscoveryError
+
+    report = chrome_discovery_report()
+    # Force failure via bogus override without mutating global env permanently.
+    bogus = "/tmp/pch-definitely-missing-chrome-binary-c3"
+    failed = False
+    message = ""
+    try:
+        discover_chrome(override=bogus, require=True)
+    except ChromeDiscoveryError as exc:
+        failed = True
+        message = str(exc)
+    return {
+        "name": "missing_browser_override_fails_actionably",
+        "ok": failed and "PCH_CHROME_PATH" in message and bogus in message,
+        "message": message[:800],
+        "discovery_report_ok": report.get("ok"),
+        "discovery_resolved": report.get("resolved"),
+    }
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--sha", default="HEAD", help="git revision to archive")
+    parser.add_argument("--evidence", type=Path, default=DEFAULT_EVIDENCE)
+    parser.add_argument(
+        "--receipt",
+        type=Path,
+        default=ROOT / "session-c3-evidence" / "release_receipt.json",
+    )
+    parser.add_argument("--skip-unittest-in-archive", action="store_true")
+    args = parser.parse_args()
+
+    args.evidence.mkdir(parents=True, exist_ok=True)
+    resolved = subprocess.check_output(
+        ["git", "rev-parse", args.sha], cwd=str(ROOT), text=True
+    ).strip()
+
+    summary: dict[str, Any] = {
+        "started_at": datetime.now(timezone.utc).isoformat(),
+        "source_sha": resolved,
+        "worktree": str(ROOT),
+        "cases": [],
+        "steps": [],
+    }
+
+    with tempfile.TemporaryDirectory(prefix="pch-c3-archive-") as tmp:
+        archive_root = Path(tmp) / "extract"
+        extract_archive(resolved, archive_root)
+        digest = compute_code_tree_sha256(archive_root)
+        summary["archive_code_tree"] = {
+            "sha256": digest["code_tree_sha256"],
+            "file_count": digest["file_count"],
+            "source": digest["source"],
+        }
+
+        live_digest = compute_code_tree_sha256(ROOT)
+        summary["live_code_tree"] = {
+            "sha256": live_digest["code_tree_sha256"],
+            "file_count": live_digest["file_count"],
+            "source": live_digest["source"],
+        }
+        live_fs = compute_code_tree_sha256(ROOT, force_filesystem=True)
+        digests_equal = digest["code_tree_sha256"] == live_digest["code_tree_sha256"]
+        fs_equal = digest["code_tree_sha256"] == live_fs["code_tree_sha256"]
+        summary["cases"].append(
+            {
+                "name": "archive_digest_matches_live_when_same_sha",
+                "ok": digests_equal or fs_equal,
+                "detail": {
+                    "archive": digest["code_tree_sha256"],
+                    "live": live_digest["code_tree_sha256"],
+                    "live_filesystem": live_fs["code_tree_sha256"],
+                    "live_source": live_digest.get("source"),
+                    "archive_source": digest.get("source"),
+                    "note": (
+                        "Requires digest equality (git↔git or archive-fs↔live-fs). "
+                        "No unconditional filesystem-walk bypass."
+                    ),
+                },
+            }
+        )
+
+        # Run unittest inside archive if present (no installs).
+        if not args.skip_unittest_in_archive and (archive_root / "tests").is_dir():
+            # Copy is standalone; need PYTHONPATH for scripts imports used by tests.
+            step = run(
+                [sys.executable, "-m", "unittest", "discover", "-s", "tests", "-q"],
+                cwd=archive_root,
+            )
+            summary["steps"].append(
+                {
+                    "name": "unittest_in_clean_archive",
+                    "ok": step["ok"],
+                    "exit_code": step["exit_code"],
+                    "stderr_tail": step["stderr_tail"][-500:],
+                }
+            )
+
+        # Receipt validation regressions
+        if args.receipt.is_file():
+            receipt = json.loads(args.receipt.read_text(encoding="utf-8"))
+            summary["cases"].extend(
+                regression_cases(receipt, str(digest["code_tree_sha256"]))
+            )
+            # Validate live receipt against live recompute (sanity)
+            val = run(
+                [
+                    sys.executable,
+                    str(ROOT / "scripts" / "validate_release_receipt.py"),
+                    str(args.receipt),
+                    "--recompute-code-tree",
+                ]
+            )
+            summary["steps"].append(
+                {
+                    "name": "validate_existing_receipt_recompute",
+                    "ok": val["ok"],
+                    "exit_code": val["exit_code"],
+                    "stderr_tail": val["stderr_tail"][-400:],
+                }
+            )
+        else:
+            summary["cases"].append(
+                {
+                    "name": "receipt_present",
+                    "ok": False,
+                    "detail": f"missing {args.receipt}",
+                }
+            )
+
+        summary["cases"].append(missing_chrome_failure_path())
+
+        # Successful discovery path (local Chrome)
+        from cdp_client import chrome_discovery_report
+
+        report = chrome_discovery_report()
+        summary["cases"].append(
+            {
+                "name": "chrome_discovery_success_path",
+                "ok": bool(report.get("ok") and report.get("resolved")),
+                "detail": {
+                    "resolved": report.get("resolved"),
+                    "override_env": report.get("override_env"),
+                    "tried_count": len(report.get("candidates_tried") or []),
+                },
+            }
+        )
+
+    failed = [c for c in summary["cases"] if not c.get("ok")]
+    failed_steps = [s for s in summary["steps"] if not s.get("ok")]
+    summary["finished_at"] = datetime.now(timezone.utc).isoformat()
+    summary["ok"] = not failed and not failed_steps
+    summary["failed"] = [c["name"] for c in failed] + [s["name"] for s in failed_steps]
+
+    out = args.evidence / "clean_checkout_verify.json"
+    out.write_text(json.dumps(summary, indent=2) + "\n", encoding="utf-8")
+    print(json.dumps({"ok": summary["ok"], "failed": summary["failed"], "summary": str(out)}, indent=2))
+    return 0 if summary["ok"] else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
