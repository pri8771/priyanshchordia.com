+#!/usr/bin/env python3
+"""Executable Chrome/CDP keyboard, focus, and runtime interaction harness (C2 Lane 1).
+
+Runs real page JavaScript via installed Chrome CDP. Not VoiceOver/AT certification.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import sys
+import traceback
+from datetime import datetime, timezone
+from pathlib import Path
+from typing import Any
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT / "scripts"))
+
+from cdp_client import (  # noqa: E402
+    start_chrome_session,
+    start_loopback_http,
+    stop_process_group,
+)
+
+SITE = ROOT / "site"
+DEFAULT_EVIDENCE = ROOT / "session-c2-evidence" / "interaction"
+
+
+FOCUS_PROBE = r"""
+(() => {
+  const ae = document.activeElement;
+  if (!ae || ae === document.body || ae === document.documentElement) {
+    return {tag: null, id: null, cls: null, href: null, role: null, text: null};
+  }
+  return {
+    tag: ae.tagName ? ae.tagName.toLowerCase() : null,
+    id: ae.id || null,
+    cls: (typeof ae.className === 'string' ? ae.className : '') || null,
+    href: ae.getAttribute && ae.getAttribute('href'),
+    role: ae.getAttribute && ae.getAttribute('role'),
+    text: (ae.textContent || '').trim().slice(0, 80),
+    ariaInvalid: ae.getAttribute && ae.getAttribute('aria-invalid'),
+  };
+})()
+"""
+
+
+def record(cases: list[dict[str, Any]], name: str, ok: bool, detail: dict[str, Any] | None = None) -> None:
+    cases.append({"name": name, "ok": ok, "detail": detail or {}})
+
+
+def run_home_keyboard(session, base: str, viewport: str, cases: list[dict[str, Any]]) -> None:
+    mobile = viewport == "mobile"
+    w, h = (375, 812) if mobile else (1280, 800)
+    session.set_viewport(w, h, mobile=mobile)
+    session.navigate(f"{base}/")
+
+    # Skip link becomes first Tab stop and is visible on focus.
+    session.evaluate("document.body && document.body.focus && document.body.focus()")
+    # Reset focus to body so Tab order starts from document start.
+    session.evaluate(
+        "(() => { const b=document.body; if(b){ b.tabIndex=-1; b.focus(); b.removeAttribute('tabindex'); }})()"
+    )
+    session.tab()
+    focus = session.evaluate(FOCUS_PROBE)
+    skip_ok = bool(focus and focus.get("cls") and "skip" in (focus.get("cls") or ""))
+    # Visible focus: skip link left offset leaves offscreen -9999 when unfocused.
+    visible = session.evaluate(
+        """(() => {
+          const s = document.querySelector('a.skip');
+          if (!s) return {exists:false};
+          const cs = getComputedStyle(s);
+          const r = s.getBoundingClientRect();
+          return {exists:true, left:r.left, top:r.top, width:r.width, height:r.height,
+                  outline: cs.outlineStyle, position: cs.position};
+        })()"""
+    )
+    # After focus, .skip:focus moves left from -9999 to 8px.
+    visible_ok = bool(visible and visible.get("exists") and (visible.get("left") or 0) >= 0)
+    record(
+        cases,
+        f"home.skip_link_first_tab@{viewport}",
+        skip_ok and visible_ok,
+        {"focus": focus, "visible": visible},
+    )
+
+    # Activate skip → main receives focus (or hash navigation).
+    session.key("Enter", code="Enter", text="\r")
+    focus2 = session.evaluate(FOCUS_PROBE)
+    hash_now = session.evaluate("location.hash")
+    main_focus = bool(
+        (focus2 and focus2.get("id") in ("main", "xp-main"))
+        or hash_now in ("#main", "#xp-main")
+    )
+    # Some browsers don't move focus to target without tabindex; ensure main is focusable contract.
+    main_tabindex = session.evaluate(
+        "(() => { const m=document.getElementById('main'); return m ? m.tabIndex : null; })()"
+    )
+    record(
+        cases,
+        f"home.skip_activates_main@{viewport}",
+        main_focus or main_tabindex == -1 or hash_now == "#main",
+        {"focus": focus2, "hash": hash_now, "main_tabIndex": main_tabindex},
+    )
+
+    # Theme switching via themer select + change event.
+    before_theme = session.evaluate("document.documentElement.getAttribute('data-theme')")
+    switched = session.evaluate(
+        """(() => {
+          const sel = document.getElementById('themer') || document.querySelector('.themer');
+          if (!sel) return {ok:false, reason:'no-themer'};
+          const options = Array.from(sel.options).map(o => o.value);
+          const next = options.find(v => v !== document.documentElement.getAttribute('data-theme'));
+          if (!next) return {ok:false, reason:'no-alt'};
+          sel.value = next;
+          sel.dispatchEvent(new Event('change', {bubbles:true}));
+          return {ok:true, next, theme: document.documentElement.getAttribute('data-theme')};
+        })()"""
+    )
+    theme_ok = bool(switched and switched.get("ok") and switched.get("theme") != before_theme)
+    record(cases, f"home.theme_switch@{viewport}", theme_ok, {"before": before_theme, "switched": switched})
+
+    # Malformed query/fragment must not throw.
+    session.navigate(f"{base}/?design=%ZZ&x=%00#/%../weird")
+    boom = session.evaluate(
+        """(() => {
+          try {
+            const t = document.documentElement.getAttribute('data-theme');
+            const main = !!document.getElementById('main');
+            return {ok:true, theme:t, main};
+          } catch (e) { return {ok:false, error:String(e)}; }
+        })()"""
+    )
+    record(cases, f"home.malformed_query_fragment@{viewport}", bool(boom and boom.get("ok") and boom.get("main")), boom)
+
+    # Storage disabled: theme script must not throw.
+    session.evaluate(
+        """(() => {
+          const deny = {
+            getItem(){ throw new Error('disabled'); },
+            setItem(){ throw new Error('disabled'); },
+            removeItem(){ throw new Error('disabled'); },
+          };
+          try {
+            Object.defineProperty(window, 'localStorage', {configurable:true, get(){ return deny; }});
+          } catch (e) { window.__storagePatchFailed = String(e); }
+          return true;
+        })()"""
+    )
+    storage_ok = session.evaluate(
+        """(() => {
+          try {
+            const sel = document.querySelector('.themer');
+            if (sel) {
+              const v = sel.options[0].value;
+              sel.value = v;
+              sel.dispatchEvent(new Event('change', {bubbles:true}));
+            }
+            return {ok:true, theme: document.documentElement.getAttribute('data-theme')};
+          } catch (e) { return {ok:false, error:String(e)}; }
+        })()"""
+    )
+    record(cases, f"home.storage_disabled_theme@{viewport}", bool(storage_ok and storage_ok.get("ok")), storage_ok)
+
+
+def run_waitlist(session, base: str, cases: list[dict[str, Any]]) -> None:
+    session.set_viewport(1280, 800, mobile=False)
+    session.navigate(f"{base}/products/anjali/")
+    # Wait for deferred waitlist.js
+    session.evaluate(
+        """(() => new Promise((resolve) => {
+          const start = performance.now();
+          const tick = () => {
+            const form = document.querySelector('form[data-waitlist]');
+            if (form && form.__waitlistBound) return resolve(true);
+            // listeners present heuristic: submit without navigation
+            if (form) return resolve(true);
+            if (performance.now() - start > 3000) return resolve(false);
+            requestAnimationFrame(tick);
+          };
+          tick();
+        }))()""",
+        await_promise=True,
+    )
+
+    empty = session.evaluate(
+        """(() => {
+          const form = document.querySelector('form[data-waitlist]');
+          const status = form && form.querySelector('.waitlist-status');
+          const email = form && form.elements.email;
+          if (!form || !status || !email) return {ok:false, reason:'missing'};
+          email.value = '';
+          const consent = form.elements.consent;
+          if (consent) consent.checked = false;
+          form.requestSubmit ? form.requestSubmit() : form.dispatchEvent(new Event('submit', {bubbles:true,cancelable:true}));
+          return {
+            ok: true,
+            status: status.textContent,
+            focused: document.activeElement === status,
+            ariaInvalid: email.getAttribute('aria-invalid'),
+            successish: /thank you|you're on|success|subscribed/i.test(status.textContent || ''),
+          };
+        })()"""
+    )
+    record(
+        cases,
+        "waitlist.empty_email_focus_status",
+        bool(
+            empty
+            and empty.get("ok")
+            and empty.get("ariaInvalid") == "true"
+            and empty.get("focused")
+            and not empty.get("successish")
+        ),
+        empty,
+    )
+
+    invalid = session.evaluate(
+        """(() => {
+          const form = document.querySelector('form[data-waitlist]');
+          const status = form.querySelector('.waitlist-status');
+          const email = form.elements.email;
+          email.value = 'not-an-email';
+          form.elements.consent.checked = true;
+          form.requestSubmit ? form.requestSubmit() : form.dispatchEvent(new Event('submit', {bubbles:true,cancelable:true}));
+          return {
+            status: status.textContent,
+            focused: document.activeElement === status,
+            ariaInvalid: email.getAttribute('aria-invalid'),
+            successish: /thank you|success|subscribed/i.test(status.textContent || ''),
+          };
+        })()"""
+    )
+    record(
+        cases,
+        "waitlist.invalid_email",
+        bool(invalid and invalid.get("ariaInvalid") == "true" and not invalid.get("successish")),
+        invalid,
+    )
+
+    # Correct then valid path still honest unavailable (no false success).
+    unavailable = session.evaluate(
+        """(() => {
+          const form = document.querySelector('form[data-waitlist]');
+          const status = form.querySelector('.waitlist-status');
+          const email = form.elements.email;
+          email.value = 'tester@example.com';
+          form.elements.consent.checked = true;
+          form.requestSubmit ? form.requestSubmit() : form.dispatchEvent(new Event('submit', {bubbles:true,cancelable:true}));
+          const text = status.textContent || '';
+          return {
+            status: text,
+            focused: document.activeElement === status,
+            falseSuccess: /thank you|you're on the list|successfully subscribed/i.test(text),
+            unavailable: /unavailable|email link|added by hand/i.test(text),
+          };
+        })()"""
+    )
+    record(
+        cases,
+        "waitlist.valid_shows_unavailable_not_success",
+        bool(unavailable and unavailable.get("unavailable") and not unavailable.get("falseSuccess")),
+        unavailable,
+    )
+
+    # Repeated submit remains stable.
+    repeat = session.evaluate(
+        """(() => {
+          const form = document.querySelector('form[data-waitlist]');
+          const status = form.querySelector('.waitlist-status');
+          for (let i=0;i<3;i++) {
+            form.requestSubmit ? form.requestSubmit() : form.dispatchEvent(new Event('submit', {bubbles:true,cancelable:true}));
+          }
+          return {status: status.textContent, count: 3};
+        })()"""
+    )
+    record(cases, "waitlist.repeated_submit_stable", bool(repeat and repeat.get("status")), repeat)
+
+
+def run_experience_dialog(session, base: str, cases: list[dict[str, Any]]) -> None:
+    """Exercise experience themes that expose dialogs (cabinet/parallel/etc.) if present."""
+    session.set_viewport(1280, 800, mobile=False)
+    session.navigate(f"{base}/")
+    # Switch to cabinet which historically has interactive panels.
+    switched = session.evaluate(
+        """(() => {
+          const sel = document.getElementById('themer') || document.querySelector('.themer');
+          if (!sel) return {ok:false};
+          const want = 'cabinet';
+          if (![...sel.options].some(o => o.value === want)) return {ok:false, reason:'no-cabinet'};
+          sel.value = want;
+          sel.dispatchEvent(new Event('change', {bubbles:true}));
+          return {ok:true, theme: document.documentElement.getAttribute('data-theme'),
+                  hasXp: document.documentElement.classList.contains('has-xp'),
+                  xpChildren: (document.getElementById('xp')||{}).children ? document.getElementById('xp').children.length : 0};
+        })()"""
+    )
+    # Allow experience mount.
+    session.evaluate("(() => new Promise(r => setTimeout(r, 600)))()", await_promise=True)
+    dialog_info = session.evaluate(
+        """(() => {
+          const dialogs = Array.from(document.querySelectorAll('[role=dialog], .xp [aria-modal], #xp [data-open-display]'));
+          const any = dialogs[0] || document.querySelector('#xp [tabindex], #xp button, #xp a');
+          return {
+            dialogCount: dialogs.length,
+            xpHtmlLen: (document.getElementById('xp')||{}).innerHTML ? document.getElementById('xp').innerHTML.length : 0,
+            hasInteractive: !!any,
+          };
+        })()"""
+    )
+    record(cases, "experience.cabinet_mounts", bool(switched and switched.get("ok")), {"switched": switched, "dialog": dialog_info})
+
+    # Escape should not throw even if no dialog open.
+    session.escape()
+    after_esc = session.evaluate(
+        "(() => ({theme: document.documentElement.getAttribute('data-theme'), ok:true}))()"
+    )
+    record(cases, "experience.escape_no_throw", bool(after_esc and after_esc.get("ok")), after_esc)
+
+    # Repeated theme open/close (init/dispose).
+    cycle = session.evaluate(
+        """(() => {
+          const sel = document.getElementById('themer') || document.querySelector('.themer');
+          if (!sel) return {ok:false};
+          const themes = ['signal','cabinet','parallel','unknown-signal'];
+          for (let i=0;i<2;i++) {
+            for (const t of themes) {
+              if (![...sel.options].some(o => o.value === t)) continue;
+              sel.value = t;
+              sel.dispatchEvent(new Event('change', {bubbles:true}));
+            }
+          }
+          return {ok:true, theme: document.documentElement.getAttribute('data-theme')};
+        })()"""
+    )
+    session.evaluate("(() => new Promise(r => setTimeout(r, 400)))()", await_promise=True)
+    record(cases, "experience.repeated_theme_init_dispose", bool(cycle and cycle.get("ok")), cycle)
+
+
+def run_reduced_motion(session, base: str, cases: list[dict[str, Any]]) -> None:
+    session.call(
+        "Emulation.setEmulatedMedia",
+        {"features": [{"name": "prefers-reduced-motion", "value": "reduce"}]},
+    )
+    session.navigate(f"{base}/")
+    reduce = session.evaluate(
+        """(() => {
+          const mq = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
+          const xp = document.getElementById('xp');
+          return {mq, hasXpHost: !!xp, theme: document.documentElement.getAttribute('data-theme')};
+        })()"""
+    )
+    record(cases, "home.reduced_motion_emulated", bool(reduce and reduce.get("mq") is True), reduce)
+    # Reset media
+    session.call(
+        "Emulation.setEmulatedMedia",
+        {"features": [{"name": "prefers-reduced-motion", "value": ""}]},
+    )
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--site", type=Path, default=SITE)
+    parser.add_argument("--evidence", type=Path, default=DEFAULT_EVIDENCE)
+    parser.add_argument("--port", type=int, default=0, help="HTTP loopback port (0=ephemeral)")
+    args = parser.parse_args()
+
+    if not args.site.is_dir():
+        print(f"site missing: {args.site}", file=sys.stderr)
+        return 2
+
+    args.evidence.mkdir(parents=True, exist_ok=True)
+    cases: list[dict[str, Any]] = []
+    errors: list[str] = []
+    server = None
+    session = None
+    summary: dict[str, Any] = {
+        "started_at": datetime.now(timezone.utc).isoformat(),
+        "site": str(args.site),
+        "boundary": (
+            "Chrome CDP executable interaction evidence. "
+            "Not VoiceOver/AT certification. Not production deploy proof."
+        ),
+    }
+    try:
+        server, port, base = start_loopback_http(args.site, args.port or None)
+        summary["base"] = base
+        summary["http_port"] = port
+        session = start_chrome_session()
+        summary["cdp_port"] = session.port
+
+        for viewport in ("desktop", "mobile"):
+            try:
+                run_home_keyboard(session, base, viewport, cases)
+            except Exception as exc:  # noqa: BLE001
+                errors.append(f"home_keyboard@{viewport}: {exc}")
+                traceback.print_exc()
+
+        try:
+            run_waitlist(session, base, cases)
+        except Exception as exc:  # noqa: BLE001
+            errors.append(f"waitlist: {exc}")
+            traceback.print_exc()
+
+        try:
+            run_experience_dialog(session, base, cases)
+        except Exception as exc:  # noqa: BLE001
+            errors.append(f"experience: {exc}")
+            traceback.print_exc()
+
+        try:
+            run_reduced_motion(session, base, cases)
+        except Exception as exc:  # noqa: BLE001
+            errors.append(f"reduced_motion: {exc}")
+            traceback.print_exc()
+
+    finally:
+        if session is not None:
+            session.close()
+        if server is not None:
+            stop_process_group(server)
+
+    failed = [c for c in cases if not c["ok"]]
+    summary["finished_at"] = datetime.now(timezone.utc).isoformat()
+    summary["cases"] = cases
+    summary["case_count"] = len(cases)
+    summary["failed"] = [{"name": c["name"], "detail": c["detail"]} for c in failed]
+    summary["harness_errors"] = errors
+    summary["ok"] = not failed and not errors
+
+    out = args.evidence / "interaction_summary.json"
+    out.write_text(json.dumps(summary, indent=2) + "\n", encoding="utf-8")
+    print(
+        json.dumps(
+            {
+                "ok": summary["ok"],
+                "case_count": summary["case_count"],
+                "failed": [c["name"] for c in failed],
+                "harness_errors": errors,
+                "summary": str(out),
+            },
+            indent=2,
+        )
+    )
+    return 0 if summary["ok"] else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
