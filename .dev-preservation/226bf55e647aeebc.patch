+#!/usr/bin/env python3
+"""Local Chrome headless probe for critical pages (Session C Lane 1).
+
+Uses the installed Google Chrome app only — no Playwright/npm install.
+Starts a loopback-only http.server, dumps DOM + screenshots at desktop and
+narrow widths, checks console-free load via --enable-logging where possible,
+then stops the server.
+
+This is browser evidence, not assistive-technology certification.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import os
+import signal
+import subprocess
+import sys
+import time
+import urllib.error
+import urllib.request
+from datetime import datetime, timezone
+from pathlib import Path
+
+
+ROOT = Path(__file__).resolve().parents[1]
+SITE = ROOT / "site"
+DEFAULT_EVIDENCE = ROOT / "session-c-evidence" / "browser"
+sys.path.insert(0, str(ROOT / "scripts"))
+from cdp_client import ChromeDiscoveryError, discover_chrome  # noqa: E402
+
+
+CRITICAL_PATHS = [
+    "/",
+    "/journal/",
+    "/apps/",
+    "/products/mala/",
+    "/products/anjali/",
+    "/products/svara/",
+    "/products/roam/",
+    "/products/hindsight/",
+    "/products/aurafit/",
+    "/apps/mala/privacy/",
+    "/apps/mala/support/",
+    "/404.html",
+]
+
+VIEWPORTS = [
+    ("desktop", 1280, 800),
+    ("mobile", 375, 812),
+]
+
+
+def wait_http(url: str, timeout: float = 15.0) -> None:
+    deadline = time.time() + timeout
+    last: Exception | None = None
+    while time.time() < deadline:
+        try:
+            with urllib.request.urlopen(url, timeout=1) as resp:
+                if resp.status == 200:
+                    return
+        except Exception as exc:  # noqa: BLE001 — probe retries until ready
+            last = exc
+            time.sleep(0.1)
+    raise RuntimeError(f"server not ready: {url} ({last})")
+
+
+def chrome_dump(url: str, out_html: Path, width: int, height: int, chrome: Path) -> None:
+    out_html.parent.mkdir(parents=True, exist_ok=True)
+    cmd = [
+        str(chrome),
+        "--headless=new",
+        "--disable-gpu",
+        "--no-first-run",
+        "--no-default-browser-check",
+        f"--window-size={width},{height}",
+        f"--screenshot={out_html.with_suffix('.png')}",
+        "--virtual-time-budget=3000",
+        f"--dump-dom",
+        url,
+    ]
+    result = subprocess.run(cmd, capture_output=True, text=True, check=False)
+    if result.returncode != 0:
+        raise RuntimeError(f"chrome failed for {url}: {result.stderr[-500:]}")
+    out_html.write_text(result.stdout, encoding="utf-8")
+
+
+def analyze_dom(html: str, path: str) -> list[str]:
+    errors: list[str] = []
+    lowered = html.lower()
+    if "<html" not in lowered:
+        errors.append(f"{path}: missing html element in dump")
+    if 'lang="' not in lowered and "lang='" not in lowered:
+        errors.append(f"{path}: missing lang")
+    if "<main" not in lowered:
+        errors.append(f"{path}: missing main")
+    if "primary" not in lowered and path != "/404.html":
+        # 404 still has nav in this generator
+        pass
+    if 'aria-label="primary"' not in lowered and "aria-label='primary'" not in lowered:
+        errors.append(f"{path}: missing Primary nav label")
+    # Verified App Store listings use download CTAs; unresolved apps keep waitlist.
+    if path.startswith("/products/"):
+        has_waitlist = "data-waitlist" in lowered
+        has_store_cta = "apps.apple.com/app/id" in lowered
+        if not has_waitlist and not has_store_cta:
+            errors.append(f"{path}: missing waitlist form hook or App Store CTA")
+        if has_waitlist and has_store_cta:
+            errors.append(f"{path}: waitlist and App Store CTA must not both appear")
+    return errors
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--site", type=Path, default=SITE)
+    parser.add_argument("--evidence", type=Path, default=DEFAULT_EVIDENCE)
+    parser.add_argument("--port", type=int, default=0, help="HTTP port (0 = ephemeral)")
+    args = parser.parse_args()
+
+    try:
+        chrome = discover_chrome(require=True)
+    except ChromeDiscoveryError as exc:
+        print(str(exc), file=sys.stderr)
+        return 2
+    assert chrome is not None
+    if not args.site.is_dir():
+        print(f"site missing: {args.site}", file=sys.stderr)
+        return 2
+
+    from cdp_client import find_free_port
+
+    port = args.port or find_free_port()
+    args.evidence.mkdir(parents=True, exist_ok=True)
+    server = subprocess.Popen(
+        [sys.executable, "-m", "http.server", str(port), "--bind", "127.0.0.1"],
+        cwd=str(args.site),
+        stdout=subprocess.DEVNULL,
+        stderr=subprocess.DEVNULL,
+        start_new_session=True,
+    )
+    base = f"http://127.0.0.1:{port}"
+    summary: dict[str, object] = {
+        "started_at": datetime.now(timezone.utc).isoformat(),
+        "chrome": str(chrome),
+        "site": str(args.site),
+        "base": base,
+        "http_port": port,
+        "pages": [],
+        "errors": [],
+        "boundary": (
+            "Chrome headless dump-dom/screenshot evidence only. "
+            "Not VoiceOver/keyboard AT certification."
+        ),
+    }
+    try:
+        wait_http(f"{base}/")
+        all_errors: list[str] = []
+        for path in CRITICAL_PATHS:
+            page_record = {"path": path, "viewports": {}}
+            for name, width, height in VIEWPORTS:
+                slug = path.strip("/").replace("/", "_") or "home"
+                out = args.evidence / f"{slug}__{name}.html"
+                url = base + path
+                chrome_dump(url, out, width, height, chrome)
+                html = out.read_text(encoding="utf-8")
+                errs = analyze_dom(html, f"{path}@{name}")
+                all_errors.extend(errs)
+                page_record["viewports"][name] = {
+                    "width": width,
+                    "height": height,
+                    "dom_dump": str(out.relative_to(ROOT)) if out.is_relative_to(ROOT) else str(out),
+                    "screenshot": str(out.with_suffix(".png").relative_to(ROOT))
+                    if out.with_suffix(".png").is_relative_to(ROOT)
+                    else str(out.with_suffix(".png")),
+                    "bytes": out.stat().st_size,
+                    "errors": errs,
+                }
+            summary["pages"].append(page_record)
+        summary["errors"] = all_errors
+        summary["ok"] = not all_errors
+    finally:
+        try:
+            os.killpg(server.pid, signal.SIGTERM)
+            try:
+                server.wait(timeout=5)
+            except subprocess.TimeoutExpired:
+                os.killpg(server.pid, signal.SIGKILL)
+                server.wait(timeout=3)
+        except ProcessLookupError:
+            pass
+
+    summary_path = args.evidence / "probe_summary.json"
+    summary_path.write_text(json.dumps(summary, indent=2) + "\n", encoding="utf-8")
+    print(json.dumps({"ok": summary.get("ok", False), "errors": summary.get("errors", []), "summary": str(summary_path)}, indent=2))
+    return 0 if summary.get("ok") else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
