+#!/usr/bin/env python3
+"""Full keyboard/focus audit across interactive routes (C3 item 1).
+
+Uses real Chrome CDP key events. Not VoiceOver/AT certification.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import sys
+import traceback
+from datetime import datetime, timezone
+from pathlib import Path
+from typing import Any
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT / "scripts"))
+
+from cdp_client import (  # noqa: E402
+    start_chrome_session,
+    start_loopback_http,
+    stop_process_group,
+)
+
+SITE = ROOT / "site"
+DEFAULT_EVIDENCE = ROOT / "session-c3-evidence" / "keyboard"
+
+# Interactive HTML routes (pages a user tabs through). Assets excluded.
+INTERACTIVE_ROUTES = [
+    "/",
+    "/journal/",
+    "/apps/",
+    "/products/mala/",
+    "/products/anjali/",
+    "/products/svara/",
+    "/products/roam/",
+    "/products/hindsight/",
+    "/products/aurafit/",
+    "/apps/mala/privacy/",
+    "/apps/mala/support/",
+    "/apps/anjali/privacy/",
+    "/apps/anjali/support/",
+    "/apps/svara/privacy/",
+    "/apps/svara/support/",
+    "/apps/roam/privacy/",
+    "/apps/roam/support/",
+    "/apps/hindsight/privacy/",
+    "/apps/hindsight/support/",
+    "/apps/aurafit/privacy/",
+    "/apps/aurafit/support/",
+    "/404.html",
+]
+
+FOCUS_PROBE = r"""
+(() => {
+  const ae = document.activeElement;
+  if (!ae || ae === document.body || ae === document.documentElement) {
+    return {tag: null, id: null, cls: null, href: null, role: null, text: null, tabIndex: null};
+  }
+  return {
+    tag: ae.tagName ? ae.tagName.toLowerCase() : null,
+    id: ae.id || null,
+    cls: (typeof ae.className === 'string' ? ae.className : '') || null,
+    href: ae.getAttribute && ae.getAttribute('href'),
+    role: ae.getAttribute && ae.getAttribute('role'),
+    text: (ae.textContent || '').trim().slice(0, 80),
+    tabIndex: ae.tabIndex,
+  };
+})()
+"""
+
+FOCUS_STYLE_PROBE = r"""
+(() => {
+  const ae = document.activeElement;
+  if (!ae || ae === document.body) return {hasFocus:false};
+  const cs = getComputedStyle(ae);
+  const r = ae.getBoundingClientRect();
+  return {
+    hasFocus: true,
+    outlineStyle: cs.outlineStyle,
+    outlineWidth: cs.outlineWidth,
+    outlineColor: cs.outlineColor,
+    boxShadow: cs.boxShadow,
+    left: r.left,
+    top: r.top,
+    width: r.width,
+    height: r.height,
+    tag: ae.tagName.toLowerCase(),
+    id: ae.id || null,
+    cls: (typeof ae.className === 'string' ? ae.className : '') || null,
+  };
+})()
+"""
+
+
+def record(cases: list[dict[str, Any]], name: str, ok: bool, detail: Any = None) -> None:
+    cases.append({"name": name, "ok": bool(ok), "detail": detail or {}})
+
+
+def reset_focus_to_start(session) -> None:
+    session.evaluate(
+        "(() => { const b=document.body; if(b){ b.tabIndex=-1; b.focus(); b.removeAttribute('tabindex'); }})()"
+    )
+
+
+def audit_route(session, base: str, path: str, cases: list[dict[str, Any]]) -> None:
+    url = base + path
+    session.set_viewport(1280, 800, mobile=False)
+    session.navigate(url)
+    slug = path.strip("/").replace("/", "_") or "home"
+
+    # --- Skip link first Tab + visible focus ---
+    reset_focus_to_start(session)
+    session.tab()
+    focus = session.evaluate(FOCUS_PROBE)
+    style = session.evaluate(FOCUS_STYLE_PROBE)
+    skip_ok = bool(focus and focus.get("cls") and "skip" in (focus.get("cls") or ""))
+    # Visible: skip moves from left:-9999 to on-screen, or any non-none outline/box-shadow.
+    visible = False
+    if style and style.get("hasFocus"):
+        if (style.get("left") or -9999) >= 0 and (style.get("width") or 0) > 0:
+            visible = True
+        if style.get("outlineStyle") and style.get("outlineStyle") != "none":
+            visible = True
+        if style.get("boxShadow") and style.get("boxShadow") != "none":
+            visible = True
+    record(
+        cases,
+        f"{slug}.skip_first_tab_visible",
+        skip_ok and visible,
+        {"focus": focus, "style": style},
+    )
+
+    # --- Skip activates main / skip target ---
+    skip_href = session.evaluate(
+        "(() => { const s=document.querySelector('a.skip'); return s ? s.getAttribute('href') : null; })()"
+    )
+    session.key("Enter", code="Enter", text="\r")
+    after = session.evaluate(FOCUS_PROBE)
+    hash_now = session.evaluate("location.hash")
+    target_id = (skip_href or "#main").lstrip("#") or "main"
+    # Require actual activation evidence (focus moved or hash updated) — do not
+    # treat static tabindex=-1 on <main> as proof that Enter activated the skip link.
+    main_ok = bool(
+        (after and after.get("id") == target_id)
+        or hash_now == f"#{target_id}"
+    )
+    record(
+        cases,
+        f"{slug}.skip_target",
+        main_ok,
+        {"focus": after, "hash": hash_now, "skip_href": skip_href, "target_id": target_id},
+    )
+
+    # --- Predictable tab order: collect first N focusables ---
+    reset_focus_to_start(session)
+    order: list[dict[str, Any]] = []
+    for _ in range(12):
+        session.tab()
+        order.append(session.evaluate(FOCUS_PROBE))
+    # First should be skip; subsequent should not all be null; no immediate loop of identical non-body.
+    first_skip = bool(order and order[0] and order[0].get("cls") and "skip" in (order[0].get("cls") or ""))
+    non_null = [o for o in order if o and o.get("tag")]
+    # Detect trivial keyboard trap: after leaving skip, stuck forever on one element for many Tabs.
+    trap = False
+    if len(non_null) >= 6:
+        signatures = [
+            f"{o.get('tag')}|{o.get('id')}|{o.get('href')}|{o.get('text')}" for o in non_null[1:]
+        ]
+        if len(set(signatures)) == 1 and signatures:
+            trap = True
+    record(
+        cases,
+        f"{slug}.tab_order_no_trap",
+        first_skip and len(non_null) >= 2 and not trap,
+        {"order": order[:8], "trap": trap, "non_null": len(non_null)},
+    )
+
+    # --- Enter/Space on first in-page control after skip (if button/link) ---
+    reset_focus_to_start(session)
+    session.tab()  # skip
+    session.tab()  # next
+    before_url = session.evaluate("location.href")
+    focused = session.evaluate(FOCUS_PROBE)
+    session.key("Enter", code="Enter", text="\r")
+    after_url = session.evaluate("location.href")
+    # Space on focused button (if any) — must not throw.
+    boom = session.evaluate(
+        """(() => {
+          try {
+            const ae = document.activeElement;
+            if (ae && (ae.tagName === 'BUTTON' || ae.getAttribute('role') === 'button')) {
+              ae.dispatchEvent(new KeyboardEvent('keydown', {key:' ', bubbles:true}));
+              ae.dispatchEvent(new KeyboardEvent('keyup', {key:' ', bubbles:true}));
+            }
+            return {ok:true};
+          } catch (e) { return {ok:false, error:String(e)}; }
+        })()"""
+    )
+    record(
+        cases,
+        f"{slug}.enter_space_activation_safe",
+        bool(boom and boom.get("ok")),
+        {"focused": focused, "before_url": before_url, "after_url": after_url, "boom": boom},
+    )
+
+    # --- Escape behavior (no throw; menus/dialogs if present) ---
+    session.escape()
+    esc = session.evaluate(
+        """(() => {
+          try {
+            const openDialogs = document.querySelectorAll('[aria-modal="true"], [role="dialog"]');
+            return {ok:true, dialogs: openDialogs.length, theme: document.documentElement.getAttribute('data-theme')};
+          } catch (e) { return {ok:false, error:String(e)}; }
+        })()"""
+    )
+    record(cases, f"{slug}.escape_safe", bool(esc and esc.get("ok")), esc)
+
+    # --- Back/forward focus recovery (history) ---
+    session.navigate(base + "/")
+    session.navigate(url)
+    session.evaluate("history.back()")
+    session.evaluate("(() => new Promise(r => setTimeout(r, 200)))()", await_promise=True)
+    back_path = session.evaluate("location.pathname + location.search + location.hash")
+    session.evaluate("history.forward()")
+    session.evaluate("(() => new Promise(r => setTimeout(r, 200)))()", await_promise=True)
+    fwd_path = session.evaluate("location.pathname + location.search + location.hash")
+    # After forward, page should load; Tab still reaches skip (focus recovery contract).
+    reset_focus_to_start(session)
+    session.tab()
+    focus_after_hist = session.evaluate(FOCUS_PROBE)
+    hist_ok = bool(
+        focus_after_hist
+        and focus_after_hist.get("cls")
+        and "skip" in (focus_after_hist.get("cls") or "")
+    )
+    record(
+        cases,
+        f"{slug}.history_focus_recovery",
+        hist_ok,
+        {"back": back_path, "forward": fwd_path, "focus": focus_after_hist},
+    )
+
+
+def audit_home_experience_dialogs(session, base: str, cases: list[dict[str, Any]]) -> None:
+    """Home experiences: open dialog if possible, Escape closes, no trap."""
+    session.set_viewport(1280, 800, mobile=False)
+    session.navigate(f"{base}/")
+    for theme in ("overworld", "unknown-signal", "parallel", "cabinet"):
+        switched = session.evaluate(
+            f"""(() => {{
+              const sel = document.getElementById('themer') || document.querySelector('.themer');
+              if (!sel) return {{ok:false, reason:'no-themer'}};
+              if (![...sel.options].some(o => o.value === {json.dumps(theme)})) return {{ok:false, reason:'missing'}};
+              sel.value = {json.dumps(theme)};
+              sel.dispatchEvent(new Event('change', {{bubbles:true}}));
+              return {{ok:true, theme: document.documentElement.getAttribute('data-theme')}};
+            }})()"""
+        )
+        session.evaluate("(() => new Promise(r => setTimeout(r, 500)))()", await_promise=True)
+        # Try to open a dialog via first clickable in #xp
+        opened = session.evaluate(
+            """(() => {
+              const host = document.getElementById('xp');
+              if (!host) return {opened:false, reason:'no-xp'};
+              const btn = host.querySelector('button, [role=button], a, [tabindex="0"]');
+              if (btn) { btn.click(); }
+              const dialogs = document.querySelectorAll('[role=dialog], [aria-modal="true"]');
+              return {opened: dialogs.length > 0, dialogCount: dialogs.length, clicked: !!btn};
+            })()"""
+        )
+        session.escape()
+        after = session.evaluate(
+            """(() => {
+              const dialogs = document.querySelectorAll('[role=dialog][aria-modal="true"], [aria-modal="true"]');
+              // Some themes hide via aria-hidden rather than removing.
+              const visible = Array.from(dialogs).filter(d => d.getAttribute('aria-hidden') !== 'true');
+              return {ok:true, remainingVisible: visible.length};
+            })()"""
+        )
+        record(
+            cases,
+            f"home.experience.{theme}.escape_dialog",
+            bool(switched and switched.get("ok") and after and after.get("ok")),
+            {"switched": switched, "opened": opened, "after": after},
+        )
+
+
+def audit_reduced_motion(session, base: str, cases: list[dict[str, Any]]) -> None:
+    session.call(
+        "Emulation.setEmulatedMedia",
+        {"features": [{"name": "prefers-reduced-motion", "value": "reduce"}]},
+    )
+    session.navigate(f"{base}/")
+    reduce = session.evaluate(
+        """(() => {
+          const mq = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
+          return {mq, theme: document.documentElement.getAttribute('data-theme')};
+        })()"""
+    )
+    reset_focus_to_start(session)
+    session.tab()
+    focus = session.evaluate(FOCUS_PROBE)
+    record(
+        cases,
+        "home.reduced_motion_keyboard_still_works",
+        bool(reduce and reduce.get("mq") and focus and focus.get("cls") and "skip" in (focus.get("cls") or "")),
+        {"reduce": reduce, "focus": focus},
+    )
+    session.call(
+        "Emulation.setEmulatedMedia",
+        {"features": [{"name": "prefers-reduced-motion", "value": ""}]},
+    )
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--site", type=Path, default=SITE)
+    parser.add_argument("--evidence", type=Path, default=DEFAULT_EVIDENCE)
+    parser.add_argument("--port", type=int, default=0)
+    parser.add_argument(
+        "--routes",
+        nargs="*",
+        default=None,
+        help="Optional subset of routes (default: all interactive)",
+    )
+    args = parser.parse_args()
+
+    if not args.site.is_dir():
+        print(f"site missing: {args.site}", file=sys.stderr)
+        return 2
+
+    args.evidence.mkdir(parents=True, exist_ok=True)
+    routes = args.routes or INTERACTIVE_ROUTES
+    cases: list[dict[str, Any]] = []
+    errors: list[str] = []
+    server = None
+    session = None
+    summary: dict[str, Any] = {
+        "started_at": datetime.now(timezone.utc).isoformat(),
+        "site": str(args.site),
+        "routes": routes,
+        "boundary": (
+            "Chrome CDP keyboard/focus audit. "
+            "Not VoiceOver/AT certification. Not production deploy proof."
+        ),
+    }
+    try:
+        server, port, base = start_loopback_http(args.site, args.port or None)
+        summary["base"] = base
+        summary["http_port"] = port
+        session = start_chrome_session()
+        summary["cdp_port"] = session.port
+        for path in routes:
+            try:
+                audit_route(session, base, path, cases)
+            except Exception as exc:  # noqa: BLE001
+                errors.append(f"route {path}: {exc}")
+                traceback.print_exc()
+        try:
+            audit_home_experience_dialogs(session, base, cases)
+        except Exception as exc:  # noqa: BLE001
+            errors.append(f"experiences: {exc}")
+            traceback.print_exc()
+        try:
+            audit_reduced_motion(session, base, cases)
+        except Exception as exc:  # noqa: BLE001
+            errors.append(f"reduced_motion: {exc}")
+            traceback.print_exc()
+    finally:
+        if session is not None:
+            session.close()
+        if server is not None:
+            stop_process_group(server)
+
+    failed = [c for c in cases if not c["ok"]]
+    summary["finished_at"] = datetime.now(timezone.utc).isoformat()
+    summary["cases"] = cases
+    summary["case_count"] = len(cases)
+    summary["failed"] = [{"name": c["name"], "detail": c["detail"]} for c in failed]
+    summary["harness_errors"] = errors
+    summary["ok"] = not failed and not errors
+
+    out = args.evidence / "keyboard_a11y_summary.json"
+    out.write_text(json.dumps(summary, indent=2) + "\n", encoding="utf-8")
+    print(
+        json.dumps(
+            {
+                "ok": summary["ok"],
+                "case_count": summary["case_count"],
+                "failed": [c["name"] for c in failed],
+                "harness_errors": errors,
+                "summary": str(out),
+            },
+            indent=2,
+        )
+    )
+    return 0 if summary["ok"] else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
