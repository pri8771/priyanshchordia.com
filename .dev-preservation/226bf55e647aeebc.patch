+"""Static-host mode contracts (C4 Lane 4)."""
+
+from __future__ import annotations
+
+import importlib.util
+import os
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+from unittest import mock
+
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+def load_module(name: str, rel: str):
+    spec = importlib.util.spec_from_file_location(name, ROOT / rel)
+    assert spec and spec.loader
+    mod = importlib.util.module_from_spec(spec)
+    sys.modules[name] = mod
+    spec.loader.exec_module(mod)
+    return mod
+
+
+class StaticHostHelperTests(unittest.TestCase):
+    def setUp(self) -> None:
+        self.harness = load_module("static_host_modes_harness", "scripts/static_host_modes_harness.py")
+
+    def test_nested_route_variants(self) -> None:
+        no_slash, with_slash = self.harness.nested_route_variants("/apps/mala/privacy/")
+        self.assertEqual(no_slash, "/apps/mala/privacy")
+        self.assertEqual(with_slash, "/apps/mala/privacy/")
+
+    def test_expected_content_types_html_css_js(self) -> None:
+        self.assertIn("text/html", self.harness.expected_content_types("/index.html"))
+        self.assertIn("text/css", self.harness.expected_content_types("/styles.css"))
+        js_types = self.harness.expected_content_types("/waitlist.js")
+        self.assertTrue(any(t in ("text/javascript", "application/javascript") for t in js_types))
+
+    def test_expected_content_types_xml_txt_png(self) -> None:
+        xml_types = self.harness.expected_content_types("/sitemap.xml")
+        self.assertTrue(any(t in ("application/xml", "text/xml") for t in xml_types))
+        self.assertIn("text/plain", self.harness.expected_content_types("/robots.txt"))
+        self.assertIn("image/png", self.harness.expected_content_types("/og.png"))
+        self.assertIn("image/png", self.harness.TEMP_EXTRA_MIME_PATHS["/probe.png"])
+
+    def test_content_type_matches_ignores_charset(self) -> None:
+        ok = self.harness.content_type_matches("text/html; charset=utf-8", ("text/html",))
+        self.assertTrue(ok)
+
+    def test_trailing_slash_resolution_redirect_or_200(self) -> None:
+        self.assertTrue(self.harness.trailing_slash_resolution_ok(301, b""))
+        self.assertTrue(self.harness.trailing_slash_resolution_ok(200, b"<html></html>"))
+        self.assertFalse(self.harness.trailing_slash_resolution_ok(404, b""))
+
+
+class ChromeDiscoveryExclusiveTests(unittest.TestCase):
+    def test_override_env_wins_over_candidates(self) -> None:
+        cdp = load_module("cdp_client_c4_l4", "scripts/cdp_client.py")
+        with tempfile.TemporaryDirectory() as tmp:
+            fake = Path(tmp) / "fake-chrome"
+            fake.write_text("#!/bin/sh\nexit 0\n", encoding="utf-8")
+            fake.chmod(0o755)
+            with mock.patch.dict(os.environ, {"PCH_CHROME_PATH": str(fake)}):
+                resolved = cdp.discover_chrome(require=True)
+            self.assertEqual(resolved, fake)
+
+    def test_missing_override_raises_actionable_error(self) -> None:
+        cdp = load_module("cdp_client_c4_l4_err", "scripts/cdp_client.py")
+        bogus = "/tmp/pch-c4-missing-chrome-binary-xyz"
+        with self.assertRaises(cdp.ChromeDiscoveryError) as ctx:
+            cdp.discover_chrome(override=bogus, require=True)
+        message = str(ctx.exception)
+        self.assertIn(bogus, message)
+        self.assertIn("PCH_CHROME_PATH", message)
+        self.assertIn("Tried:", message)
+
+    def test_discovery_report_env_exclusive_no_fallback(self) -> None:
+        cdp = load_module("cdp_client_c4_l4_report", "scripts/cdp_client.py")
+        bogus = "/tmp/pch-c4-missing-chrome-report-exclusive"
+        with mock.patch.dict(os.environ, {"PCH_CHROME_PATH": bogus}):
+            report = cdp.chrome_discovery_report()
+        self.assertFalse(report["ok"])
+        self.assertEqual(report["mode"], "env")
+        self.assertEqual(len(report["candidates_tried"]), 1)
+        self.assertEqual(report["candidates_tried"][0]["path"], bogus)
+
+    def test_discovery_report_override_exclusive(self) -> None:
+        cdp = load_module("cdp_client_c4_l4_report_ov", "scripts/cdp_client.py")
+        bogus = "/tmp/pch-c4-missing-chrome-override-exclusive"
+        report = cdp.chrome_discovery_report(override=bogus)
+        self.assertFalse(report["ok"])
+        self.assertEqual(report["mode"], "override")
+        self.assertEqual(report["candidates_tried"][0]["path"], bogus)
+
+    def test_require_false_returns_none_without_install(self) -> None:
+        cdp = load_module("cdp_client_c4_l4_reqfalse", "scripts/cdp_client.py")
+        resolved = cdp.discover_chrome(override="/tmp/pch-c4-missing-chrome-reqfalse", require=False)
+        self.assertIsNone(resolved)
+
+
+class StaticHostHarnessImportTests(unittest.TestCase):
+    def test_harness_imports_cdp_helpers_read_only(self) -> None:
+        source = (ROOT / "scripts" / "static_host_modes_harness.py").read_text(encoding="utf-8")
+        self.assertIn("start_loopback_http", source)
+        self.assertIn("discover_chrome", source)
+        self.assertIn("chrome_discovery_report", source)
+        self.assertNotIn("subprocess.Popen", source.split("from cdp_client import", 1)[0])
+
+
+if __name__ == "__main__":
+    unittest.main()
