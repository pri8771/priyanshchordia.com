+"""Generation integrity extensions for Session C Lane 2.
+
+Extends Session 3 dual-OUT determinism with stale-output wipe, asset inventory
+parity, timezone isolation, and additional malformed front-matter coverage.
+Does not invent post-date or post reserved-route policy (see DEC-C-002).
+"""
+
+from __future__ import annotations
+
+import importlib.util
+import os
+import shutil
+import tempfile
+import unittest
+from pathlib import Path
+
+
+ROOT = Path(__file__).resolve().parents[1]
+SPEC = importlib.util.spec_from_file_location("generate_site", ROOT / "scripts" / "generate_site.py")
+assert SPEC and SPEC.loader
+GEN = importlib.util.module_from_spec(SPEC)
+SPEC.loader.exec_module(GEN)
+
+
+def _write_post(directory: Path, name: str, body: str) -> Path:
+    path = directory / name
+    path.write_text(body, encoding="utf-8")
+    return path
+
+
+class MalformedFrontMatterTests(unittest.TestCase):
+    def setUp(self) -> None:
+        self._posts = GEN.POSTS
+        self.tmp = Path(tempfile.mkdtemp(prefix="pch-c-posts-"))
+        GEN.POSTS = self.tmp
+
+    def tearDown(self) -> None:
+        GEN.POSTS = self._posts
+        shutil.rmtree(self.tmp, ignore_errors=True)
+
+    def test_empty_file_missing_front_matter_raises(self) -> None:
+        _write_post(self.tmp, "empty.md", "")
+        with self.assertRaisesRegex(ValueError, "missing front matter"):
+            GEN.load_posts()
+
+    def test_only_opening_fence_raises(self) -> None:
+        _write_post(self.tmp, "half.md", "---\ntitle: Half\n")
+        with self.assertRaisesRegex(ValueError, "missing front matter"):
+            GEN.load_posts()
+
+    def test_duplicate_routes_from_two_posts_still_raise(self) -> None:
+        _write_post(
+            self.tmp,
+            "a.md",
+            "---\ntitle: A\ndate: 2026-01-01\nslug: twin\n---\nA.\n",
+        )
