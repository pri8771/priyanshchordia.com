+        self.assertIn("Available on the App Store", rendered)
+        self.assertIn("Can I download Mala from the App Store?", rendered)
+        self.assertIn("Yes. Mala has a verified App Store listing", rendered)
+        self.assertNotIn("not available on the App Store yet", rendered)
+        self.assertNotIn("data-waitlist", rendered)
+        self.assertNotIn("Ask for a TestFlight invitation.", rendered)
+        self.assertNotIn("TestFlight builds expire", rendered)
+        self.assertIn("Counts stay on device", rendered)
+
+    def test_null_store_id_keeps_honest_waitlist_fallback(self) -> None:
+        products = GEN.load_products()
+        apps = {str(app["slug"]): app for app in GEN.load_apps(products)}
+        landings = GEN.load_landing_pages(products)
+        anjali = next(p for p in products if p["slug"] == "anjali")
+        rendered = GEN.product_page(anjali, landings["anjali"], apps["anjali"])
+        self.assertIsNone(apps["anjali"].get("app_store_id"))
+        self.assertIn("data-waitlist", rendered)
+        self.assertIn("The signup service is not connected yet.", rendered)
+        self.assertNotIn("https://apps.apple.com/app/id", rendered)
+        self.assertIn("not available on the App Store yet", rendered)
+
+    def test_catalogue_copy_reflects_mixed_availability(self) -> None:
+        products = GEN.load_products()
+        posts = GEN.load_posts()
+        home = GEN.home(products, posts)
+        self.assertIn("some available on the App Store", home)
+        self.assertNotIn("independent iOS apps in private beta", home)
+        self.assertIn("AuraFit", home)
+        self.assertIn(GEN.DESCRIPTION, home)
+        self.assertNotIn("Six private, focused iOS apps in beta.", home)
+        self.assertIn("Mala, Anjali, Svara, Roam, Hindsight, and AuraFit", home)
+        self.assertNotIn("Five apps, fifteen directions", home)
+        svara = next(p for p in products if p["slug"] == "svara")
+        apps = {str(app["slug"]): app for app in GEN.load_apps(products)}
+        landings = GEN.load_landing_pages(products)
+        rendered = GEN.product_page(svara, landings["svara"], apps["svara"])
+        self.assertNotIn("Everything free while testing", rendered)
+        self.assertIn("Optional purchases via StoreKit", rendered)
+
+
+if __name__ == "__main__":
+    unittest.main()
