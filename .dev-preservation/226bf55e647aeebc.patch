+"""Fixture isolation / harness utility contracts (C2 Lane 5)."""
+
+from __future__ import annotations
+
+import importlib.util
+import socket
+import tempfile
+import unittest
+from pathlib import Path
+
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+def load(name: str, rel: str):
+    import sys
+
+    spec = importlib.util.spec_from_file_location(name, ROOT / rel)
+    assert spec and spec.loader
+    mod = importlib.util.module_from_spec(spec)
+    # Required so @dataclass can resolve the module namespace under Python 3.14.
+    sys.modules[name] = mod
+    spec.loader.exec_module(mod)
+    return mod
+
+
+class HarnessUtilityTests(unittest.TestCase):
+    def test_find_free_port_binds_loopback_only(self) -> None:
+        cdp = load("cdp_client", "scripts/cdp_client.py")
+        port = cdp.find_free_port()
+        self.assertIsInstance(port, int)
+        self.assertGreater(port, 0)
+        # Port should be bindable on loopback after finder released it.
+        with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as sock:
+            sock.bind(("127.0.0.1", port))
+
+    def test_start_stop_http_server_cleans_up(self) -> None:
+        cdp = load("cdp_client", "scripts/cdp_client.py")
+        site = ROOT / "site"
+        server, port, base = cdp.start_loopback_http(site)
+        try:
+            self.assertTrue(base.startswith("http://127.0.0.1:"))
+            self.assertEqual(server.poll(), None)
+        finally:
+            cdp.stop_process_group(server)
+        self.assertIsNotNone(server.poll())
+
+    def test_code_tree_paths_use_posix_relatives(self) -> None:
+        digest = load("code_tree_digest", "scripts/code_tree_digest.py")
+        info = digest.compute_code_tree_sha256(ROOT)
+        for rel in info["files"]:
+            self.assertNotIn("\\", rel)
+            self.assertFalse(rel.startswith("/"))
+
+
+if __name__ == "__main__":
+    unittest.main()
