+    non_null = [o for o in order if o and o.get("tag")]
+    trap = False
+    if len(non_null) >= 6:
+        sigs = [f"{o.get('tag')}|{o.get('id')}|{o.get('href')}" for o in non_null[1:]]
+        trap = len(set(sigs)) == 1 and bool(sigs)
+    record(
