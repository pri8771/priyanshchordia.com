+                else:
+                    self.assertIn("data-waitlist", product)
+                    # Honest unavailable copy lives in waitlist.js; markup must wire form.
+                    self.assertIn("<form", product.lower())
+
+
+if __name__ == "__main__":
+    unittest.main()
