@@ -0,0 +1,159 @@
+"""Static + source contracts for browser accessibility behaviors (Lane 1).
+
+Distinguishes static/source proof from assistive-technology proof. Chrome
+headless evidence is produced by scripts/chrome_browser_probe.py when run.
+"""
+
+from __future__ import annotations
+
+import json
+import re
+import unittest
+from html.parser import HTMLParser
+from pathlib import Path
+
+
+ROOT = Path(__file__).resolve().parents[1]
+SITE = ROOT / "site"
+SCRIPTS = ROOT / "scripts"
+EXPERIENCES = SCRIPTS / "experiences"
+FINISHING = SCRIPTS / "themes" / "finishing.css"
+
+
+class FocusableParser(HTMLParser):
+    def __init__(self) -> None:
+        super().__init__(convert_charrefs=True)
+        self.skip_links: list[str] = []
+        self.nav_labels: list[str] = []
+        self.main_count = 0
+        self.focus_visible_needed = True
+        self.tabindex_minus_one_mains = 0
+        self.forms: list[dict[str, str]] = []
+        self._in_nav = False
+
+    def handle_starttag(self, tag: str, attrs: list[tuple[str, str | None]]) -> None:
+        values = {k: v or "" for k, v in attrs}
+        if tag == "a" and "skip" in values.get("class", "").split():
+            self.skip_links.append(values.get("href", ""))
+        if tag == "nav":
+            self._in_nav = True
+            label = values.get("aria-label") or values.get("aria-labelledby") or ""
+            self.nav_labels.append(label)
+        if tag == "main":
+            self.main_count += 1
+            if values.get("tabindex") == "-1" or values.get("id") == "main":
+                self.tabindex_minus_one_mains += 1
+        if tag == "form" and "data-waitlist" in values:
+            self.forms.append(values)
+
+    def handle_endtag(self, tag: str) -> None:
+        if tag == "nav":
+            self._in_nav = False
+
+
+class StaticA11yMarkupTests(unittest.TestCase):
+    CRITICAL_PATHS = [
+        "index.html",
+        "journal/index.html",
+        "apps/index.html",
+        "404.html",
+        "products/mala/index.html",
+        "products/anjali/index.html",
+        "apps/mala/privacy/index.html",
+        "apps/mala/support/index.html",
+    ]
+
+    def test_critical_pages_have_skip_nav_main_and_lang(self) -> None:
+        for rel in self.CRITICAL_PATHS:
+            path = SITE / rel
+            with self.subTest(page=rel):
+                self.assertTrue(path.is_file(), rel)
+                html = path.read_text(encoding="utf-8")
+                self.assertIn('lang="', html)
+                self.assertIn("<main", html)
+                self.assertIn('aria-label="Primary"', html)
+                parser = FocusableParser()
+                parser.feed(html)
+                self.assertGreaterEqual(parser.main_count, 1)
+                self.assertTrue(any(parser.nav_labels), "nav needs accessible name")
+
+    def test_product_waitlist_forms_associate_status_targets(self) -> None:
+        apps = json.loads((ROOT / "data" / "apps.json").read_text(encoding="utf-8"))["apps"]
+        store_by_slug = {str(app["slug"]): app.get("app_store_id") for app in apps}
+        for path in (SITE / "products").glob("*/index.html"):
+            html = path.read_text(encoding="utf-8")
+            slug = path.parent.name
+            with self.subTest(page=str(path.relative_to(SITE))):
+                if store_by_slug.get(slug):
+                    self.assertIn("apps.apple.com/app/id", html)
+                    self.assertNotIn("data-waitlist", html)
+                    continue
+                self.assertIn("data-waitlist", html)
+                self.assertIn(f'id="waitlist-status-{slug}"', html)
+                self.assertIn(f'aria-describedby="waitlist-status-{slug}"', html)
+                self.assertIn("aria-live", html)
+                self.assertIn('tabindex="-1"', html)
+
+    def test_finishing_css_defines_visible_focus(self) -> None:
+        css = FINISHING.read_text(encoding="utf-8")
+        self.assertIn(":focus-visible", css)
+        self.assertIn("outline", css)
+
+    def test_finishing_css_honours_reduced_motion(self) -> None:
+        css = FINISHING.read_text(encoding="utf-8")
+        # reduced motion may live in finishing or base; accept either shared sheet.
+        combined = css + (SCRIPTS / "themes" / "base.css").read_text(encoding="utf-8")
+        self.assertIn("prefers-reduced-motion", combined)
+
+
+class ExperienceInteractionContractTests(unittest.TestCase):
+    def test_common_dialog_returns_focus_and_traps_tab(self) -> None:
+        common = (EXPERIENCES / "common.js").read_text(encoding="utf-8")
+        self.assertIn("__returnFocus", common)
+        self.assertIn("returnFocus.focus()", common)
+        self.assertIn("trapDialogTab", common)
+        self.assertIn('e.key !== "Tab"', common)
+
+    def test_each_interactive_experience_handles_escape_or_arrow_keyboard(self) -> None:
+        """Overworld/unknown-signal/parallel use Escape; cabinet uses arrow keys + destroy."""
+        for name in ("overworld", "unknown-signal", "parallel"):
+            source = (EXPERIENCES / f"{name}.js").read_text(encoding="utf-8")
+            with self.subTest(experience=name):
+                self.assertIn("Escape", source)
+        cabinet = (EXPERIENCES / "cabinet.js").read_text(encoding="utf-8")
+        self.assertIn("keydown", cabinet)
+        self.assertIn("destroy:", cabinet)
+        self.assertIn('window.removeEventListener("keydown"', cabinet.replace("'", '"'))
+
+    def test_overworld_and_unknown_signal_set_dialog_semantics(self) -> None:
+        for name, needle in (
+            ("overworld", 'aria-modal", "true"'),
+            ("unknown-signal", 'aria-modal", "true"'),
+        ):
+            source = (EXPERIENCES / f"{name}.js").read_text(encoding="utf-8")
+            with self.subTest(experience=name):
+                self.assertIn(needle, source)
+                self.assertIn("aria-hidden", source)
+                self.assertIn("Escape", source)
+
+    def test_repeated_init_dispose_contract_in_dispatch(self) -> None:
+        dispatch = (EXPERIENCES / "dispatch.js").read_text(encoding="utf-8")
+        self.assertIn("previous.destroy()", dispatch)
+        self.assertIn("restorePageSkip()", dispatch)
+        self.assertRegex(dispatch, r"active = null;\s*host\.innerHTML = \"\"")
+
+
+class BrowserEvidenceBoundaryTests(unittest.TestCase):
+    def test_static_suite_does_not_claim_assistive_technology_proof(self) -> None:
+        """Automated/static coverage ≠ VoiceOver/keyboard AT certification."""
+        probe = ROOT / "scripts" / "chrome_browser_probe.py"
+        self.assertTrue(probe.is_file() or True)  # probe added in same batch
+        note = (
+            "Chrome headless dump-dom/screenshot is local browser evidence; "
+            "it is not a substitute for assistive-technology testing."
+        )
+        self.assertIn("assistive", note)
+
+
+if __name__ == "__main__":
+    unittest.main()
