+#!/usr/bin/env python3
+"""Cross-route Chrome/CDP browser interaction matrix (C4 Lane 1).
+
+Exercises keyboard, pointer, focus recovery, history, reload, fragments,
+storage edge cases, emulated media, waitlist submissions, and brief offline
+handling across all interactive HTML routes. Loopback HTTP only.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import sys
+import traceback
+import urllib.request
+from datetime import datetime, timezone
+from pathlib import Path
+from typing import Any
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT / "scripts"))
+
+from cdp_client import (  # noqa: E402
+    chrome_discovery_report,
+    start_chrome_session,
+    start_loopback_http,
+    stop_process_group,
+)
+
+SITE = ROOT / "site"
+DEFAULT_EVIDENCE = ROOT / "session-c4-evidence" / "browser-matrix"
+
+# Interactive HTML routes (pages a user navigates). Assets excluded.
+INTERACTIVE_ROUTES = [
+    "/",
+    "/journal/",
+    "/apps/",
+    "/products/mala/",
+    "/products/anjali/",
+    "/products/svara/",
+    "/products/roam/",
+    "/products/hindsight/",
+    "/products/aurafit/",
+    "/apps/mala/privacy/",
+    "/apps/mala/support/",
+    "/apps/anjali/privacy/",
+    "/apps/anjali/support/",
+    "/apps/svara/privacy/",
+    "/apps/svara/support/",
+    "/apps/roam/privacy/",
+    "/apps/roam/support/",
+    "/apps/hindsight/privacy/",
+    "/apps/hindsight/support/",
+    "/apps/aurafit/privacy/",
+    "/apps/aurafit/support/",
+    "/404.html",
+]
+
+BOUNDARY = (
+    "Chrome CDP cross-route browser matrix. "
+    "Not VoiceOver/AT certification. Not production deploy proof. "
+    "No live external form submission claims."
+)
+
+FOCUS_PROBE = r"""
+(() => {
+  const ae = document.activeElement;
+  if (!ae || ae === document.body || ae === document.documentElement) {
+    return {tag: null, id: null, cls: null, href: null, role: null, text: null};
+  }
+  return {
+    tag: ae.tagName ? ae.tagName.toLowerCase() : null,
+    id: ae.id || null,
+    cls: (typeof ae.className === 'string' ? ae.className : '') || null,
+    href: ae.getAttribute && ae.getAttribute('href'),
+    role: ae.getAttribute && ae.getAttribute('role'),
+    text: (ae.textContent || '').trim().slice(0, 80),
+  };
+})()
+"""
+
+
+def discover_site_html_routes(site: Path) -> list[str]:
+    """Map every site/**/*.html file to its URL path."""
+    routes: list[str] = []
+    for html in sorted(site.rglob("*.html")):
+        rel = html.relative_to(site).as_posix()
+        if rel == "index.html":
+            routes.append("/")
+        elif rel == "404.html":
+            routes.append("/404.html")
+        elif rel.endswith("/index.html"):
+            routes.append("/" + rel[: -len("index.html")])
+        else:
+            routes.append("/" + rel)
+    return routes
+
+
+def route_slug(path: str) -> str:
+    return path.strip("/").replace("/", "_") or "home"
+
+
+def record(cases: list[dict[str, Any]], name: str, ok: bool, detail: Any = None) -> None:
+    cases.append({"name": name, "ok": bool(ok), "detail": detail or {}})
+
+
+def reset_focus_to_start(session) -> None:
+    session.evaluate(
+        "(() => { const b=document.body; if(b){ b.tabIndex=-1; b.focus(); b.removeAttribute('tabindex'); }})()"
+    )
+
+
+def browser_identity(cdp_port: int) -> dict[str, Any]:
+    report = chrome_discovery_report()
+    identity: dict[str, Any] = {
+        "resolved": report.get("resolved"),
+        "mode": report.get("mode"),
+    }
+    try:
+        with urllib.request.urlopen(f"http://127.0.0.1:{cdp_port}/json/version", timeout=2) as resp:
+            version = json.load(resp)
+        identity["browser"] = version.get("Browser")
+        identity["protocol_version"] = version.get("Protocol-Version")
+        identity["user_agent"] = version.get("User-Agent")
+    except Exception as exc:  # noqa: BLE001
+        identity["version_error"] = str(exc)
+    return identity
+
+
+def audit_route_core(session, base: str, path: str, cases: list[dict[str, Any]]) -> None:
+    """Core nav/focus cases run on every interactive route."""
+    url = base + path
+    slug = route_slug(path)
+    session.set_viewport(1280, 800, mobile=False)
+    session.navigate(url)
+
+    load = session.evaluate(
+        """(() => {
+          try {
+            const main = document.querySelector('main');
+            return {ok: !!main, title: document.title, ready: document.readyState};
+          } catch (e) { return {ok:false, error:String(e)}; }
+        })()"""
+    )
+    record(cases, f"{slug}.load_no_crash", bool(load and load.get("ok")), load)
+
+    reset_focus_to_start(session)
+    session.tab()
+    focus = session.evaluate(FOCUS_PROBE)
+    skip_ok = bool(focus and focus.get("cls") and "skip" in (focus.get("cls") or ""))
+    record(cases, f"{slug}.skip_first_tab", skip_ok, {"focus": focus})
+
+    skip_href = session.evaluate(
+        "(() => { const s=document.querySelector('a.skip'); return s ? s.getAttribute('href') : null; })()"
+    )
+    session.key("Enter", code="Enter", text="\r")
+    after = session.evaluate(FOCUS_PROBE)
+    hash_now = session.evaluate("location.hash")
+    target_id = (skip_href or "#main").lstrip("#") or "main"
